import * as check from "./check";

class Contact {
  name: string;
  nick?: string;
  active: boolean;
}

function displayName(contact: Contact): string {
  let nick: string | undefined = contact.nick;
  if (nick !== undefined) {
    return nick;
  }
  return contact.name;
}

function activeNames(contacts: Contact[]): string[] {
  let names: string[] = [];
  for (let contact of contacts) {
    if (contact.active) {
      let length: number = names.push(displayName(contact));
      check.require(length === names.length, "push returns the new length");
    }
  }
  return names;
}

export function exercise(): null {
  let ada: Contact = { name: "Ada", nick: "countess", active: true };
  let grace: Contact = { name: "Grace", active: true };
  let inactive: Contact = { name: "Inactive", active: false };
  let contacts: Contact[] = [ada, grace, inactive];
  let names: string[] = activeNames(contacts);
  check.require(names.length === 2, "active contact count");
  check.require(names[0] === "countess" && names[1] === "Grace", "display names");
  check.require(contacts.includes(grace) && contacts.indexOf(grace, -2) === 1, "find a saved contact by identity");
  check.require(names.includes("Grace") && names.indexOf("missing") === -1, "find display names by value");
  let last: Contact[] = contacts.slice(-2, contacts.length);
  check.require(last !== contacts && last[0] === grace, "slice keeps contact identity");
  let copiedNames: string[] = names.slice(0, names.length);
  copiedNames[0] = "Ada";
  check.require(names[0] === "countess", "slice owns separate array storage");
  return null;
}
