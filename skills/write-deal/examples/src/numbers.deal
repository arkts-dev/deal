import * as check from "./check";
import * as math from "std/math";
import * as strings from "std/string";

function fraction(done: int, total: int): number {
  if (total === 0) {
    throw { code: "ZERO_TOTAL", message: "total must be nonzero" };
  }
  return number(done) / number(total);
}

function denominatorRejected(): boolean {
  try {
    fraction(1, 0);
  } catch (e) {
    return e.code === "ZERO_TOTAL";
  }
  return false;
}

function decimal(value: int): string {
  if (value < 0) {
    throw { code: "NEGATIVE_VALUE", message: "expected nonnegative integer" };
  }
  if (value === 0) {
    return "0";
  }
  let digits: string = "0123456789";
  let result: string = "";
  let remaining: int = value;
  while (remaining > 0) {
    let digit: int = remaining % 10;
    result = strings.substring(digits, digit, digit + 1) + result;
    remaining = remaining / 10;
  }
  return result;
}

export function exercise(): null {
  check.require(5 / 2 === 2, "integer division");
  check.require(fraction(1, 4) === 0.25, "explicit numeric conversion");
  check.require(int(math.floor(3.9)) === 3, "deliberate rounding");
  check.require(denominatorRejected(), "zero denominator");
  check.require(decimal(0) === "0" && decimal(2048) === "2048", "explicit integer formatting");
  return null;
}
