import * as check from "./check";

function sum(values: int[]): int {
  let total: int = 0;
  for (let value: int of values) {
    total = total + value;
  }
  return total;
}

function boundsWriteRejected(values: int[]): boolean {
  try {
    values[values.length + 1] = 1;
  } catch (e) {
    return e.code === "E8002";
  }
  return false;
}

function copyValues(source: int[]): int[] {
  let copy: int[] = [];
  for (let value: int of source) {
    copy[copy.length] = value;
  }
  return copy;
}

export function exercise(): null {
  let values: int[] = [2, 3];
  values[values.length] = 5;
  check.require(sum(values) === 10, "array append and sum");
  let alias: int[] = values;
  alias[0] = 255;
  check.require(values[0] === 255, "array alias mutation");
  check.require(boundsWriteRejected(values), "array bounds rejection");
  check.require(values[0] === 255 && values[1] === 3 && values.length === 3,
    "failed array write mutated storage");
  let copy: int[] = copyValues(values);
  copy[0] = 7;
  check.require(values[0] === 255 && copy[0] === 7, "independent array copy");
  return null;
}
