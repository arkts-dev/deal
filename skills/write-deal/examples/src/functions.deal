import * as check from "./check";

function makeCounter(start: number): () => number {
  let current: number = start;
  return function(): number {
    current = current + 1;
    return current;
  };
}

function applyTwice(value: number, transform: (value: number) => number): number {
  return transform(transform(value));
}

export function exercise(): null {
  let next: () => number = makeCounter(10);
  check.require(next() === 11, "first closure call");
  check.require(next() === 12, "captured binding persists");
  let double: (value: number) => number = function(value: number): number {
    return value * 2;
  };
  check.require(applyTwice(3, double) === 12, "typed callback");
  return null;
}
