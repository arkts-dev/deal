import * as check from "./check";

function readCount(data: Record<string, unknown>): number {
  let count: number = data.count as number;
  if (count < 0) {
    throw { code: "NEGATIVE_COUNT", message: "count must be nonnegative" };
  }
  return count;
}

function wrongTypeRejected(): boolean {
  let data: Record<string, unknown> = { count: "three" };
  try {
    readCount(data);
  } catch (e) {
    return (e as Error).code === "E8001";
  }
  return false;
}

export function exercise(): null {
  check.require(wrongTypeRejected(), "table read validates type");
  let data: Record<string, unknown> = JSON.parse("{\"name\":\"Ada\",\"count\":3}");
  let name: string = data.name as string;
  check.require(name === "Ada", "typed JSON field");
  check.require(readCount(data) === 3, "typed count read");
  data.enabled = true;
  let encoded: string = JSON.stringify(data) as string;
  let restored: Record<string, unknown> = JSON.parse(encoded);
  let enabled: boolean = restored.enabled as boolean;
  check.require(enabled, "table JSON roundtrip");
  let counts: number[] = [1, 2, 3];
  let labels: string[] = counts.map((value: number, index: number): string => `${index}: ${value}`);
  check.require(labels.join("; ") === "0: 1; 1: 2; 2: 3", "map typed values in source order");
  let selected: number | undefined = counts.find((value: number): boolean => value > 1);
  check.require((selected ?? 0) === 2, "find the first matching value");
  let absent: number | undefined = counts.find((value: number): boolean => value > 10);
  check.require((absent ?? 0) === 0, "default only a nullish result");
  check.require(counts.findIndex((value: number): boolean => value > 2) === 2, "find the first matching index");
  let larger: number[] = counts.filter((value: number): boolean => value > 1);
  check.require(larger.length === 2 && larger[0] === 2, "filter selected values into fresh storage");
  check.require(counts.some((value: number): boolean => value > 2), "some value matches");
  check.require(counts.every((value: number): boolean => value > 0), "every value matches");
  data.note = null;
  delete data.note;
  return null;
}
