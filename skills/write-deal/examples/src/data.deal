import * as check from "./check";
import * as json from "std/json";

function readCount(data: Record<string, unknown>): number {
  let count: number = data.count as number;
  if (count < 0) {
    throw { code: "NEGATIVE_COUNT", message: "count must be nonnegative" };
  }
  return count;
}

function wrongTypeRejected(): boolean {
  let data: Record<string, unknown> = { count: "three" };
  try {
    readCount(data);
  } catch (e) {
    return (e as Error).code === "E8001";
  }
  return false;
}

export function exercise(): null {
  check.require(wrongTypeRejected(), "table read validates type");
  let data: Record<string, unknown> = json.parse("{\"name\":\"Ada\",\"count\":3}");
  let name: string = data.name as string;
  check.require(name === "Ada", "typed JSON field");
  check.require(readCount(data) === 3, "typed count read");
  data.enabled = true;
  let encoded: string = json.stringify(data) as string;
  let restored: Record<string, unknown> = json.parse(encoded);
  let enabled: boolean = restored.enabled as boolean;
  check.require(enabled, "table JSON roundtrip");
  data.note = null;
  delete data.note;
  return null;
}
