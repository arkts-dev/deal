*.class
build/
# Release distribution build outputs (release-distribution-build-and-verify
# P7): dist/ and the release archive are build outputs, never committed.
# release/evidence/ (the E8 retention directory) stays commit-visible.
dist/
release/deal-*.tar
# Publication-stager OS lock files (PublicationStager.ensureStaging):
# transient local artifacts created next to any publication root, never
# committed (they persist until the next staging run reuses them).
*.deal-publish.lock
