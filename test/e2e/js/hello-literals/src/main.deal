import * as c from "std/console";

class Point {
  x: int = 0;
  y: int = 0;
}

export function main(): null {
  let i: int = 42;
  let neg: int = -7;
  let f: number = 3.5;
  let t: boolean = true;
  let fl: boolean = false;
  let n: int | null = null;
  let s: string = "plain";
  let xs: int[] = [1, 2, 3];
  let p: Point = { x: 1, y: 2 };
  let g: () => int = function(): int { return 7; };
  let tableLit: table = { k: "v" };
  if (i !== 42) { throw { code: "TEST_FAIL", message: "int literal" }; }
  if (neg !== -7) { throw { code: "TEST_FAIL", message: "negative int literal" }; }
  if (f !== 3.5) { throw { code: "TEST_FAIL", message: "number literal" }; }
  if (t !== true) { throw { code: "TEST_FAIL", message: "true literal" }; }
  if (fl !== false) { throw { code: "TEST_FAIL", message: "false literal" }; }
  if (n !== null) { throw { code: "TEST_FAIL", message: "null literal" }; }
  if (s !== "plain") { throw { code: "TEST_FAIL", message: "string literal" }; }
  if (xs.length !== 3) { throw { code: "TEST_FAIL", message: "array literal" }; }
  if (p.x !== 1 || p.y !== 2) { throw { code: "TEST_FAIL", message: "class literal" }; }
  if (g() !== 7) { throw { code: "TEST_FAIL", message: "function literal" }; }
  let tv: string = tableLit.k;
  if (tv !== "v") { throw { code: "TEST_FAIL", message: "table literal" }; }
  c.log("hello literals: int number boolean null string array class function table");
  return null;
}
