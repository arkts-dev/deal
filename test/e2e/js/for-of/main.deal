import * as c from "std/console";

export function main(): null {
  let xs: int[] = [1, 2, 3, 4, 5];
  delete xs[2];
  let total: int = 0;
  let count: int = 0;
  for (let x: int of xs) {
    total = total + x;
    count = count + 1;
  }
  if (count !== 2) { throw { code: "TEST_FAIL", message: "for-of stops at the deleted element" }; }
  if (total !== 3) { throw { code: "TEST_FAIL", message: "for-of pre-delete sum" }; }

  let vals: int[] = [10, 20, 30];
  let fs: (() => int)[] = [
    function(): int { return -1; },
    function(): int { return -1; },
    function(): int { return -1; },
  ];
  let k: int = 0;
  for (let v: int of vals) {
    fs[k] = function(): int { return v; };
    k = k + 1;
  }
  if (fs[0]() !== 10) { throw { code: "TEST_FAIL", message: "fresh binding 0" }; }
  if (fs[1]() !== 20) { throw { code: "TEST_FAIL", message: "fresh binding 1" }; }
  if (fs[2]() !== 30) { throw { code: "TEST_FAIL", message: "fresh binding 2" }; }

  let chars: string = "";
  for (let ch: string of "héllo") {
    chars = chars + ch;
  }
  if (chars !== "héllo") { throw { code: "TEST_FAIL", message: "string scalar for-of" }; }

  c.log("for-of ok");
  return null;
}
