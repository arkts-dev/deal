import * as c from "std/console";

export function main(): null {
  let x: int = 5;
  let path: string = "";
  if (x > 10) {
    path = "gt";
  } else if (x === 5) {
    path = "eq";
  } else {
    path = "lt";
  }
  if (path !== "eq") { throw { code: "TEST_FAIL", message: "if/else-if/else path" }; }

  let total: int = 0;
  let i: int = 0;
  while (i < 5) {
    total = total + i;
    i = i + 1;
  }
  if (total !== 10) { throw { code: "TEST_FAIL", message: "while sum" }; }

  let acc: int = 0;
  for (let j: int = 0; j < 10; j = j + 1) {
    if (j === 3) { continue; }
    if (j === 7) { break; }
    acc = acc + j;
  }
  if (acc !== 18) { throw { code: "TEST_FAIL", message: "for break/continue sum" }; }

  let sawBreak: boolean = false;
  let k: int = 0;
  while (true) {
    k = k + 1;
    if (k >= 3) { sawBreak = true; break; }
  }
  if (sawBreak !== true) { throw { code: "TEST_FAIL", message: "while break" }; }

  c.log("control flow ok");
  return null;
}
