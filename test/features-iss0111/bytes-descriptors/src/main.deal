// ISSUE-0165 BYTES_DESCRIPTORS row (int32/bytes page D7): a bytes-typed
// class field crosses the canonical descriptor boundary end to end;
// distinct instances own distinct buffers (reference identity, never
// shared storage).
class Payload {
  data: bytes = bytes(2);
}

function describe(p: Payload): int {
  return p.data.length;
}

export function main(): null {
  let p: Payload = { data: bytes(3) };
  if (describe(p) !== 3) {
    throw { code: "TEST_FAIL", message: "descriptors: bytes field length mismatch" };
  }
  p.data[1] = 200;
  let q: Payload = { data: bytes(1) };
  if (q.data.length !== 1) {
    throw { code: "TEST_FAIL", message: "descriptors: second instance length mismatch" };
  }
  if (p.data[1] !== 200) {
    throw { code: "TEST_FAIL", message: "descriptors: instances share bytes storage" };
  }
  return null;
}
