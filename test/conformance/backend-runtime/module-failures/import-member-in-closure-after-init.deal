// @spec: Modules, declarations, standard library, and host ABI — Import use inside closures
// @description: Imported module member called from closure executes correctly after module initialization
// @expected: runtime-ok
// @features: modules, closures, initialization

import * as Lib from "./value_lib";

export function test_import_member_in_closure_after_init(): number {
  let f: () => number = function(): number { return Lib.make(); };
  let result: number = f();
  if (result !== 3) { throw { code: "TEST_FAIL", message: "import member in closure failed" }; }
  return result;
}

export function main(): null {
  return null;
}
