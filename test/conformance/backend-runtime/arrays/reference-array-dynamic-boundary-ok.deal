// @spec: Runtime execution model — Runtime type descriptor format
// @description: Canonical number[] rows at dynamic boundaries (ISSUE-0550): a table-held number[] value crossing the `number[]` row passes with reference identity, the `?number[]` row passes the DEAL null and a real buffer, and a (number[])->number[] wrapper crossing the function row passes with its byte-equal carried descriptor.
// @expected: runtime-ok
// @features: descriptors, number[], functions, dynamic-boundaries

export function test_array_dynamic_boundary_ok(): string {
  // Accepted number[]: the shared number[] carrier crosses the `number[]` row
  // unchanged; reads observe the stored buffer's contents.
  let holder: table = { b: [0, 0] };
  let b: number[] = holder.b;
  if (b.length !== 2 || b[0] !== 0) {
    throw { code: "TEST_FAIL", message: "accepted number[] boundary mismatch" };
  }
  // Nullable pass-through: the `?number[]` row passes the DEAL null and a
  // real buffer with the same reference identity.
  let holderNull: table = { n: null };
  let nb: number[] | null = holderNull.n;
  if (nb !== null) {
    throw { code: "TEST_FAIL", message: "nullable null pass-through mismatch" };
  }
  let nb2: number[] | null = holder.b;
  if (nb2 !== null) {
    if (nb2.length !== 2) {
      throw { code: "TEST_FAIL", message: "nullable number[] pass-through mismatch" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "nullable number[] value lost" };
  }
  // Accepted function wrapper: a (number[])->number[] value crosses the
  // function row and stays callable with the same buffer reference.
  let id: (x: number[]) => number[] = function(x: number[]): number[] { return x; };
  let holderFn: table = { f: id };
  let f: (x: number[]) => number[] = holderFn.f;
  if (f(b) !== b) {
    throw { code: "TEST_FAIL", message: "function row identity mismatch" };
  }
  return "dynamic number[] boundary ok";
}

export function main(): null {
  return null;
}
