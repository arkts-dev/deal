// @spec: Arrays — Byte indexing and buffer semantics
// @description: Write validation runs only after every operand completed: a side-effecting RHS produces an value for an out-of-bounds write whose E8002 fires after the receiver, index, and RHS side effects were all observed, and a failed write changes no storage (v1.2)
// @expected: runtime-ok
// @features: number[], runtime, v1.2

class Log {
  seq: number[];
  buf: number[];
}

function record(l: Log, tag: number): number {
  l.seq[l.seq.length] = tag;
  return tag;
}

function pick(l: Log, tag: number): number[] {
  record(l, tag);
  return l.buf;
}

function badValue(l: Log): number {
  record(l, 3);
  return 300;
}

export function test_array_write_validation_after_rhs(): null {
  let l: Log = { seq: [], buf: [0, 0, 0, 0] };
  try {
    pick(l, 1)[record(l, 5)] = badValue(l);
    throw { code: "TEST_FAIL", message: "expected E8002 before completing" };
  } catch (value) {
    let e: Error = value as Error;
    if (e.code !== "E8002") {
      throw { code: "TEST_FAIL", message: "expected E8002, got " + e.code };
    }
    if (l.seq.length !== 3 || l.seq[0] !== 1 || l.seq[1] !== 5 || l.seq[2] !== 3) {
      throw { code: "TEST_FAIL", message: "write validation must run after all operand side effects" };
    }
  }
  if (l.buf[1] !== 0) {
    throw { code: "TEST_FAIL", message: "failed write must not change storage" };
  }
  return null;
}

export function main(): null {
  return null;
}
