// @spec: Arrays — Indexing
// @description: Array index read works
// @expected: runtime-ok
// @features: arrays, indexing

export function test_array_index(): int {
  let xs: int[] = [10, 20, 30];
  if (xs.length !== 3) {
    throw { code: "TEST_FAIL", message: "array index read length mismatch" };
  }
  let value: int = xs[1]; // should be 20
  if (value !== 20) {
    throw { code: "TEST_FAIL", message: "array index read value mismatch" };
  }
  return value;
}

export function main(): null {
  return null;
}
