// @spec: Arrays
// @description: Find methods preserve ordinary callback boundaries, early exit, strict reached reads and same-storage repair
// @expected: runtime-ok
// @features: arrays, host-abi
import * as host from "host/probe";
class Item {x:number;stable:number;}
function check(ok:boolean):void {if(!ok){throw {code:"FIND",message:"live mismatch"};}}
export function main():null {
  let xs:number[]=[4,5,9];let alias=xs;let destination:number|undefined=123;let indexDestination=123;let calls=0;let caught=false;
  host.keep(xs);host.corrupt();
  try {destination=xs.find((value:number):boolean=>{calls=calls+1;return true;});}
  catch(e){check((e as Error).code==="E8003" && (e as Error).message==="array element 3 type mismatch");caught=true;}
  check(caught && calls===0 && (destination as number)===123 && host.size()===3 && alias[1]===5);
  caught=false;
  try {indexDestination=xs.findIndex((value:number):boolean=>{calls=calls+1;return true;});}
  catch(e){check((e as Error).code==="E8003" && (e as Error).message==="array element 3 type mismatch");caught=true;}
  check(caught && calls===0 && indexDestination===123);host.repair();
  check((xs.find((value:number):boolean=>value===9) as number)===9 && xs.findIndex((value:number):boolean=>value===9)===2 && xs===alias);
  calls=0;caught=false;
  try {destination=xs.find((value:number,index:number):boolean=>{calls=calls+1;if(index===0){host.corrupt();}return false;});}
  catch(e){check((e as Error).code==="E8003" && (e as Error).message==="array element 3 type mismatch");caught=true;}
  check(caught && calls===1 && (destination as number)===123 && host.size()===3);host.repair();
  calls=0;caught=false;
  try {indexDestination=xs.findIndex((value:number,index:number):boolean=>{calls=calls+1;if(index===1){host.corrupt();}return false;});}
  catch(e){check((e as Error).code==="E8003" && (e as Error).message==="array element 3 type mismatch");caught=true;}
  check(caught && calls===2 && indexDestination===123);host.repair();
  calls=0;
  check((xs.find((value:number):boolean=>{calls=calls+1;host.corrupt();return true;}) as number)===4 && calls===1);host.repair();
  calls=0;
  check(xs.findIndex((value:number):boolean=>{calls=calls+1;host.corrupt();return true;})===0 && calls===1);host.repair();
  let live=host.make();let predicate=():(value:number)=>boolean=>{host.grow();return (value:number):boolean=>value===11;};
  check((live.find(predicate()) as number)===11);
  let item:Item={x:9,stable:4};let items:Item[]=[item];host.damage(item,false);caught=false;
  let itemDestination:Item|undefined=undefined;
  try {itemDestination=items.find((value:Item):boolean=>true);}catch(e){check((e as Error).code==="E8003" && (e as Error).message==="array element 1 type mismatch");caught=true;}
  check(caught && itemDestination===undefined && items.length===1);host.damage(null,true);
  check((items.find((value:Item):boolean=>true) as Item)===item && item.stable===4);
  let callback=():number=>7;let functions:(()=>number)[]=[callback];host.keep(functions);
  for(let signature of [false,true]) {
    if(signature){host.poisonSignature(callback);}else{host.poison(callback);}
    caught=false;let functionDestination:(()=>number)|undefined=undefined;
    try {functionDestination=functions.find((value:()=>number):boolean=>true);}
    catch(e){check((e as Error).code==="E8003" && (e as Error).message==="array element 1 type mismatch");caught=true;}
    check(caught && functionDestination===undefined && functions.length===1);host.restoreFunction();
    check((functions.find((value:()=>number):boolean=>true) as ()=>number)===callback && callback()===7);
  }
  let decoded:number[]=JSON.parse("[4,5,9]");host.keep(decoded);host.corrupt();caught=false;
  try {destination=decoded.find((value:number):boolean=>true);}catch(e){check((e as Error).code==="E8003");caught=true;}
  check(caught && (destination as number)===123 && decoded.length===3);host.repair();check(decoded.findIndex((value:number):boolean=>value===9)===2);
  return null;
}
