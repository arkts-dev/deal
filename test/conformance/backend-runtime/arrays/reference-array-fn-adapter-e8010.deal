// @spec: Functions — arity extension at a check position
// @description: an arity-extended number[]-bearing function value at a call-argument boundary raises E8010 with the pinned function signature mismatch contract (v1.2)
// @expected: runtime-error E8010
// @features: number[], functions, arity, runtime-errors

import * as host from "host/signature_mutation";
function id(b: number[]): number[] { return b; }

function apply2(cb: (b: number[], v: number) => number[], b: number[]): number[] {
  return cb(b, 5);
}

export function test_array_fn_adapter_e8010(): number {
  let source: (b: number[], v: number) => number[] = function(b: number[], v: number): number[] { return b; };
  if (!host.replaceSignature({value: source}, "([number])->[number]")) { throw {code: "TEST_FAIL", message: "signature mutation failed"}; }
  let cb: (b: number[], v: number) => number[] = source;
  return apply2(cb, [0])[0];
}

export function main(): null {
  return null;
}
