// @spec: Functions — arity extension at a check position
// @description: an arity-extended int[]-bearing function value at a call-argument boundary raises E8010 with the pinned function signature mismatch contract (v1.2)
// @expected: runtime-error E8010
// @features: int[], functions, arity, runtime-errors

function id(b: int[]): int[] { return b; }

function apply2(cb: (b: int[], v: int) => int[], b: int[]): int[] {
  return cb(b, 5);
}

export function test_array_fn_adapter_e8010(): int {
  return apply2(id, [0])[0];
}

export function main(): null {
  return null;
}
