// @spec: Arrays
// @description: Deletion-only splice normalizes arguments and validates all removals before shifting live storage
// @expected: runtime-ok
// @features: arrays, host-abi
import * as host from "host/probe";
class Item {x:number; stable:number;}
function check(ok:boolean):void {if(!ok){throw {code:"SPLICE",message:"mismatch"};}}
function normalization(start:number,count:number,want:string,left:string):void {
  let xs:number[]=[1,2,3,4]; let alias=xs;
  let result=xs.splice(start,count);
  check(result!==xs && result!==alias);
  check((JSON.stringify(result) as string)===want && (JSON.stringify(alias) as string)===left);
  result[result.length]=7; check(result[result.length-1]===7);
}
export function main():null {
  normalization(1,2,"[2,3]","[1,4]");
  normalization(-2,1,"[3]","[1,2,4]");
  normalization(-100,2,"[1,2]","[3,4]");
  normalization(100,2,"[]","[1,2,3,4]");
  normalization(1.9,1.9,"[2]","[1,3,4]");
  normalization(-1.9,1,"[4]","[1,2,3]");
  normalization(0/0,0/0,"[]","[1,2,3,4]");
  normalization(-0,1,"[1]","[2,3,4]");
  normalization(1,-1,"[]","[1,2,3,4]");
  normalization(1,1/0,"[2,3,4]","[1]");
  normalization(-1/0,2,"[1,2]","[3,4]");
  normalization(1/0,1/0,"[]","[1,2,3,4]");
  normalization(0,-1/0,"[]","[1,2,3,4]");
  let empty:number[]=[]; check(empty.splice(0,3).length===0);
  let xs:number[]=[4,5,9]; let alias=xs;
  let matrix:number[][]=[[1],xs];let dynamic:unknown[]=[xs];let original:unknown=xs;
  host.keep(xs); host.corrupt(); let caught=false;
  try{matrix.splice(0,2);}catch(e){
    check((e as Error).code==="E8003" && (e as Error).message==="array element 2 type mismatch");caught=true;
  }
  check(caught && matrix.length===2 && matrix[0][0]===1 && host.size()===3);
  check(dynamic.splice(0,1)[0]===original);caught=false;
  try{xs.splice(0,3);}catch(e){
    check((e as Error).code==="E8003" && (e as Error).message==="array element 3 type mismatch");caught=true;
  }
  check(caught && host.size()===3 && alias.length===3 && xs[0]===4 && xs[1]===5);
  // Unremoved hostile data is shifted without being consumed or re-admitted.
  let first=xs.splice(0,1); check(first[0]===4 && host.size()===2 && xs[0]===5);
  host.repair(); let tail=alias.splice(1,1); check(tail[0]===9 && xs.length===1);
  xs[xs.length]=7; check((JSON.stringify(xs) as string)==="[5,7]");
  let live=host.make(); let liveAlias=live;
  let removed=live.splice(0,1); check(removed[0]===4 && live[0]===9 && host.size()===1);
  host.grow(); check(liveAlias.length===2 && live[1]===11);
  live[live.length]=13; check(host.size()===3 && liveAlias.splice(1,2)[1]===13 && host.size()===1);
  let item:Item={x:9,stable:4}; let items:Item[]=[item,item];
  host.damage(item,false);caught=false;
  try{items.splice(0,2);}catch(e){check((e as Error).code==="E8003");caught=true;}
  check(caught && items.length===2);host.damage(null,true);
  let objects=items.splice(0,2);check(objects[0]===item && objects[1]===item && items.length===0);
  let nested:number[][]=[[1],[2]];let inside=nested[1];check(nested.splice(1,1)[0]===inside && nested.length===1);
  let nullish:(null|undefined)[]=[null,undefined,null];let values=nullish.splice(0,2);
  check(values.length===2 && values[0]===null && values[1]===undefined && nullish[0]===null);
  let flags:boolean[]=[true,false,true];check(flags.splice(1,1)[0]===false && flags[1]);
  let text:string[]=["a","\uD800","z"];check(text.splice(1,1)[0]==="\uD800" && text[1]==="z");
  let specials:number[]=[1,-0,0/0,1/0];let numbers=specials.splice(1,2);
  check(1/numbers[0]===-1/0 && numbers[1]!==numbers[1] && specials[1]===1/0);
  let order="";let target:number[]=[1,2,3];
  let receiver=():number[]=>{order=order+"r";return target;};
  let start=():number=>{order=order+"s";return 1;};let count=():number=>{order=order+"c";return 1;};
  check(receiver().splice(start(),count())[0]===2 && order==="rsc");
  let fail=():number=>{order=order+"!";throw {code:"STOP",message:"stop"};};order="";
  try{receiver().splice(fail(),count());}catch(e){check((e as Error).code==="STOP");}
  check(order==="r!" && target.length===2);
  let stale:number[]|null=[1];let clear=():void=>{stale=null;};caught=false;
  if(stale!==null){clear();try{stale.splice(0,1);}catch(e){check((e as Error).code==="E8001");caught=true;}}
  check(caught);
  return null;
}
