// @spec: Arrays
// @description: Provided number[] fields retain nested array freshness, sync/async callable behavior, host-returned alias identity and left-to-right effects; failed producers and boundaries publish no partial instance, and a later attempt still roundtrips through JSON.
// @expected: runtime-ok
// @features: number[], classes, arrays, functions, async-await, host-abi, json

import * as host from "host/array_roundtrip";
import * as json from "std/json";

function identity(b: number[]): number[] { return b; }

async function echoAsync(b: number[]): number[] { return b; }

function badBytes(): number[] {
  let holder: table = { b: "not-number[]" };
  return holder.b;
}

class PlanBox {
  buf: number[];
  nested: number[][];
  deep: number[][][];
  made: number[];
  shared: number[];
  syncFn: (b: number[]) => number[];
  asyncFn: async (b: number[]) => number[];
}

class BadBox {
  payload: number[];
}

function makeBox(): PlanBox {
  return {buf: [0, 0], nested: [[0]], deep: [[[0]]], made: host.makeArray(2),
    shared: host.sharedArray(), syncFn: identity, asyncFn: echoAsync};
}

export async function test_array_class_default_integration(): number {
  if (host.callCount() !== 0) {
    throw { code: "TEST_FAIL", message: "construction expression ran at module load" };
  }
  let a: PlanBox = makeBox();
  let b: PlanBox = makeBox();
  if (host.callCount() !== 2) {
    throw { code: "TEST_FAIL", message: "provided host expression did not run once per attempt" };
  }
  a.buf[0] = 200;
  if (b.buf[0] !== 0) {
    throw { code: "TEST_FAIL", message: "provided buffers shared across instances" };
  }
  a.nested[0][0] = 9;
  if (b.nested[0][0] !== 0) {
    throw { code: "TEST_FAIL", message: "provided nested arrays shared across instances" };
  }
  a.deep[0][0][0] = 7;
  if (b.deep[0][0][0] !== 0) {
    throw { code: "TEST_FAIL", message: "provided deep arrays shared across instances" };
  }
  a.shared[0] = 55;
  if (b.shared[0] !== 55) {
    throw { code: "TEST_FAIL", message: "provided host array was deep-copied" };
  }
  let viaSync: number[] = a.syncFn([0]);
  if (viaSync.length !== 1) {
    throw { code: "TEST_FAIL", message: "provided sync callable failed" };
  }
  let viaAsync: number[] = await a.asyncFn([0, 0]);
  if (viaAsync.length !== 2) {
    throw { code: "TEST_FAIL", message: "provided async callable failed" };
  }
  let caught: boolean = false;
  try {
    let bad: BadBox = {payload: badBytes()};
  } catch (e) {
    caught = e.code === "E8001";
  }
  if (!caught) {
    throw { code: "TEST_FAIL", message: "validation failure did not raise E8001" };
  }
  // All provided expressions run in source order before declaration-order
  // field validation. The host effect survives the rejected boundary;
  // the target binding must remain the original instance.
  let holderBad: table = { b: "not-number[]" };
  let providedCaught: boolean = false;
  let target: PlanBox = a;
  try {
    target = {buf: holderBad.b, nested: [[0]], deep: [[[0]]], made: host.makeArray(2),
      shared: host.sharedArray(), syncFn: identity, asyncFn: echoAsync};
  } catch (e) {
    providedCaught = e.code === "E8001";
  }
  if (!providedCaught) {
    throw { code: "TEST_FAIL", message: "dynamic provided-value read did not raise E8001" };
  }
  if (host.callCount() !== 3 || target !== a) {
    throw { code: "TEST_FAIL", message: "failed boundary lost effects or published a partial instance" };
  }
  // A clean attempt after the failures still constructs correctly.
  let c2: PlanBox = makeBox();
  if (c2.buf.length !== 2 || host.callCount() !== 4) {
    throw { code: "TEST_FAIL", message: "post-failure attempt did not construct cleanly" };
  }
  let encoded: string = json.stringify({ box: a.buf });
  let decoded: table = json.parse(encoded);
  let box: number[] = decoded.box;
  if (box.length !== 2 || box[0] !== 200 || box[1] !== 0) {
    throw { code: "TEST_FAIL", message: "array JSON encoding mismatch" };
  }
  return 0;
}

export function main(): null {
  return null;
}
