// @spec: Runtime execution model — Runtime type descriptor format
// @description: A closure-cleared inner Record[] refinement fails at the first nested array construction element with E8003 and the canonical [record] descriptor.
// @expected: runtime-error E8003
// @features: descriptors, number[], dynamic-boundaries

import * as json from "std/json";

export function test_array_dynamic_nested_first_element(): number {
  let inner: Record<string, unknown>[] | null = [{value: 7}];
  let clear: () => void = function(): void { inner = null; };
  if (inner !== null) {
    clear();
    let xs: Record<string, unknown>[][] = [inner];
    return xs[0].length;
  }
  throw { code: "TEST_FAIL", message: "nested element branch skipped" };
}

export function main(): null {
  return null;
}
