// @spec: Runtime execution model — Runtime type descriptor format
// @description: A dynamic nested array crossing the recursive [[table]] row raises E8003 at the first failing index (element 1) with expected "[table]" and actual "table" (ISSUE-0550).
// @expected: runtime-error E8003
// @features: descriptors, int[], dynamic-boundaries

import * as json from "std/json";

export function test_array_dynamic_nested_first_element(): int {
  let t: table = json.parse("{\"values\":[[\"x\"],[\"y\"]]}");
  let xs: table[][] = t.values;
  return xs[0].length;
}

export function main(): null {
  return null;
}
