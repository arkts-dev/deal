// @spec: Async/Await — number[]-bearing async function values
// @description: First-class async(number[])->number[] values assign to typed locals, containerize in nullable arrays (null and real elements), complete exactly once through await with the canonical async(number[])->number[] descriptor, flow through number[][] signatures and callbacks, discard-await exactly once, propagate errors, and hold in class fields with the DEAL null preserved (v1.2)
// @expected: runtime-ok
// @features: number[], async, functions

async function echo(b: number[]): number[] {
  return b;
}

async function countArr(a: number[][]): number {
  return a.length;
}

async function applyBytes(f: async (b: number[]) => number[], b: number[]): number[] {
  return await f(b);
}

async function failEcho(b: number[]): number[] {
  throw { code: "E_TEST", message: "boom" };
}

export class Holder {
  cb: async (b: number[]) => number[];
  maybe: (async (b: number[]) => number[]) | null;
  n: number;
}

export async function test_array_async_closure(): number {
  let f: async (b: number[]) => number[] = echo;
  let out: number[] = await f([0, 0]);
  if (out.length !== 2) {
    throw { code: "TEST_FAIL", message: "async number[] value failed" };
  }
  let fs: ((async (b: number[]) => number[]) | null)[] = [];
  fs[fs.length] = echo;
  fs[fs.length] = null;
  let g: (async (b: number[]) => number[]) | null = fs[0];
  if (g !== null) {
    let again: number[] = await g([0, 0, 0]);
    if (again[0] !== 0) {
      throw { code: "TEST_FAIL", message: "containerized async invoke failed" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "containerized async value lost" };
  }
  // async function expression: awaited value roundtrip
  let f2: async (b: number[]) => number[] = async function(b: number[]): number[] {
    let echoed: number[] = []; while (echoed.length < b.length) { echoed[echoed.length] = 0; }
    echoed[0] = b[0];
    return echoed;
  };
  let r2: number[] = await f2([0]);
  if (r2.length !== 1 || r2[0] !== 0) {
    throw { code: "TEST_FAIL", message: "async fn expr await failed" };
  }
  // number[][] signature through await
  let arr: number[][] = [[0, 0], [0, 0, 0]];
  let n: number = await countArr(arr);
  if (n !== 2) {
    throw { code: "TEST_FAIL", message: "number[][] async signature failed" };
  }
  // callback position: an async number[] fn passed as a parameter
  let via: number[] = await applyBytes(echo, [0, 0, 0, 0]);
  if (via.length !== 4) {
    throw { code: "TEST_FAIL", message: "async number[] callback failed" };
  }
  // discard await evaluates exactly once with the completion check
  let hits: number = 0;
  async function counter(b: number[]): number[] {
    hits = hits + 1;
    return b;
  }
  await counter([0]);
  if (hits !== 1) {
    throw { code: "TEST_FAIL", message: "discard await count failed" };
  }
  // error propagation through await
  let caught: boolean = false;
  try {
    await failEcho([0]);
  } catch (e) {
    caught = e.code === "E_TEST";
  }
  if (!caught) {
    throw { code: "TEST_FAIL", message: "async error propagation failed" };
  }
  // class fields hold async number[] fn references (wrapper identity,
  // the DEAL null for the nullable field)
  let h: Holder = { cb: echo, maybe: null, n: 9 };
  let viaField: number[] = await h.cb([0, 0, 0, 0, 0]);
  if (viaField.length !== 5 || h.n !== 9) {
    throw { code: "TEST_FAIL", message: "class field async invoke failed" };
  }
  let m: (async (b: number[]) => number[]) | null = h.maybe;
  if (m !== null) {
    throw { code: "TEST_FAIL", message: "nullable field default failed" };
  }
  h.maybe = echo;
  let m2: (async (b: number[]) => number[]) | null = h.maybe;
  if (m2 !== null) {
    let viaMaybe: number[] = await m2([0, 0, 0, 0, 0, 0]);
    if (viaMaybe.length !== 6) {
      throw { code: "TEST_FAIL", message: "nullable field invoke failed" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "nullable field write failed" };
  }
  return 0;
}

export function main(): null {
  return null;
}
