// @expected: companion
// @spec: Arrays — Modules
// @description: Classified support module for the reference-array-module-identity conformance fixture: a shared-buffer closure factory, a reference echo, and a number[]-transform function-value factory crossing the module boundary.

export function makeShared(): () => number[] {
  let shared: number[] = [0, 0, 0];
  return function(): number[] {
    return shared;
  };
}

export function echo(b: number[]): number[] {
  return b;
}

export function makeTransform(): (x: number[]) => number[] {
  return function(x: number[]): number[] {
    x[0] = x[0] + 1;
    return x;
  };
}
