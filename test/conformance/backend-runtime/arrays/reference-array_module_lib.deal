// @expected: companion
// @spec: Arrays — Modules
// @description: Classified support module for the reference-array-module-identity conformance fixture: a shared-buffer closure factory, a reference echo, and a int[]-transform function-value factory crossing the module boundary.

export function makeShared(): () => int[] {
  let shared: int[] = [0, 0, 0];
  return function(): int[] {
    return shared;
  };
}

export function echo(b: int[]): int[] {
  return b;
}

export function makeTransform(): (x: int[]) => int[] {
  return function(x: int[]): int[] {
    x[0] = x[0] + 1;
    return x;
  };
}
