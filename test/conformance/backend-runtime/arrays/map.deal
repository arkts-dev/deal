// @spec: Arrays
// @description: Map snapshots length after mapper evaluation, reads live slots and retains callback boundaries and shallow identities
// @expected: runtime-ok
// @features: arrays, functions
class Item {x:number;}
function check(ok:boolean):void {if(!ok){throw {name:"MAP",message:"map mismatch"};}}
export function main():void {
  let xs:number[]=[1,2,3];let calls=0;
  let ys:string[]=xs.map((value:number,index:number,array:number[]):string=>{
    calls=calls+1;check(array===xs);
    if(index===0){array.push(4);array[1]=20;}
    return `${index}:${value}`;
  });
  check(calls===3 && ys.length===3 && ys[0]==="0:1" && ys[1]==="1:20" && ys[2]==="2:3" && xs.length===4);
  let zs=xs.map((value:number):number=>value*2);check(zs.length===4 && zs[3]===8);
  let empty:number[]=[];let emptyCalls=0;
  check(empty.map(():number=>{emptyCalls=emptyCalls+1;return 1;}).length===0 && emptyCalls===0);
  let original:number[]=[2,3];let saved=original;let effects="";
  let receiver=():number[]=>{effects=effects+"r";return original;};
  let mapper=():(value:number,index:number,array:number[])=>number=>{
    effects=effects+"m";saved.push(4);original=[99];
    return (value:number,index:number,array:number[]):number=>{check(array===saved);effects=effects+String(index);return value+index;};
  };
  let ordered=receiver().map(mapper());check(effects==="rm012" && ordered.length===3 && ordered[2]===6 && saved.length===3 && original[0]===99);
  let items:Item[]=[{x:1},{x:2}];let identities=items.map((value:Item):Item=>value);
  check(identities!==items && identities[0]===items[0]);identities[0].x=7;check(items[0].x===7);
  let matrix:number[][]=[[1],[2]];let copies=matrix.map((value:number[]):number[]=>value);check(copies[0]===matrix[0]);
  let functions:(()=>number)[]=[():number=>7];let mappedFunctions=functions.map((value:()=>number):()=>number=>value);
  check(mappedFunctions[0]===functions[0] && mappedFunctions[0]()===7);
  let captures=xs.map((value:number,index:number):()=>number=>():number=>value+index);
  check(captures[0]()===1 && captures[1]()===21 && captures[3]()===7);
  let nullish:(number|null|undefined)[]=[null,undefined,-0,0/0,1/0];
  let same=nullish.map((value:number|null|undefined):number|null|undefined=>value);
  check(same[0]===null && same[1]===undefined && 1/(same[2] as number)===-1/0 && Number.isNaN(same[3]));
  let text:string[]=["a\u0000","\ud800","\udc00"];
  check(text.map((value:string):string=>value).join("|")==="a\u0000|\ud800|\udc00");
  let decoded:number[]=JSON.parse("[4,5]");check(decoded.map((value:number):number=>value+1)[1]===6);
  let shrink:number[]=[1,2,3];let destination:number[]=[123];let old=destination;let seen=0;let caught=false;
  try {destination=shrink.map((value:number,index:number,array:number[]):number=>{
    seen=seen+1;if(index===0){array.pop();array.pop();}return value;
  });}catch(e){check((e as Error).name==="E8002" && (e as Error).message==="array index out of bounds");caught=true;}
  check(caught && seen===1 && destination===old && destination[0]===123 && shrink.length===1);
  effects="";caught=false;
  let abrupt=():(value:number)=>number=>{effects=effects+"m";throw {name:"MAPPER",message:"stop"};};
  try {destination=receiver().map(abrupt());}catch(e){check((e as Error).name==="MAPPER");caught=true;}
  check(caught && effects==="rm" && destination===old);
  seen=0;caught=false;
  try {destination=xs.map((value:number,index:number):number=>{seen=seen+1;if(index===1){throw {name:"CALLBACK",message:"stop"};}return value;});}
  catch(e){check((e as Error).name==="CALLBACK");caught=true;}
  check(caught && seen===2 && destination===old && xs.length===4);
  let nested=xs.map((value:number):number=>[value].map((inner:number):number=>inner+1)[0]);check(nested[1]===21);
  return ;
}
