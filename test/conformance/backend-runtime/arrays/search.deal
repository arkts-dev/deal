// @spec: Arrays
// @description: Array search normalization, equality, identity and saved operand effects
// @expected: runtime-ok
function check(ok:boolean,detail:string):void{if(!ok){throw {name:"CHECK",message:detail};}}
class Item{x:number;}
export function main():null{
  let xs:number[]=[1,2,1,0/0,-0,1/0,-1/0];
  check(xs.includes(1) && xs.indexOf(1)===0 && xs.indexOf(1,1)===2,"initial positions");
  check(xs.includes(0/0) && xs.indexOf(0/0)===-1 && xs.includes(0) && xs.indexOf(0)===4,"NaN and zero equality");
  check(xs.includes(1/0) && xs.indexOf(-1/0)===6 && !xs.includes(9) && xs.indexOf(9)===-1,"infinite and absent values");
  let bounds:number[]=[-1/0,-99,-7,-6.9,-1,-0.9,-0,0,0.9,1,2.9,7,99,1/0,0/0];
  for(let bound of bounds){
    let start=0;
    if(bound===bound){if(bound<=-7){start=0;}else if(bound<0){let k=0;while(k-1>=bound){k=k-1;}start=k<0?7+k:0;}else{while(start<7 && start+1<=bound){start=start+1;}}}
    for(let needle of xs){
      let index=-1;let found=false;let i=start;
      while(i<7){let v=xs[i];if(index===-1 && v===needle){index=i;}if(v===needle || Number.isNaN(v) && Number.isNaN(needle)){found=true;}i=i+1;}
      check(xs.indexOf(needle,bound)===index && xs.includes(needle,bound)===found,"normalization matrix");
    }
  }
  let empty:number[]=[];check(!empty.includes(1) && empty.indexOf(1)===-1,"empty array");
  let mixed:unknown[]=[true,false,1,"1",null,undefined,0/0];
  check(mixed.indexOf(true)===0 && mixed.indexOf(false)===1 && mixed.indexOf(1)===2 && mixed.indexOf("1")===3,"noncoercing scalar equality");
  check(mixed.indexOf(null)===4 && mixed.indexOf(undefined)===5 && mixed.includes(0/0),"unknown nullish equality");
  let strings:string[]=["\uD800\0","\uDC00",""];
  check(strings.includes("\uD800\0") && strings.indexOf("\uDC00")===1 && strings.indexOf("")===2,"UTF-16 equality");
  let item:Item={x:7};let other:Item={x:7};let items:Item[]=[item];
  check(items.includes(item) && items.indexOf(item)===0 && !items.includes(other) && items.indexOf(other)===-1,"nominal identity");
  let nested:number[][]=[xs];check(nested.includes(xs) && !nested.includes([1,2]),"nested identity");
  let fn=():number=>7;let otherFn=():number=>7;let funcs:(()=>number)[]=[fn];
  check(funcs.includes(fn) && funcs.indexOf(fn)===0 && !funcs.includes(otherFn),"callable identity");
  let decoded:number[]=JSON.parse("[2,4,6]");check(decoded.includes(4) && decoded.indexOf(6)===2,"decoded storage");
  check(!items.includes({x:7}) && !items.includes(JSON.parse("{\"x\":7}")),"contextual nominal needle is fresh");
  let calls=0;let short=():number=>{calls=calls+1;return 7;};
  let full=(x:number):number=>x;let adapted:((x:number)=>number)[]=[full];
  check(!adapted.includes(short) && adapted.indexOf(short)===-1 && calls===0,"shorter callable adapts without invocation");
  let log="";let receiver=():number[]=>{log=log+"r";return xs;};
  let value=():number=>{log=log+"v";xs.push(8);return 8;};
  let from=():number=>{log=log+"f";xs.push(9);return -2;};
  check(receiver().includes(value(),from()) && log==="rvf" && xs.length===9,"includes effects");
  log="";check(receiver().indexOf(value(),from())===9 && log==="rvf" && xs.length===11,"indexOf effects");
  let saved=xs;let replace=():number=>{xs=[99];return 1;};
  check(xs.indexOf(replace())===0 && saved.length===11 && xs[0]===99,"saved receiver");
  let stop=():number=>{log=log+"v";throw {name:"STOP",message:"stop"};};
  let result=123;log="";try{result=receiver().indexOf(stop(),from());}catch(e){check((e as Error).name==="STOP","abrupt error");}
  check(log==="rv","abrupt log: "+log);check(result===123,"abrupt destination");check(xs.length===1,"abrupt length");
  log="";let failFrom=():number=>{log=log+"f";throw {name:"STOP",message:"from"};};
  try{result=receiver().indexOf(value(),failFrom());}catch(e){check((e as Error).message==="from","from abrupt error");}
  check(log==="rvf" && result===123 && xs.length===2,"from abrupt rollback");
  log="";result=receiver().indexOf(value(),from());check(log==="rvf" && result===2 && xs.length===4,"assignment search order");
  return null;
}
