// @spec: Functions — arity extension over number[]-bearing signatures
// @description: compatible M<N prefix adapters over number[]-bearing function values delegate only the source prefix and silently ignore extras (v1.2)
// @expected: runtime-ok
// @features: number[], functions, arity

function id(b: number[]): number[] { return b; }

function bump(b: number[], v: number): number[] {
  b[0] = b[0] + v;
  return b;
}

export function test_array_fn_adapters(): number {
  let h: (b: number[], v: number) => number[] = id;
  let out: number[] = h([0, 0], 999);
  if (out[0] !== 0) {
    throw { code: "TEST_FAIL", message: "adapter ignored extra failed" };
  }
  let b: number[] = [0];
  let again: number[] = h(b, 12345);
  if (again !== b) {
    throw { code: "TEST_FAIL", message: "adapter prefix identity failed" };
  }
  let h2: (b: number[], v: number) => number[] = id;
  if (h2([0], 1)[0] !== 0) {
    throw { code: "TEST_FAIL", message: "second adapter failed" };
  }
  let two: (b: number[], v: number, extra: string) => number[] = id;
  let r: number[] = two([0, 0], 7, "ignored");
  if (r[0] !== 0) {
    throw { code: "TEST_FAIL", message: "three-param adapter failed" };
  }
  let withBump: (b: number[], v: number) => number[] = bump;
  let rb: number[] = withBump([0, 0], 5);
  if (rb[0] !== 5) {
    throw { code: "TEST_FAIL", message: "same-arity failed" };
  }
  return 0;
}

export function main(): null {
  return null;
}
