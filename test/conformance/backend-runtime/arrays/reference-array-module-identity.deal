// @spec: Arrays — Modules
// @description: Imports/exports preserve number[] carriers, canonical descriptors, and reference identity: a closure factory exported from a library keeps one captured buffer identity across repeated calls, mutation is visible through every import-path alias, and a number[]-bearing function value created in the library round-trips through import, invocation, and a dynamic table read that byte-checks its canonical descriptor.
// @expected: runtime-ok
// @features: number[], modules, functions, tables

import * as Lib from "./reference-array_module_lib";

export function test_array_module_identity(): string {
  let getShared: () => number[] = Lib.makeShared();
  let a: number[] = getShared();
  let b: number[] = getShared();
  if (!(a === b)) {
    throw { code: "TEST_FAIL", message: "imported closure lost the captured number[] identity across calls" };
  }
  a[1] = 99;
  if (getShared()[1] !== 99) {
    throw { code: "TEST_FAIL", message: "mutation invisible through the imported closure" };
  }
  let echoed: number[] = Lib.echo(a);
  if (!(echoed === a)) {
    throw { code: "TEST_FAIL", message: "imported echo lost reference identity" };
  }
  let f: (x: number[]) => number[] = Lib.makeTransform();
  let c: number[] = [0, 0];
  let ret: number[] = f(c);
  if (!(ret === c)) {
    throw { code: "TEST_FAIL", message: "imported transform lost reference identity" };
  }
  if (c[0] !== 1) {
    throw { code: "TEST_FAIL", message: "imported transform content mismatch" };
  }
  let holder: table = { f: f };
  let g: (x: number[]) => number[] = holder.f;
  let d: number[] = [0];
  let ret2: number[] = g(d);
  if (!(ret2 === d) || d[0] !== 1) {
    throw { code: "TEST_FAIL", message: "imported function value failed after the dynamic descriptor-checked round trip" };
  }
  return "module-identity-ok";
}

export function main(): null {
  return null;
}
