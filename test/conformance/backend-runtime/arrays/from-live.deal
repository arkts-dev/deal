// @spec: Standard library builtins — Array.from inferred synchronous mapping with live for-of traversal
// @expected: runtime-ok
// @features: arrays, closures, control-flow, classes
class Item {x:number;}
function check(ok:boolean,label:string):void{if(!ok){throw {code:label,message:label};}}
function one(x:number):number{return x+1;}
function fromReturn(xs:number[]):number[]{return Array.from(xs,one);}
export function main():null {
  let sources=0;let mappers=0;let effects="";let xs:number[]=[2,4];
  const source=():number[]=>{sources=sources+1;effects=effects+"s";return xs;};
  const mapper=():(x:number,i:number)=>number=>{mappers=mappers+1;effects=effects+"m";return (x:number,i:number):number=>{effects=effects+String(i);return x+i;};};
  let result=Array.from(source(),mapper());
  check(sources===1 && mappers===1 && effects==="sm01" && result.length===2 && result[0]===2 && result[1]===5,"evaluation");
  let dynamic:unknown=result;let sourceIdentity:unknown=xs;check(dynamic!==sourceIdentity,"fresh result");
  result[0]=20;check(xs[0]===2,"independent result");xs[0]=3;check(result[0]===20,"independent source");
  const empty:number[]=[];const emptyResult=Array.from(empty,mapper());
  check(emptyResult.length===0 && mappers===2 && effects==="sm01m","empty mapper evaluated");
  const extended=Array.from(xs,():number=>9);check(extended[0]===9 && extended[1]===9,"zero arity adapter");
  const returned=fromReturn(xs);check(returned[0]===4 && returned[1]===5,"one arity adapter");
  let shorter=one;const getShorter=():(x:number)=>number=>{mappers=mappers+1;return shorter;};
  const captured=Array.from(xs,getShorter());check(captured[0]===4 && mappers===3,"source adapter once");
  let live:number[]=[1,2];let alias=live;let visits="";
  const grown=Array.from(live,(x:number,i:number):number=>{
    visits=visits+String(i)+":"+String(x)+";";
    if(i===0){alias[1]=7;alias[2]=9;live=[100];}
    return x+i;
  });
  check(visits==="0:1;1:7;2:9;" && grown.length===3 && grown[1]===8 && grown[2]===11 && live.length===1,"live growth replacement");
  let shrinking:number[]=[1,2,3];let calls=0;
  const shrunk=Array.from(shrinking,(x:number,i:number):number=>{calls=calls+1;if(i===0){shrinking.splice(1,2);}return x;});
  check(calls===1 && shrunk.length===1 && shrunk[0]===1,"live shrink");
  const shifting:number[]=[1,2,3];
  const shifted=Array.from(shifting,(x:number,i:number):number=>{if(i===0){shifting.splice(0,1);}return x;});
  check(shifted.length===2 && shifted[0]===1 && shifted[1]===3,"live shift");
  let functions:(()=>number)[]=Array.from([5,6],(x:number,i:number):()=>number=>{let own=x+i;return ():number=>{own=own+1;return own;};});
  check(functions[0]()===6 && functions[1]()===8 && functions[0]()===7,"fresh captures");
  let item:Item={x:7};let identities=Array.from([item],(x:Item,i:number):Item=>x);
  check(identities[0]===item,"nominal reference identity");identities[0].x=8;check(item.x===8,"nominal alias");
  const nullable:(number|null|undefined)[]=[-0,null,undefined,0/0,1/0];
  const copied=Array.from(nullable,(x:number|null|undefined,i:number):number|null|undefined=>x);
  let zero=copied[0];if(zero!==null){if(zero!==undefined){check(1/zero===-1/0,"negative zero");}}else{throw {code:"ZERO",message:"zero"};}
  check(copied[1]===null && copied[2]===undefined,"nullish values");
  let nan=copied[3];if(nan!==null && nan!==undefined){check(nan!==nan,"NaN");}
  const units=Array.from(["\uD800","🌍"],(x:string,i:number):string=>x);check(units[0]==="\uD800" && units[1]==="🌍","UTF16");
  let mixed:unknown[]=[false,null,undefined,"text",1];let unknowns=Array.from(mixed,(x:unknown,i:number):unknown=>x);
  let first=unknowns[0];check(unknowns.length===5 && typeof first==="boolean" && unknowns[1]===null && unknowns[2]===undefined,"unknown descriptor");
  let destination:number[]=[77];let before:unknown=destination;calls=0;
  let failure:Error={code:"MAPPER",message:"stop"};
  try{destination=Array.from([1,2,3],(x:number,i:number):number=>{calls=calls+1;if(i===1){throw failure;}return x;});}
  catch(e){if(e instanceof Error){check(e===failure,"failure identity");}else{throw {code:"ERROR",message:"error"};}}
  let after:unknown=destination;check(after===before && destination[0]===77 && calls===2,"abrupt no publication");
  calls=0;const badSource=():number[]=>{throw failure;};
  try{Array.from(badSource(),mapper());}catch(e){calls=calls+1;}
  check(calls===1 && mappers===3,"source abrupt stops mapper");
  const badMapper=():(x:number,i:number)=>number=>{throw failure;};
  try{Array.from(source(),badMapper());}catch(e){calls=calls+1;}
  check(calls===2 && sources===2,"mapper evaluation abrupt");
  let refined:number[]|null=[1];const clear=():void=>{refined=null;};let rejected=false;
  if(refined!==null){clear();try{Array.from(refined,mapper());}catch(e){check((e as Error).code==="E8001","stale source");rejected=true;}}
  check(rejected && mappers===3,"stale source stops mapper");
  let selected:((x:number)=>number)|null=one;const clearMapper=():void=>{selected=null;};
  rejected=false;if(selected!==null){clearMapper();try{Array.from(xs,selected);}catch(e){check((e as Error).code==="E8001","stale mapper");rejected=true;}}
  check(rejected,"stale mapper rejected");
  const recurse=(n:number):number=>{if(n===0){return 1;}const next=Array.from([n-1],(x:number):number=>recurse(x));return n+next[0];};
  check(recurse(4)===11,"recursive mapping");
  return null;
}
