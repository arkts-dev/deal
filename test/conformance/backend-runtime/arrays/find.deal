// @spec: Arrays
// @description: Find and findIndex snapshot after predicate evaluation, read live slots and stop at the first match
// @expected: runtime-ok
// @features: arrays, functions
class Item {x:number;}
function check(ok:boolean):void {if(!ok){throw {name:"FIND",message:"find mismatch"};}}
export function main():void {
  let xs:number[]=[1,2,3];let calls=0;
  let found=xs.find((value:number,index:number,array:number[]):boolean=>{
    calls=calls+1;check(array===xs);if(index===0){array[1]=20;array.push(4);}return value===20;
  });
  check((found as number)===20 && calls===2 && xs.length===4);
  check(xs.findIndex((value:number):boolean=>value===3)===2);
  check(xs.findIndex(():boolean=>false)===-1 && xs.find(():boolean=>false)===undefined);
  let empty:number[]=[];calls=0;
  check(empty.find(():boolean=>{calls=calls+1;return true;})===undefined);
  check(empty.findIndex(():boolean=>{calls=calls+1;return true;})===-1 && calls===0);
  let original:number[]=[2,3];let saved=original;let effects="";
  let receiver=():number[]=>{effects=effects+"r";return original;};
  let predicate=():(value:number,index:number,array:number[])=>boolean=>{
    effects=effects+"p";saved.push(4);original=[99];
    return (value:number,index:number,array:number[]):boolean=>{check(array===saved);effects=effects+String(index);return value===4;};
  };
  check(receiver().findIndex(predicate())===2 && effects==="rp012" && original[0]===99);
  let growth:number[]=[1];calls=0;
  check(growth.findIndex((value:number):boolean=>{calls=calls+1;growth.push(2);return false;})===-1 && calls===1);
  let item:Item={x:7};let items:Item[]=[item];check((items.find(():boolean=>true) as Item)===item);
  let replacement:Item={x:8};check((items.find((value:Item):boolean=>{items[0]=replacement;return true;}) as Item)===item && items[0]===replacement);
  let callback=():number=>9;let functions:(()=>number)[]=[callback];
  check((functions.find(():boolean=>true) as ()=>number)===callback);
  let matrix:number[][]=[[1],[2]];check((matrix.find(():boolean=>true) as number[])===matrix[0]);
  let nullish:(number|null|undefined)[]=[null,undefined,-0,0/0,1/0];
  check(nullish.findIndex((value:number|null|undefined):boolean=>value===null)===0);
  check(nullish.findIndex((value:number|null|undefined):boolean=>value===undefined)===1);
  check(1/(nullish.find((value:number|null|undefined,index:number):boolean=>index===2) as number)===-1/0);
  check(Number.isNaN(nullish.find((value:number|null|undefined,index:number):boolean=>index===3)));
  let text:string[]=["a\u0000","\ud800","\udc00"];
  check((text.find((value:string):boolean=>value==="\ud800") as string)==="\ud800");
  let decoded:number[]=JSON.parse("[4,5]");check(decoded.findIndex((value:number):boolean=>value===5)===1);
  let shrink:number[]=[1,2,3];let destination:number|undefined=123;let seen=0;let caught=false;
  try {destination=shrink.find((value:number,index:number,array:number[]):boolean=>{
    seen=seen+1;if(index===0){array.pop();array.pop();}return false;
  });}catch(e){check((e as Error).name==="E8002" && (e as Error).message==="array index out of bounds");caught=true;}
  check(caught && seen===1 && (destination as number)===123 && shrink.length===1);
  shrink=[1,2,3];seen=0;caught=false;let indexDestination=123;
  try {indexDestination=shrink.findIndex((value:number,index:number,array:number[]):boolean=>{
    seen=seen+1;if(index===0){array.pop();array.pop();}return false;
  });}catch(e){check((e as Error).name==="E8002");caught=true;}
  check(caught && seen===1 && indexDestination===123);
  let early:number[]=[1,2,3];check((early.find((value:number):boolean=>{early.pop();early.pop();return true;}) as number)===1);
  early=[1,2,3];check(early.findIndex((value:number):boolean=>{early.pop();early.pop();return true;})===0);
  effects="";caught=false;
  let abrupt=():(value:number)=>boolean=>{effects=effects+"p";throw {name:"PREDICATE",message:"stop"};};
  try {destination=receiver().find(abrupt());}catch(e){check((e as Error).name==="PREDICATE");caught=true;}
  check(caught && effects==="rp" && (destination as number)===123);
  seen=0;caught=false;
  try {indexDestination=xs.findIndex((value:number,index:number):boolean=>{seen=seen+1;if(index===1){throw {name:"CALLBACK",message:"stop"};}return false;});}
  catch(e){check((e as Error).name==="CALLBACK");caught=true;}
  check(caught && seen===2 && indexDestination===123);
  check(xs.findIndex((value:number):boolean=>[value].findIndex((inner:number):boolean=>inner===3)===0)===2);
  return ;
}
