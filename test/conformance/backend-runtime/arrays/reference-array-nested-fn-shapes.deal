// @spec: Functions — nested sync number[]-bearing function signatures
// @description: a first-class function value returning another number[]-bearing function, nested wrapper shapes, class fields holding number[]-bearing function values — plain, nullable, and nullable-parameter slots with a default-provided function reference — and the callee-first evaluation pin for a call through a class field whose argument side effect reassigns the called field (spec Operational semantics rule 1; v1.2)
// @expected: runtime-ok
// @features: number[], functions, classes

function id(b: number[]): number[] { return b; }

function picker(): (b: number[]) => number[] { return id; }

function combine(f: (b: number[]) => number[]): (b: number[]) => number[] {
  return f;
}

function idMaybe(b: number[] | null): number[] {
  if (b !== null) { b[0] = 1; return b; }
  return [];
}

function markTwo(b: number[] | null): number[] {
  if (b !== null) { b[0] = 2; return b; }
  return [];
}

class Holder {
  cb: (b: number[]) => number[] = id;
  maybe: ((b: number[]) => number[]) | null = null;
  cbMaybe: (b: number[] | null) => number[] = idMaybe;
}

// The reassignment lives INSIDE the call argument: the callee field
// read must happen first (spec Operational semantics rule 1 — LuaJIT
// reads box.cbMaybe before evaluating any argument), so the call
// invokes the pre-reassignment binding.
function retarget(box: Holder): table {
  box.cbMaybe = markTwo;
  return { x: [0] };
}

export function test_array_nested_fn_shapes(): number {
  let f: () => (b: number[]) => number[] = picker;
  let g: (b: number[]) => number[] = f();
  if (g([0, 0]).length !== 2) {
    throw { code: "TEST_FAIL", message: "nested fn return failed" };
  }
  let h: (b: number[]) => number[] = combine(id);
  if (h([0, 0, 0]).length !== 3) {
    throw { code: "TEST_FAIL", message: "fn-of-fn failed" };
  }
  let box: Holder = {};
  if (box.cb([0]).length !== 1) {
    throw { code: "TEST_FAIL", message: "class field fn failed" };
  }
  let stored: ((b: number[]) => number[]) | null = box.maybe;
  if (stored !== null) {
    throw { code: "TEST_FAIL", message: "nullable fn field default failed" };
  }
  box.cb = picker();
  if (box.cb([0, 0, 0, 0]).length !== 4) {
    throw { code: "TEST_FAIL", message: "class field fn write failed" };
  }
  box.maybe = id;
  let via: ((b: number[]) => number[]) | null = box.maybe;
  if (via !== null) {
    let out: number[] = via([0, 0, 0, 0, 0]);
    if (out.length !== 5) {
      throw { code: "TEST_FAIL", message: "nullable fn field write failed" };
    }
  }
  let ordered: number[] = box.cbMaybe(retarget(box).x);
  if (ordered[0] !== 1) {
    throw { code: "TEST_FAIL", message: "callee-first field read failed" };
  }
  let list: (() => (b: number[]) => number[])[] = [picker];
  let again: (b: number[]) => number[] = list[0]();
  if (again([0, 0, 0, 0]).length !== 4) {
    throw { code: "TEST_FAIL", message: "nested fn array failed" };
  }
  return 0;
}

export function main(): null {
  return null;
}
