// @spec: Runtime execution model — Runtime type descriptor format
// @description: A function wrapper whose carried descriptor differs byte-for-byte from the expected canonical (number[])->number[] text raises E8010 at the dynamic function row (ISSUE-0550).
// @expected: runtime-error E8010
// @features: descriptors, number[], dynamic-boundaries

import * as host from "host/signature_mutation";
function asInt(x: number): number {
  return x;
}

export function test_array_dynamic_function_mismatch(): number {
  let source: (b: number[]) => number[] = function(b: number[]): number[] { return b; };
  if (!host.replaceSignature({value: source}, "(number)->number")) { throw {code: "TEST_FAIL", message: "signature mutation failed"}; }
  let f: (b: number[]) => number[] = source;
  return f([0]).length;
}

export function main(): null {
  return null;
}
