// @spec: Arrays — indexing, byte-value checks, and reference semantics
// @description: Arrays preserve references and failed out-of-bounds writes evaluate operands then leave the buffer unchanged
// @expected: runtime-ok
// @features: number[], int32, aliasing, evaluation-order, runtime-errors

export function main(): null {
  let b: number[] = [0, 0];
  let alias: number[] = b;
  if (b.length !== 2 || b[0] !== 0 || b[1] !== 0 || b !== alias) {
    throw { code: "TEST_FAIL", message: "number[] allocation or identity mismatch" };
  }
  alias[0] = 255;
  if (b[0] !== 255) {
    throw { code: "TEST_FAIL", message: "number[] alias mutation mismatch" };
  }

  let trace: string = "";
  function target(): number[] { trace = trace + "T"; return b; }
  function index(): number { trace = trace + "I"; return 3; }
  function value(): number { trace = trace + "V"; return 256; }

  try {
    target()[index()] = value();
    trace = trace + "X";
  } catch (e) {
    trace = trace + "C";
  }
  if (trace !== "TIVC" || b[1] !== 0) {
    throw { code: "TEST_FAIL", message: "failed byte write behavior: " + trace };
  }
  return null;
}
