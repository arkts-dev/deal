// @spec: Functions — int[]-bearing signatures in arrays
// @description: ((int[])->int[])[] and [?(int[])->int[]] hold first-class sync int[]-bearing function values; elements are stored, read, and invoked end to end with the canonical (int[])->int[] descriptor (v1.2)
// @expected: runtime-ok
// @features: int[], functions, arrays

function bump(b: int[], v: int): int[] {
  b[0] = b[0] + v;
  return b;
}

function id(b: int[]): int[] {
  return b;
}

export function test_array_function_array_closure(): int {
  let fs: ((b: int[], v: int) => int[])[] = [bump, bump];
  fs[fs.length] = bump;
  let r: int[] = fs[0]([0, 0], 5);
  if (r[0] !== 5) {
    throw { code: "TEST_FAIL", message: "two-param function array invoke failed" };
  }
  let gs: ((b: int[]) => int[])[] = [id, id];
  gs[1] = id;
  let out: int[] = gs[0]([0]);
  if (out.length !== 1) {
    throw { code: "TEST_FAIL", message: "single-param function array invoke failed" };
  }
  let ns: (((b: int[]) => int[]) | null)[] = [];
  ns[ns.length] = id;
  ns[ns.length] = null;
  let first: ((b: int[]) => int[]) | null = ns[0];
  if (first !== null) {
    let via: int[] = first([0, 0, 0]);
    if (via.length !== 3) {
      throw { code: "TEST_FAIL", message: "nullable function array invoke failed" };
    }
  }
  return 0;
}

export function main(): null {
  return null;
}
