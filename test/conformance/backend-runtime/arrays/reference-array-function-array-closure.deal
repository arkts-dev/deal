// @spec: Functions — number[]-bearing signatures in arrays
// @description: ((number[])->number[])[] and [?(number[])->number[]] hold first-class sync number[]-bearing function values; elements are stored, read, and invoked end to end with the canonical (number[])->number[] descriptor (v1.2)
// @expected: runtime-ok
// @features: number[], functions, arrays

function bump(b: number[], v: number): number[] {
  b[0] = b[0] + v;
  return b;
}

function id(b: number[]): number[] {
  return b;
}

export function test_array_function_array_closure(): number {
  let fs: ((b: number[], v: number) => number[])[] = [bump, bump];
  fs[fs.length] = bump;
  let r: number[] = fs[0]([0, 0], 5);
  if (r[0] !== 5) {
    throw { code: "TEST_FAIL", message: "two-param function array invoke failed" };
  }
  let gs: ((b: number[]) => number[])[] = [id, id];
  gs[1] = id;
  let out: number[] = gs[0]([0]);
  if (out.length !== 1) {
    throw { code: "TEST_FAIL", message: "single-param function array invoke failed" };
  }
  let ns: (((b: number[]) => number[]) | null)[] = [];
  ns[ns.length] = id;
  ns[ns.length] = null;
  let first: ((b: number[]) => number[]) | null = ns[0];
  if (first !== null) {
    let via: number[] = first([0, 0, 0]);
    if (via.length !== 3) {
      throw { code: "TEST_FAIL", message: "nullable function array invoke failed" };
    }
  }
  return 0;
}

export function main(): null {
  return null;
}
