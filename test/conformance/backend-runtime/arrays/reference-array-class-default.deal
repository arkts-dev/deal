// @spec: Arrays
// @description: A required number[] class field receives an explicit value and retains its length.
// @expected: runtime-ok
// @features: number[], classes

class Packet { payload: number[]; }

export function main(): null {
  let packet: Packet = {payload: [0, 0]};
  if (packet.payload.length !== 2) { throw { code: "TEST_FAIL", message: "number[] class field mismatch" }; }
  return null;
}
