// @spec: Arrays
// @description: A class field may use number[] and receive a number[] default value.
// @expected: runtime-ok
// @features: number[], classes, defaults

class Packet { payload: number[] = [0, 0]; }

export function main(): null {
  let packet: Packet = {};
  if (packet.payload.length !== 2) { throw { code: "TEST_FAIL", message: "number[] class default mismatch" }; }
  return null;
}
