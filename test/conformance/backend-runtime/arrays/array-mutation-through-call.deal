// @spec: Arrays — Mutation through function calls
// @description: Array mutation inside a function is visible to the caller through shared array identity
// @expected: runtime-ok
// @features: arrays, functions, mutation

function bump(xs: number[]): null {
  xs[0] = xs[0] + 10;
  return null;
}

export function test_array_mutation_through_call(): number {
  let xs: number[] = [1, 2, 3];
  bump(xs);
  if (xs[0] !== 11) { throw { code: "TEST_FAIL", message: "array mutation through call failed" }; }
  return xs[0];
}

export function main(): null {
  return null;
}
