// @spec: Runtime execution model — Runtime type descriptor format
// @description: Class atoms with int[]-typed fields cross the canonical boundary: construction tags instances with the module-qualified atom, int[] fields read and write as real buffers, and provided per-instance values stay isolated (v1.2)
// @expected: runtime-ok
// @features: descriptors, int[], classes

class Payload {
  data: int[] = [0, 0];
  tag: string = "";
}

function describe(p: Payload): int {
  return p.data.length;
}

export function test_array_class_field_descriptor(): string {
  let p: Payload = { data: [0, 0, 0], tag: "a" };
  if (describe(p) !== 3) {
    throw { code: "TEST_FAIL", message: "int[] class field boundary mismatch" };
  }
  p.data[1] = 200;
  let q: Payload = { data: [0], tag: "b" };
  if (q.data.length !== 1) {
    throw { code: "TEST_FAIL", message: "second instance length mismatch" };
  }
  if (p.data[1] !== 200) {
    throw { code: "TEST_FAIL", message: "instances must not share int[] storage" };
  }
  return "canonical int[] class field descriptor ok";
}

export function main(): null {
  return null;
}
