// @spec: Runtime execution model — Runtime type descriptor format
// @description: The nullable ?(number[])->number[] row passes the DEAL null and a real (number[])->number[] wrapper crossing a dynamic boundary (ISSUE-0550).
// @expected: runtime-ok
// @features: descriptors, number[], functions, dynamic-boundaries

export function test_array_dynamic_nullable_function_ok(): string {
  let id: (b: number[]) => number[] = function(b: number[]): number[] { return b; };
  let holderNull: Record<string, unknown> = { f: null };
  let f: ((b: number[]) => number[]) | null = holderNull.f as ((b: number[]) => number[]) | null;
  if (f !== null) {
    throw { code: "TEST_FAIL", message: "nullable function null pass-through mismatch" };
  }
  let holderFn: Record<string, unknown> = { g: id };
  let g: ((b: number[]) => number[]) | null = holderFn.g as ((b: number[]) => number[]) | null;
  if (g !== null) {
    if (g([0]).length !== 1) {
      throw { code: "TEST_FAIL", message: "nullable function call mismatch" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "nullable function value lost" };
  }
  return "dynamic ?(number[])->number[] ok";
}

export function main(): null {
  return null;
}
