// @spec: Arrays — Array writes
// @description: Writing to index greater than length is out of bounds and raises E8002
// @expected: runtime-error E8002
// @features: arrays, indexing, runtime

export function test_array_write_gap(): int {
  let xs: int[] = [1, 2, 3];
  xs[4] = 99;
  return xs[4];
}

export function main(): null {
  return null;
}
