// @spec: Standard library builtins — JSON encoding
// @description: JSON.stringify rejects a path-local container cycle; shared acyclic children remain legal
// @expected: runtime-error E8001
// @features: stdlib, json, cycle, v1.4



export function test_json_stringify_cycle(): string {
  let t: Record<string, unknown> = {};
  t.self = t;
  return JSON.stringify(t) as string;
}

export function main(): null {
  return null;
}
