// @spec: Standard library builtins — JSON decoding
// @description: JSON.parse rejects a decoded-key duplicate at the second key's opening quote with E8001
// @expected: runtime-error E8001
// @features: stdlib, json, duplicate-key, v1.4



export function test_json_parse_duplicate_key(): Record<string, unknown> {
  return JSON.parse("{\"a\":1,\"a\":2}");
}

