// @spec: Standard library declarations — std/json.d.deal
// @description: json.parse/json.stringify round-trip a finite 600-level nesting without any fixed depth cap (v1.4)
// @expected: runtime-ok
// @features: stdlib, json, deep, v1.4

import * as json from "std/json";

export function test_json_deep_finite_roundtrip(): null {
  let text: string = "1";
  { let v14Loop0: number = 0; while (v14Loop0 < 600) { let i: number = v14Loop0; {
    text = "{\"d\":" + text + "}";
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  let parsed: Record<string, unknown> = json.parse(text);
  let out: string = json.stringify(parsed) as string;
  let decoded: Record<string, unknown> = json.parse(out);
  let cursor: Record<string, unknown> = decoded;
  let depth: number = 0;
  while (depth < 599) {
    let next: Record<string, unknown> = cursor.d as Record<string, unknown>;
    cursor = next;
    depth = depth + 1;
  }
  let leaf: number = cursor.d as number;
  if (leaf !== 1) {
    throw { code: "TEST_FAIL", message: "the 600-level nesting must round-trip" };
  }
  return null;
}

export function main(): null {
  return null;
}
