// @spec: Standard library declarations — std/json.d.deal
// @description: JSON numbers preserve binary64 values across signed32 boundaries, padded exponents and zero-sign serialization
// @expected: runtime-ok
// @features: stdlib, json, number

import * as json from "std/json";
import * as str from "std/string";

function value(text: string): number {
  let parsed: Record<string, unknown> = json.parse(text);
  return parsed.v as number;
}

function roundtrip(text: string, expected: number): null {
  let parsed: Record<string, unknown> = json.parse(text);
  if ((parsed.v as number) !== expected) {
    throw {code: "TEST_FAIL", message: "numeric parse mismatch"};
  }
  let encoded: string = json.stringify(parsed) as string;
  if (value(encoded) !== expected) {
    throw {code: "TEST_FAIL", message: "numeric roundtrip mismatch"};
  }
  return null;
}

export function main(): null {
  let t: Record<string, unknown> = json.parse("{\"a\":2147483647,\"b\":2147483648,\"c\":-2147483648,\"d\":-2147483649,\"z\":-0}");
  if ((t.a as number) !== 2147483647 || (t.c as number) !== -2147483648) {
    throw {code: "TEST_FAIL", message: "signed32 boundary values"};
  }
  if ((t.b as number) !== 2147483647 + 1 || (t.d as number) !== -2147483648 - 1) {
    throw {code: "TEST_FAIL", message: "values outside signed32"};
  }
  let z: number = t.z as number;
  if (1 / z !== -1 / 0) { throw {code: "TEST_FAIL", message: "parse lost negative zero"}; }
  let s: string = json.stringify(t) as string;
  if (!str.contains(s, "\"z\":0") || str.contains(s, "-0")) {
    throw {code: "TEST_FAIL", message: "stringify must normalize negative zero"};
  }
  roundtrip("{\"v\":-2147483649}", -2147483649);
  roundtrip("{\"v\":-9999999999}", -9999999999);
  roundtrip("{\"v\":-2147483648}", -2147483648);
  roundtrip("{\"v\":1e0000000000000000001}", 10);
  roundtrip("{\"v\":1e00000000000000000000}", 1);
  roundtrip("{\"v\":100e-000000000000000000002}", 1);
  return null;
}
