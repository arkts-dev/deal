// @spec: Standard library declarations — std/math.d.deal
// @description: Negative sqrt yields NaN while signed zero and positive infinity are preserved
// @expected: runtime-ok
// @features: stdlib, math, number, v1.5

import * as math from "std/math";

export function test_math_sqrt_negative(): number {
  let result = math.sqrt(-1.0);
  if (result === result || math.sqrt(-1 / 0) === math.sqrt(-1 / 0)
      || 1 / math.sqrt(-0) !== -1 / 0 || math.sqrt(1 / 0) !== 1 / 0) {
    throw {code: "TEST_FAIL", message: "sqrt binary64 contract"};
  }
  return 0;
}

export function main(): null {
  return null;
}
