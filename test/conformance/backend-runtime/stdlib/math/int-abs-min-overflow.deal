// @spec: Standard library declarations — std/math.d.deal
// @description: absNumber returns the magnitude beyond signed32 without trapping
// @expected: runtime-ok
// @features: stdlib, math, int, overflow, v1.2

import * as math from "std/math";

export function test_abs_int_min_overflow(): number {
  let result: number = math.absNumber(-2147483648);
  if (result !== 2147483648) { throw { code: "TEST_FAIL", message: "absolute value was refined to signed32" }; }
  return result;
}

export function main(): null {
  return null;
}
