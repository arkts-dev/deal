// @spec: Standard library declarations — std/table errors
// @description: A dynamic non-record argument fails its checked assertion before std/table.keys
// @expected: runtime-error E8001
// @features: stdlib, table, runtime-errors

import * as tables from "std/table";

export function test_table_keys_nontable_error(): string[] {
  let t: Record<string, unknown> = { value: "seven" };
  return tables.keys(t.value as Record<string, unknown>);
}

export function main(): null {
  return null;
}
