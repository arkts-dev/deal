// @spec: Standard library declarations — std/table.d.deal
// @description: std/table.keys returns the table's string keys: a key spelled with decimal digits is an ordinary string key (never an array index), so it appears in keys() and a string-key delete removes it
// @expected: runtime-ok
// @features: stdlib, table, v1.3

import * as tables from "std/table";

export function test_table_keys_decimal_string_names(): null {
  let t: table = {};
  t["1"] = 10;
  t["2"] = 20;
  t["3"] = 30;
  t.keep = 7;
  delete t["1"];
  delete t["2"];
  delete t["3"];
  let ks: string[] = tables.keys(t);
  if (ks.length !== 1) {
    throw { code: "TEST_FAIL", message: "the decimal-digit keys were not ordinary deletable string keys" };
  }
  if (ks[0] !== "keep") {
    throw { code: "TEST_FAIL", message: "the string key is missing" };
  }
  return null;
}

export function main(): null {
  return null;
}
