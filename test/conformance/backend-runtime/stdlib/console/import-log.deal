// @spec: Standard library declarations — std/console
// @description: std/console can be imported and used
// @expected: runtime-ok
// @features: stdlib, console

import * as console from "std/console"

export function test_console_log(): null {
  let result: null = console.log("hello");
  if (result !== null) {
    throw { code: "TEST_FAIL", message: "console.log must complete with the declared null result" };
  }
  return result;
}

export function main(): null {
  return null;
}
