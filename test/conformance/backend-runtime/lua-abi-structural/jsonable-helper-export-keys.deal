// @spec: Standard library builtins — JSON
// @description: Ordinary exported encode/decode functions use legal DEAL names and remain callable through saved values.
// @expected: runtime-ok
// @features: lua-abi, json, structural, functions

export class AbiUser { name: string; }
export function encode(value: AbiUser): string { return JSON.stringify(value) as string; }
export function decode(text: string): AbiUser { return JSON.parse(text); }

export function test_abi_jsonable_helper_export_keys(): null {
  let parse: (text: string) => AbiUser = decode;
  let stringify: (value: AbiUser) => string = encode;
  let u: AbiUser = parse("{\"name\":\"Ada\"}");
  let u2: AbiUser = parse(stringify(u));
  if (u2.name !== "Ada" || u === u2 || parse !== decode || stringify !== encode) {
    throw {code: "TEST_FAIL", message: "ordinary JSON export key or identity failed"};
  }
  return null;
}

export function main(): null { return null; }
