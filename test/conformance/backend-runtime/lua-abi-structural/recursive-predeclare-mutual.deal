// @spec: Lua backend ABI — mutual recursive function lowering
// @description: Mutual recursion exercises predeclared Lua function wrapper bindings
// @expected: runtime-ok
// @features: lua-abi, recursion, structural

function a(n: int): int {
  if (n === 0) { return 0; }
  return b(n - 1) + 1;
}

function b(n: int): int {
  if (n === 0) { return 0; }
  return a(n - 1) + 1;
}

export function test_abi_mutual_recursion_predeclare(): int {
  let result: int = a(5);
  if (result !== 5) { throw { code: "TEST_FAIL", message: "mutual recursion ABI failed" }; }
  return result;
}
