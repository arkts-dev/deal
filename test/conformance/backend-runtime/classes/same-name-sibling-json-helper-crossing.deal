// @spec: Classes — JSON serialization (@jsonable) and nominal identity
// @description: Checked extraction rejects the first sibling's @jsonable Payload as the second sibling's Payload with E8001 and the actual declaration atom; one plan-bearing nominal instance cannot enter the other type.
// @expected: runtime-error E8001
// @features: jsonable, classes, modules, runtime-errors, nominal-identity

import * as a from "./same_name_sibling_a";
import * as b from "./same_name_sibling_b";

export function main(): null {
  let t: Record<string, unknown> = { value: a.makePayload() };
  let wrong: b.Payload = t.value as b.Payload;
  return null;
}
