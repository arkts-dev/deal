// @spec: Classes — Optional and nullable fields
// @description: Optional null reads distinguish undefined absence from present null across local/imported classes, calls, arrays, narrowing, deletion and generated JSON; other optional fields retain independent null/undefined admission
// @expected: runtime-ok
// @features: classes, optional, null, undefined, field-read, hasOwn, cross-module, jsonable

import * as console from "std/console";
import * as Lib from "./optional_null_field_lib";

class Box {
  n?: null;
  tag?: string;
  maybe?: string | null;
}

function require(what: string, condition: boolean): void {
  if (!condition) {
    throw { code: "TEST_FAIL", message: what };
  }
}

function readN(b: Box): null | undefined {
  return b.n;
}

function keep(b: Box): Box {
  return b;
}

export function main(): null {
  let missing: Box = {};
  require("missing hasOwn is false", !Object.hasOwn(missing, "n"));
  let missingN: null | undefined = missing.n;
  require("missing read is undefined", missingN === undefined);

  let explicitNull: Box = { n: null };
  require("explicit null hasOwn is true", Object.hasOwn(explicitNull, "n"));
  let explicitN: null | undefined = explicitNull.n;
  require("explicit null read is null", explicitN === null);

  missing.n = null;
  require("written null hasOwn is true", Object.hasOwn(missing, "n"));
  let writtenN: null | undefined = missing.n;
  require("written null read is null", writtenN === null);
  delete missing.n;
  require("deleted hasOwn is false", !Object.hasOwn(missing, "n"));
  let deletedN: null | undefined = missing.n;
  require("deleted read is undefined", deletedN === undefined);

  let passed: Box = keep({ n: null });
  let passedN: null | undefined = passed.n;
  require("parameter read is null", passedN === null);
  let returnedN: null | undefined = readN({ n: null });
  require("returned read is null", returnedN === null);
  let returnedMissingN: null | undefined = readN({});
  require("returned missing read is undefined", returnedMissingN === undefined);

  let narrowed: Box | null = { n: null };
  if (narrowed !== null) {
    let narrowedN: null | undefined = narrowed.n;
    require("narrowed receiver read is null", narrowedN === null);
    require("narrowed receiver hasOwn is true", Object.hasOwn(narrowed, "n"));
  }

  let boxes: Box[] = [{ n: null }, {}];
  let elementN: null | undefined = boxes[0].n;
  require("array element read is null", elementN === null);
  require("array element hasOwn is true", Object.hasOwn(boxes[0], "n"));
  require("array element missing hasOwn is false", !Object.hasOwn(boxes[1], "n"));

  let values: Box = { tag: "x", maybe: null };
  require("present tag hasOwn is true", Object.hasOwn(values, "tag"));
  let tag: string | undefined = values.tag;
  require("present tag is defined", tag !== undefined);
  require("present maybe hasOwn is true", Object.hasOwn(values, "maybe"));
  let maybe: string | null | undefined = values.maybe;
  require("present maybe read is null", maybe === null);
  let absent: Box = {};
  let absentTag: string | undefined = absent.tag;
  require("missing tag read is undefined", absentTag === undefined);
  let absentMaybe: string | null | undefined = absent.maybe;
  require("missing maybe read is undefined", absentMaybe === undefined);

  let importedMissing: Lib.LibBox = {};
  require("imported missing hasOwn is false", !Object.hasOwn(importedMissing, "n"));
  let importedMissingN: null | undefined = importedMissing.n;
  require("imported missing read is undefined", importedMissingN === undefined);
  let importedNull: Lib.LibBox = { n: null, tag: "y" };
  require("imported explicit null hasOwn is true", Object.hasOwn(importedNull, "n"));
  let importedNullN: null | undefined = importedNull.n;
  require("imported explicit null read is null", importedNullN === null);
  require("imported tag hasOwn is true", Object.hasOwn(importedNull, "tag"));
  let importedTag: string | undefined = importedNull.tag;
  require("imported tag read is defined", importedTag !== undefined);
  let importedMaybe: string | null | undefined = importedNull.maybe;
  require("imported missing maybe read is undefined", importedMaybe === undefined);
  let importedReturned: null | undefined = Lib.readMissing(importedMissing);
  require("imported reader read is undefined", importedReturned === undefined);

  let decodedNull: Lib.LibNote | null =
    Lib.LibNote$fromJson("{\"label\":\"a\",\"n\":null}");
  require("decoded explicit null is not null", decodedNull !== null);
  if (decodedNull !== null) {
    require("decoded explicit null hasOwn is true", Object.hasOwn(decodedNull, "n"));
    let decodedN: null | undefined = decodedNull.n;
    require("decoded explicit null read is null", decodedN === null);
    let encoded: string = Lib.LibNote$toJson(decodedNull);
    let redecoded: Lib.LibNote | null = Lib.LibNote$fromJson(encoded);
    require("roundtrip of explicit null is not null", redecoded !== null);
    if (redecoded !== null) {
      require("roundtrip explicit null hasOwn is true", Object.hasOwn(redecoded, "n"));
      let roundtripN: null | undefined = redecoded.n;
      require("roundtrip explicit null read is null", roundtripN === null);
    }
  }

  let decodedMissing: Lib.LibNote | null = Lib.LibNote$fromJson("{\"label\":\"b\"}");
  require("decoded missing is not null", decodedMissing !== null);
  if (decodedMissing !== null) {
    require("decoded missing hasOwn is false", !Object.hasOwn(decodedMissing, "n"));
    let decodedMissingN: null | undefined = decodedMissing.n;
    require("decoded missing read is undefined", decodedMissingN === undefined);
    let encodedMissing: string = Lib.LibNote$toJson(decodedMissing);
    let redecodeMissing: Lib.LibNote | null = Lib.LibNote$fromJson(encodedMissing);
    require("roundtrip of missing is not null", redecodeMissing !== null);
    if (redecodeMissing !== null) {
      require("roundtrip missing hasOwn is false", !Object.hasOwn(redecodeMissing, "n"));
      require("roundtrip missing read is undefined", redecodeMissing.n === undefined);
    }
  }

  console.log("OK");
  return null;
}
