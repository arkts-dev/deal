// @spec: Runtime execution model — Nominal typing
// @description: A nominally refined unknown replaced by a closure with the first sibling's instance fails the second sibling's array element boundary with E8003, retaining both exact declaration atoms.
// @expected: runtime-error E8003
// @features: classes, arrays, modules, runtime-errors, nominal-identity

import * as a from "./same_name_sibling_a";
import * as b from "./same_name_sibling_b";

export function main(): null {
  let value: unknown = b.make();
  let replace: () => void = function(): void { value = a.make(); };
  if (value instanceof b.Item) {
    replace();
    let wrong: b.Item[] = [value];
  }
  return null;
}
