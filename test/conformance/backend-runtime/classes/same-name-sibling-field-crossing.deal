// @spec: Runtime execution model — Nominal typing
// @description: A nominally refined unknown replaced by a closure with the first sibling's instance fails at the second sibling's class-field assignment boundary, preserving E8001 and both exact declaration atoms.
// @expected: runtime-error E8001
// @features: classes, fields, modules, runtime-errors, nominal-identity

import * as a from "./same_name_sibling_a";
import * as b from "./same_name_sibling_b";

class Holder {
  item: b.Item;
}

export function main(): null {
  let value: unknown = b.make();
  let replace: () => void = function(): void { value = a.make(); };
  let h: Holder = {item: b.make()};
  if (value instanceof b.Item) {
    replace();
    h.item = value;
  }
  return null;
}
