// @spec: Classes — Construction
// @description: Separately provided array literals stay independent per instance
// @expected: runtime-ok
// @features: classes, arrays, construction

class Box {
  items: number[];
}

export function test_array_default_is_fresh(): null {
  let a: Box = {items: []};
  let b: Box = {items: []};
  a.items[0] = 7;
  if (b.items.length !== 0) {
    throw { code: "TEST_FAIL", message: "provided arrays were shared across instances" };
  }
  return null;
}

export function main(): null {
  return null;
}
