// @spec: Runtime execution model — Nominal typing
// @description: Checked extraction of the first sibling's Item as the second sibling's differently named Crate fails with E8001 and the actual declaration atom, independently from the same-name crossing.
// @expected: runtime-error E8001
// @features: classes, modules, runtime-errors, nominal-identity

import * as a from "./same_name_sibling_a";
import * as b from "./same_name_sibling_b";

export function main(): null {
  let t: Record<string, unknown> = { value: a.make() };
  let wrong: b.Crate = t.value as b.Crate;
  return null;
}
