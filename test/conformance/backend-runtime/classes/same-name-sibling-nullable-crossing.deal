// @spec: Runtime execution model — Nominal typing
// @description: Checked nullable extraction rejects the first sibling's instance as the second sibling's Item with E8001, retaining the actual declaration atom rather than admitting it as null.
// @expected: runtime-error E8001
// @features: classes, nullable, modules, runtime-errors, nominal-identity

import * as a from "./same_name_sibling_a";
import * as b from "./same_name_sibling_b";

export function main(): null {
  let t: Record<string, unknown> = { value: a.make() };
  let wrong: b.Item | null = t.value as b.Item | null;
  return null;
}
