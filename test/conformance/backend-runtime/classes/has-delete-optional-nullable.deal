// @spec: Classes — Presence and delete
// @description: Object.hasOwn and delete preserve missing versus explicit null state for optional fields
// @expected: runtime-ok
// @features: classes, has, delete, optional

class Item {
  tag?: string | null;
}

export function test_has_delete_optional_nullable(): null {
  let item: Item = { tag: null };
  if (!Object.hasOwn(item, "tag")) { throw { code: "TEST_FAIL", message: "tag should be present" }; }
  delete item.tag;
  if (Object.hasOwn(item, "tag")) { throw { code: "TEST_FAIL", message: "tag should be missing after delete" }; }
  if (item.tag !== undefined) { throw { code: "TEST_FAIL", message: "deleted read should be undefined" }; }
  item.tag = "ok";
  if (!Object.hasOwn(item, "tag")) { throw { code: "TEST_FAIL", message: "tag should be present after write" }; }
  return null;
}

export function main(): null {
  return null;
}
