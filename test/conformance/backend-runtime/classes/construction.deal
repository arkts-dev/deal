// @spec: Classes — Construction
// @description: Class construction with object literal works
// @expected: runtime-ok
// @features: classes, construction

class Address {
  city: string = "";
  zip: int = 0;
}

class User {
  name: string = "";
  home: Address = {};
}

export function test_construct(): string {
  let u: User = {
    name: "Ada",
    home: { city: "London", zip: 12345 },
  };
  if (u.name !== "Ada") {
    throw { code: "TEST_FAIL", message: "constructed User.name mismatch" };
  }
  if (u.home.city !== "London") {
    throw { code: "TEST_FAIL", message: "constructed User.home.city mismatch" };
  }
  if (u.home.zip !== 12345) {
    throw { code: "TEST_FAIL", message: "constructed User.home.zip mismatch" };
  }
  return u.name;
}

export function main(): null {
  return null;
}
