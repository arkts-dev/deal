// @spec: Runtime execution model — Nominal typing
// @description: Two same-directory sibling files export the class name Item; a value of the first declaration crossed through a dynamic table and read into the second declaration's typed local is refused with the runtime class-identity failure naming both exact declarations.
// @expected: runtime-error E8001
// @features: classes, modules, runtime-errors, nominal-identity

import * as a from "./same_name_sibling_a";
import * as b from "./same_name_sibling_b";

export function main(): null {
  let t: table = { value: a.make() };
  let wrong: b.Item = t.value;
  return null;
}
