// @spec: Classes — Default value isolation
// @description: Table defaults are fresh per class instance under nested writes
// @expected: runtime-ok
// @features: classes, defaults, tables

class Holder {
  data: table = {};
}

export function test_table_default_freshness_extended(): null {
  let a: Holder = {};
  let b: Holder = {};
  a.data.count = 9;
  let count: int | null = b.data.count;
  if (count !== null) { throw { code: "TEST_FAIL", message: "table default shared" }; }
  return null;
}

export function main(): null {
  return null;
}
