// @spec: Classes
// @description: A provided nested object literal receives its contextual nominal class identity.
// @expected: runtime-ok
// @features: classes, nested-classes, contextual-typing

class Address { zip: number; }
class User { home: Address; }

export function main(): null {
  let u: User = { home: {zip: 90210} };
  if (u.home.zip !== 90210) { throw { code: "TEST_FAIL", message: "provided nested value absent" }; }
  return null;
}
