// @spec: Runtime execution model — Function type identity
// @description: A same-named sibling declaration's function value crossed through a dynamic table into the other declaration's function type fails the exact function-signature check (E8010) because the class atoms inside the parameter and return descriptors name distinct declarations.
// @expected: runtime-error E8010
// @features: functions, classes, modules, runtime-errors, nominal-identity

import * as a from "./same_name_sibling_a";
import * as b from "./same_name_sibling_b";
import * as host from "host/signature_mutation";

export function main(): null {
  let source: (x: b.Item) => b.Item = function(x: b.Item): b.Item { return x; };
  if (!host.replaceSignature({value: source}, "(@conformance/backend-runtime/classes/same_name_sibling_a.deal/Item)->@conformance/backend-runtime/classes/same_name_sibling_a.deal/Item")) { throw {code: "TEST_FAIL", message: "signature mutation failed"}; }
  let wrong: (x: b.Item) => b.Item = source;
  return null;
}
