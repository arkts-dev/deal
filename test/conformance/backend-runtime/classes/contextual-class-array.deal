// @spec: Classes — Contextual construction
// @description: Class literals inside array contexts construct the contextual class element type (v1.2 defect snippets 14-18)
// @expected: runtime-ok
// @features: classes, arrays, contextual-typing

class Box { n: int = 0; }
class Container { children: Box[] = []; }

function take(a: Box[]): int { return a[0].n; }
function make(): Box[] { return [{ n: 2 }]; }

export function test_contextual_variable(): int {
  let a: Box[] = [{ n: 2 }, {}];
  if (a[0].n !== 2 || a[1].n !== 0) { throw {code: "TEST_FAIL", message: "contextual variable/default"}; }
  return a[0].n;
}

export function test_contextual_argument(): int {
  let result: int = take([{ n: 2 }]);
  if (result !== 2) { throw {code: "TEST_FAIL", message: "contextual argument"}; }
  return result;
}

export function test_contextual_return(): int {
  let a: Box[] = make();
  if (a[0].n !== 2) { throw {code: "TEST_FAIL", message: "contextual return"}; }
  return a[0].n;
}

export function test_contextual_field(): int {
  let c: Container = { children: [{ n: 2 }] };
  if (c.children[0].n !== 2) { throw {code: "TEST_FAIL", message: "contextual field"}; }
  return c.children[0].n;
}

export function test_nullable_construction(): int {
  let b: Box | null = { n: 2 };
  if (b === null) {
    throw {code: "TEST_FAIL", message: "contextual construction became null"};
  } else {
    if (b.n !== 2) { throw {code: "TEST_FAIL", message: "nullable contextual field"}; }
    return b.n;
  }
}

export function main(): null {
  return null;
}
