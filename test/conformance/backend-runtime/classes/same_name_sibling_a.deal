// @expected: companion
// @description: Classified support module — compiled by the companion
// catalog when a parent conformance fixture imports it. Exports the first
// of two same-directory sibling declarations of the class name Item: its
// canonical class identity names this defining file, so an instance of it
// never passes the other sibling's typed boundary.
export class Item {
  value: number;
}

export class Payload {
  label: string;
  item: Item;
}

export class KeyOrder { z:number; a:number; }
export function ordered():KeyOrder { return {a:2,z:1}; }

export function make(): Item {
  return { value: 1 };
}

export function makePayload(): Payload {
  return { label: "a", item: { value: 1 } };
}

export function read(item: Item): number {
  return item.value;
}

export function identity(item: Item): Item {
  return item;
}

export function wrapAll(items: Item[]): Item[] {
  return items;
}

export function maybeIdentity(item: Item | null): Item | null {
  return item;
}

export function payloadJson(): string {
  let p: Payload = { label: "a", item: { value: 1 } };
  return JSON.stringify(p) as string;
}

export function payloadRoundTrip(): number {
  let p: Payload | null = JSON.parse(payloadJson());
  if (p !== null) {
    return read(p.item);
  }
  return -1;
}

export function itemJson(item: Item): string {
  return JSON.stringify(item) as string;
}

export function itemRoundTrip(value: number): number {
  let restored: Item | null = JSON.parse(itemJson({ value: value }));
  if (restored !== null) {
    return read(restored);
  }
  return -1;
}
