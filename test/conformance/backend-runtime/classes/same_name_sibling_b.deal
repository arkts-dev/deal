// @expected: companion
// @description: Classified support module — compiled by the companion
// catalog when a parent conformance fixture imports it. Exports the second
// of two same-directory sibling declarations of the class name Item: it is
// a distinct declaration with its own canonical identity, layout and
// runtime tag.
// @jsonable
export class Item {
  value: int = 2;
}

export class Crate {
  value: int = 3;
}

// @jsonable
export class Payload {
  label: string = "b";
  item: Item = {};
}

export function make(): Item {
  return { value: 2 };
}

export function makePayload(): Payload {
  return { label: "b", item: { value: 2 } };
}

export function read(item: Item): int {
  return item.value;
}

export function identity(item: Item): Item {
  return item;
}

export function wrapAll(items: Item[]): Item[] {
  return items;
}

export function maybeIdentity(item: Item | null): Item | null {
  return item;
}

export function payloadJson(): string {
  let p: Payload = { label: "b", item: { value: 2 } };
  return Payload$toJson(p);
}

export function payloadRoundTrip(): int {
  let p: Payload | null = Payload$fromJson(payloadJson());
  if (p !== null) {
    return read(p.item);
  }
  return -1;
}

export function itemJson(item: Item): string {
  return Item$toJson(item);
}

export function itemRoundTrip(value: int): int {
  let restored: Item | null = Item$fromJson(itemJson({ value: value }));
  if (restored !== null) {
    return read(restored);
  }
  return -1;
}
