// @spec: Classes — Construction
// @description: Separately provided table literals stay independent per instance
// @expected: runtime-ok
// @features: classes, tables, construction

class Box {
  data: Record<string, unknown>;
}

export function test_table_default_is_fresh(): null {
  let a: Box = {data: {}};
  let b: Box = {data: {}};
  a.data.x = 7;
  let bx: unknown = b.data.x;
  if (bx !== undefined || Object.hasOwn(b.data, "x")) {
    throw { code: "TEST_FAIL", message: "provided tables were shared across instances" };
  }
  return null;
}

export function main(): null {
  return null;
}
