// @spec: Classes
// @description: Provided function calls execute independently for each construction
// @expected: runtime-ok
// @features: classes, construction, function-calls

function freshValues(): number[] {
  return [];
}

class Counter {
  values: number[];
}

export function main(): null {
  let first: Counter = {values: freshValues()};
  let second: Counter = {values: freshValues()};
  first.values[0] = 41;
  if (second.values.length !== 0) { throw { code: "TEST_FAIL", message: "provided function call was cached" }; }
  return null;
}
