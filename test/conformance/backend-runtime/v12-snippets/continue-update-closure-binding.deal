// @spec: Runtime execution model
// @description: Corner-case subject continue-update-closure-binding — Effectful update runs on continue without changing any previously captured iteration cell. (basis: Closures: fresh iteration binding; C-style for; Break / Continue)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let fs: (() => number)[] = []; let updates: number = 0;
 function next(x: number): number {updates = updates + 1; return x + 1;}
 { let v14Loop0: number = 0; while (v14Loop0 < 3) { let i: number = v14Loop0; {
  fs[fs.length] = function(): number {return i;};
  if(i === 1) {{ v14Loop0 = i; v14Loop0 = next(v14Loop0); continue; }}
 } v14Loop0 = i; v14Loop0 = next(v14Loop0); } }
 if(updates !== 3 || fs.length !== 3 || fs[0]() !== 0 || fs[1]() !== 1 || fs[2]() !== 2) {throw {code:"TEST_FAIL",message:"update mutated captured iteration"};}
 c.log("continue-update-closure-binding"); return null;
}
