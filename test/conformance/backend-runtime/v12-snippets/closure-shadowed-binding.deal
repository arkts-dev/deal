// @spec: Runtime execution model
// @description: Corner-case subject closure-shadowed-binding — Escaped same-name inner and outer bindings remain separate mutable cells. (basis: Scope; Closures and captured variables)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let x: int = 1; let outer: () => int = function(): int {return x;};
 let inner: () => int = function(): int {return -1;};
 { let x: int = 10; inner = function(): int {x = x + 1; return x;}; }
 x = 2;
 let a:int=inner(); let b:int=outer(); let d:int=inner();
 if(a!==11) {throw {code:"INNER_FIRST",message:"shadowed inner first value"};}
 if(b!==2) {throw {code:"OUTER_VALUE",message:"shadowed outer closure"};}
 if(d!==12) {throw {code:"INNER_SECOND",message:"shadowed inner second value"};}
 if(x!==2) {throw {code:"OUTER_STORAGE",message:"shadowed outer storage"};}
 c.log("closure-shadowed-binding"); return null;
}
