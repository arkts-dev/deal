// @spec: Lexical elements — Operators
// @description: Exponentiation is unsupported; diagnose each complete '**' operator at admission (E1042). The v1.2 power-associativity/unary-grouping subject is retained as a rejection control.
// @expected: compile-error E1042
// @features: parser, operators, diagnostics, v1.2

import * as c from "std/console";
export function main(): void {
 if(2 ** 3 ** 2 !== 512 || -2 ** 2 !== 4 || -(2 ** 2) !== -4 || 20 / 3 / 2 !== 3) {throw {message:"operator grouping"};}
 c.log("power-associativity-unary"); return ;
}
