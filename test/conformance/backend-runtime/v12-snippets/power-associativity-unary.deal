// @spec: Lexical elements — Operators
// @description: The v1.3 operator set has no exponentiation: each '**' lexes as two '*' operators and the second one has no operand, so the removed-operator subject is rejected at admission (E1037). The v1.2 power-associativity/unary-grouping subject is retained as a rejection control.
// @expected: compile-error E1037
// @features: parser, operators, diagnostics, v1.2

import * as c from "std/console";
export function main(): null {
 if(2 ** 3 ** 2 !== 512 || -2 ** 2 !== 4 || -(2 ** 2) !== -4 || 20 / 3 / 2 !== 3) {throw {message:"operator grouping"};}
 c.log("power-associativity-unary"); return null;
}
