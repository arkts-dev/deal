// @spec: Runtime execution model
// @description: Corner-case subject typed-array-failure-state — Bad dynamic replacement AND append preserve previous element and length. (basis: Typed boundaries: array element assignment; Array writes)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let xs: int[] = [7]; let alias: int[] = xs; let t: table = {bad:"not-int"}; let count: int = 0;
 try {xs[0] = t.bad;} catch(e) {count = count + 1;}
 try {xs[xs.length] = t.bad;} catch(e) {count = count + 1;}
 if(count !== 2 || alias.length !== 1 || alias[0] !== 7) {throw {message:"failed element checks mutated storage"};}
 c.log("typed-array-failure-state"); return null;
}
