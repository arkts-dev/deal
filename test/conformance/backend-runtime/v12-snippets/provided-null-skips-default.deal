// @spec: Runtime execution model
// @description: Corner-case subject provided-null-skips-default — Provided null is not omission: no default call permitted. (basis: Construction: omitted defaults; required-present nullable field)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
function fallback(): string | null {c.log("forbidden-default"); return "fallback";}
class C {value: string | null = fallback();}
export function main(): null {
 let x: C = {value:null}; if(x.value !== null) {throw {message:"null treated as omitted"};}
 c.log("provided-null-skips-default"); return null;
}
