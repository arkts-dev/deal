// @spec: Runtime execution model
// @description: Corner-case subject unicode-single-scalar-slice — Supplementary scalar followed by combining scalar, retained in iteration closures. (basis: std/string scalar lengths/positions; for-of scalar fresh binding)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
import * as s from "std/string";
export function main(): null {
 let text:string="A😀́Z";
 if(s.length(text)!==4 || s.substring(text,1,2)!=="😀" || s.substring(text,2,3)!=="́") {throw {code:"SCALAR_SLICE",message:"scalar slice units"};}
 let count:number=0; let fs:(()=>string)[]=[];
 for(let ch:string of text) {count=count+1; fs[fs.length]=function(): string {return ch;};}
 if(count!==4 || fs[0]()!=="A" || fs[1]()!=="😀" || fs[2]()!=="́" || fs[3]()!=="Z") {throw {code:"SCALAR_CLOSURES",message:"scalar closure cells"};}
 c.log("unicode-single-scalar-slice"); return null;
}
