// @spec: Type system
// @description: Binary64 literals and copied number values preserve negative zero through reciprocal arithmetic.
// @expected: runtime-ok
// @features: v1.4, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let nz: number = -0.0; let pz: number = 0.0; let one: number = 1.0;
 if(nz !== pz || !(one / nz < 0.0) || !(one / pz > 0.0)) {throw {code:"NUMBER_ZERO_SIGN",message:"number signed zero lost"};}
 let iz: number = nz; let uz: number = -0;
 if(iz !== 0 || uz !== 0 || !(one / iz < 0.0) || !(one / uz < 0.0)) {throw {code:"NUMBER_COPY_SIGN",message:"copied or literal negative zero lost"};}
 c.log("negative-zero-domains"); return null;
}
