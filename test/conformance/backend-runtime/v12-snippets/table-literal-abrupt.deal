// @spec: Runtime execution model
// @description: Corner-case subject table-literal-abrupt — Abrupt element/property evaluation suppresses every later expression. (basis: Operational semantics summary: strict left-to-right; table rule 7)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let trace: string = "";
 let mark = function(s: string): number {trace = trace + s; return 1;};
 let fail = function(): number {trace = trace + "B"; throw {name:"STOP",message:"literal"};};
 try {let v: Record<string, unknown> = {a:mark("A"), b:fail(), z:mark("X")}; trace = trace + "Y";} catch(e) {
  if((e as Error).name !== "STOP") {throw {name:"TEST_FAIL",message:"wrong name"};} trace = trace + "C";
 }
 if(trace !== "ABC") {throw {name:"TEST_FAIL",message:"literal order: " + trace};}
 c.log("table-literal-abrupt"); return null;
}
