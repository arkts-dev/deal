// @spec: Runtime execution model
// @description: Corner-case subject catch-inner-throw-nearest — Throw a different error from inner catch; it must not be re-caught by the same handler. (basis: Throw transfers nearest enclosing catch, catch block outside its own try)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let trace:string="";
 try {
  try {trace=trace+"A"; throw {name:"FIRST",message:"one"};} catch(value) { let e: Error = value as Error;
   if(e.name!=="FIRST") {throw {name:"TEST_FAIL",message:"wrong inner"};} trace=trace+"B"; throw {name:"SECOND",message:"two"};
  }
  trace=trace+"X";
 } catch(value) {let e: Error = value as Error; if(e.name!=="SECOND" || e.message!=="two") {throw {name:"TEST_FAIL",message:"wrong outer"};} trace=trace+"C";}
 if(trace!=="ABC") {throw {name:"TEST_FAIL",message:"catch recursively handled own throw"};}
 c.log("catch-inner-throw-nearest"); return null;
}
