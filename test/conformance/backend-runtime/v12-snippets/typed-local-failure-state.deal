// @spec: Runtime execution model
// @description: Corner-case subject typed-local-failure-state — Rejected contextual dynamic read must not overwrite existing typed local. (basis: Typed boundaries: assignment; Assignment type checking)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let x: number = 7; let t: table = {bad:"not-int"}; let caught: boolean = false;
 try {x = t.bad;} catch(e) {if(e.code !== "E8001") {throw {message:"wrong type code"};} caught = true;}
 if(!caught || x !== 7) {throw {message:"failed assignment overwrote old local"};}
 c.log("typed-local-failure-state"); return null;
}
