// @spec: Runtime execution model
// @description: Corner-case subject ignored-argument-abrupt — Throwing ignored argument suppresses later arguments and source callee. (basis: Function type compatibility; strict left-to-right evaluation)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
export function main(): null {
 let trace: string = "";
 function small(x: number): number { trace = trace + "F"; return x; }
 function first(): number {trace = trace + "A"; return 1;}
 function fail(): number {trace = trace + "B"; throw {code:"STOP",message:"ignored"};}
 function last(): number {trace = trace + "X"; return 3;}
 let extended: (x: number, y: number, z: number) => number = small;
 try {let r: number = extended(first(), fail(), last()); trace = trace + "Y";} catch(e) {
  if(e.code !== "STOP" || e.message !== "ignored") {throw {code:"TEST_FAIL",message:"wrong error"};} trace = trace + "C";
 }
 if(trace !== "ABC") {throw {code:"TEST_FAIL",message:"abrupt ignored arg: " + trace};}
 c.log("ignored-argument-abrupt"); return null;
}
