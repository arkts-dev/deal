// @spec: Runtime execution model
// @description: Corner-case subject optional-nullable-delete-reassign — Deletion followed by explicit-null reintroduction through alias then non-null value. (basis: Class assignment references; optional nullable presence)
// @expected: runtime-ok
// @features: v1.2, runtime, corner-case

import * as c from "std/console";
class C {value?: number | null;}
export function main(): null {
 let x:C={value:null}; let alias:C=x;
 if(!Object.hasOwn(alias, "value")) {throw {code:"TEST_FAIL",message:"explicit null absent"};}
 delete x.value; if(Object.hasOwn(alias, "value") || alias.value !== undefined) {throw {code:"TEST_FAIL",message:"deletion not shared"};}
 alias.value=null; if(!Object.hasOwn(x, "value")) {throw {code:"TEST_FAIL",message:"null assignment erased presence"};}
 let n:number | null | undefined=x.value; if(n!==null) {throw {code:"TEST_FAIL",message:"null read"};}
 x.value=4; let m:number | null | undefined=alias.value; if(m!==null) {if((m as number)!==4) {throw {code:"TEST_FAIL",message:"value"};}} else {throw {code:"TEST_FAIL",message:"value absent"};}
 c.log("optional-nullable-delete-reassign"); return null;
}
