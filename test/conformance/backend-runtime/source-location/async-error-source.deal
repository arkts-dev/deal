// @spec: Runtime execution model — Source locations for async errors
// @description: Error thrown through awaited async call preserves explicit error code
// @expected: runtime-error ASYNC_SOURCE_FAIL
// @features: source-location, async, runtime-errors

async function failAsync(): int {
  throw { code: "ASYNC_SOURCE_FAIL", message: "async source fail" };
}

export async function test_source_location_async_error(): int {
  return await failAsync();
}
