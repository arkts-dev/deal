// @spec: Runtime execution model — Source locations for integer arithmetic errors
// @description: Unary int negation reports E8004 at the negating expression's own source location (v1.2)
// @expected: runtime-error E8004
// @features: source-location, runtime, int, overflow, v1.2

export function test_source_location_int_neg(): int {
  let min: int = -2147483648;
  let flipped: int = -min;
  return flipped;
}

export function main(): null {
  return null;
}
