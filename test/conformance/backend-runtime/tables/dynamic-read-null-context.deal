// @spec: Tables — Reading table fields
// @description: A present-null table field read crosses the null target context unchanged (v1.2 defect snippets 03 and 04)
// @expected: runtime-ok
// @features: tables, dynamic-read, contextual-target, null

function takeNull(x: null): boolean { return x === null; }

export function test_table_read_null_target(): boolean {
  let t: table = { x: null };
  let n: null = t.x;
  return takeNull(n);
}

export function test_table_read_null_argument(): boolean {
  let t: table = { x: null };
  return takeNull(t.x);
}

export function main(): null {
  return null;
}
