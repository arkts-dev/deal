// @spec: Standard library builtins — Key enumeration does not consume field values
// @expected: runtime-ok
// @features: host-abi
import * as host from "host/probe";
class Item {x:number;stable:number;}
function keys(xs:string[]):string {let text="";for(const name of xs){text=text+name+"|";}return text;}
function check(ok:boolean):void{if(!ok){throw {code:"KEYS",message:"presence-only snapshot"};}}
export function main():null {
  const item:Item={stable:4,x:9};const record:Record<string,unknown>={child:item};
  record.self=record;
  host.damage(item,false);
  check(keys(Object.keys(item))==="x|stable|");
  check(keys(Object.keys(record))==="child|self|");
  host.damage(null,true);check(item.x===9 && item.stable===4);
  const fn=():number=>9;const callables:Record<string,unknown>={f:fn};
  host.poison(fn);check(keys(Object.keys(callables))==="f|");host.restoreFunction();check(fn()===9);
  host.poisonSignature(fn);check(keys(Object.keys(callables))==="f|");host.restoreFunction();check(fn()===9);
  let effects="";const fail=():Record<string,unknown>=>{effects=effects+"!";throw {code:"STOP",message:"stop"};};
  let caught=false;try{Object.keys(fail());}catch(e){caught=(e as Error).code==="STOP";}
  check(caught && effects==="!");
  return null;
}
