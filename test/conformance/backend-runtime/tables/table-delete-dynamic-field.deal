// @spec: Tables — Delete and dynamic field presence
// @description: Deleting a table field makes subsequent nullable reads observe missing/null
// @expected: runtime-ok
// @features: tables, delete, nullable

export function test_table_delete_dynamic_field(): null {
  let t: table = { value: 4 };
  delete t.value;
  let v: int | null = t.value;
  if (v !== null) { throw { code: "TEST_FAIL", message: "deleted table field still present" }; }
  return null;
}

export function main(): null {
  return null;
}
