// @spec: Tables — Reading table fields
// @description: A Record field read remains unknown until an explicit checked assertion
// @expected: runtime-ok
// @features: tables, dynamic-read

export function test_table_read(): number {
  let t: Record<string, unknown> = { x: 42 };
  let v: number = t.x as number;
  if (v !== 42) {
    throw { code: "TEST_FAIL", message: "checked number read mismatch" };
  }
  return v;
}

export function main(): null {
  return null;
}
