// @spec: Tables — Reading table fields
// @description: Table field read with target type is allowed
// @expected: runtime-ok
// @features: tables, dynamic-read

export function test_table_read(): number {
  let t: table = { x: 42 };
  let v: number = t.x; // OK: contextual target type
  if (v !== 42) {
    throw { code: "TEST_FAIL", message: "contextual int read mismatch" };
  }
  return v;
}

export function main(): null {
  return null;
}
