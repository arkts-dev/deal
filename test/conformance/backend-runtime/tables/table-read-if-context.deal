// @spec: Tables
// @description: A Record field read is explicitly checked as boolean in an if condition.
// @expected: runtime-ok
// @features: tables, conditions, contextual-typing

export function main(): null {
  let t: Record<string, unknown> = { enabled: true };
  if (t.enabled as boolean) { return null; }
  throw { code: "TEST_FAIL", message: "boolean table field was false" };
}
