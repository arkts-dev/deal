// @spec: Error handling — try / catch; Nullable semantics
// @description: Catch unknown is a fresh lexical binding; explicit Error checks preserve same-named outer nullish refinements, nested catch identity, assignment isolation and parameter shadowing
// @expected: runtime-ok
// @features: error-handling, try-catch, nullable, narrowing, shadowing, blocks, parameters

import * as console from "std/console";

function expectTrue(what: string, condition: boolean): void {
  if (!condition) { throw { code: "CHECK_FAIL", message: what }; }
}
function expectError(what: string, value: Error): void {
  expectTrue(what, value.code !== "");
}

function checkIntRefinement(): void {
  let e: number | null = 41;
  if (e !== null) {
    try { throw { code: "C_INT", message: "number refinement" }; }
    catch (e) {
      let captured: Error = e as Error;
      expectError("the number-refined catch binding", captured);
      expectTrue("the number-refined catch message", captured.message === "number refinement");
    }
    let afterCatch: number = e;
    expectTrue("the outer refinement after the catch", afterCatch === 41);
  }
}
function checkStringRefinement(): void {
  let e: string | null = "outer";
  if (e !== null) {
    try { throw { code: "C_STR", message: "string refinement" }; }
    catch (e) {
      if (e instanceof Error) {
        expectError("the string-refined catch binding", e);
        expectTrue("the string-refined catch message", e.message === "string refinement");
      } else { throw {code: "CHECK_FAIL", message: "catch is Error"}; }
    }
    let afterCatch: string = e;
    expectTrue("the outer string refinement after the catch", afterCatch === "outer");
  }
}
function checkNullRefinement(): void {
  let e: number | null = null;
  if (e === null) {
    try { throw { code: "C_NULL", message: "null refinement" }; }
    catch (e) {
      let captured: Error = e as Error;
      expectError("the null-refined catch binding", captured);
      expectTrue("the null-refined catch message", captured.message === "null refinement");
    }
    let afterCatch: null = e;
    expectTrue("the outer null refinement", afterCatch === null);
  }
}
function checkNestedCatch(): void {
  let e: number | null = 7;
  if (e !== null) {
    try { throw { code: "C_OUTER", message: "outer" }; }
    catch (e) {
      if (e instanceof Error) {
        try { throw { code: "C_INNER", message: "inner" }; }
        catch (e) {
          let captured: Error = e as Error;
          expectTrue("the inner catch binding", captured.message === "inner");
        }
        expectTrue("the outer catch binding after the inner catch", e.message === "outer");
      } else { throw { code: "CHECK_FAIL", message: "outer catch is Error" }; }
    }
    let afterCatch: number = e;
    expectTrue("the outer refinement after a nested catch", afterCatch === 7);
  }
}
function checkNestedBlock(): void {
  let e: number | null = 9;
  if (e !== null) {
    try { throw { code: "C_BLOCK", message: "block" }; }
    catch (e) {
      {
        let captured: Error = e as Error;
        expectError("the catch binding inside a nested block", captured);
        expectTrue("the nested block message", captured.message === "block");
      }
      let capturedAfter: Error = e as Error;
      expectError("the catch binding after a nested block", capturedAfter);
    }
    let afterCatch: number = e;
    expectTrue("the outer refinement after a nested block", afterCatch === 9);
  }
}
function checkRenamedCatch(): void {
  let e: number | null = 11;
  if (e !== null) {
    try { throw { code: "C_RENAMED", message: "renamed" }; }
    catch (err) {
      let captured: Error = err as Error;
      expectTrue("the renamed catch binding", captured.message === "renamed");
      let refined: number = e;
      expectTrue("the outer refinement inside the renamed catch", refined === 11);
    }
    let afterCatch: number = e;
    expectTrue("the outer refinement after a renamed catch", afterCatch === 11);
  }
}
function checkNoRefinement(): void {
  let e: number | null = null;
  try { throw { code: "C_NONE", message: "no refinement" }; }
  catch (e) {
    let captured: Error = e as Error;
    expectError("the unrefined catch binding", captured);
    expectTrue("the unrefined catch message", captured.message === "no refinement");
  }
  expectTrue("the outer unrefined binding", e === null);
}
function checkCatchAssignment(): void {
  let e: number | null = 13;
  if (e !== null) {
    try { throw { code: "C_ASSIGN", message: "assign" }; }
    catch (e) {
      let replacement: Error = { code: "C_REPLACED", message: "replaced" };
      e = replacement;
      let captured: Error = e as Error;
      expectTrue("the reassigned catch binding", captured.message === "replaced");
      expectTrue("the replacement identity", captured === replacement);
    }
    let afterCatch: number = e;
    expectTrue("the outer refinement after a catch assignment", afterCatch === 13);
  }
}
function checkNestedTryCatchAssignment(): void {
  let e: number | null = 19;
  if (e !== null) {
    try {
      try { throw { code: "C_NESTED_INNER", message: "nested inner" }; }
      catch (e) {
        let replacement: Error = { code: "C_NESTED_REPLACED", message: "nested replaced" };
        e = replacement;
        let captured: Error = e as Error;
        expectTrue("the reassigned nested catch binding", captured.message === "nested replaced");
      }
      let afterInner: number = e;
      expectTrue("the outer refinement after the nested catch", afterInner === 19);
    } catch (outer) { throw outer as Error; }
    let afterOuter: number = e;
    expectTrue("the outer refinement after the outer catch", afterOuter === 19);
  }
}
function checkParameterBinding(e: number | null): void {
  if (e !== null) {
    try { throw { code: "C_PARAM", message: "parameter" }; }
    catch (e) {
      let captured: Error = e as Error;
      expectError("the parameter-shadowing catch binding", captured);
      expectTrue("the parameter-shadowing catch message", captured.message === "parameter");
    }
    let afterCatch: number = e;
    expectTrue("the parameter refinement after the catch", afterCatch === 17);
  }
}
export function main(): null {
  checkIntRefinement();
  checkStringRefinement();
  checkNullRefinement();
  checkNestedCatch();
  checkNestedBlock();
  checkRenamedCatch();
  checkNoRefinement();
  checkCatchAssignment();
  checkNestedTryCatchAssignment();
  checkParameterBinding(17);
  console.log("OK");
  return null;
}
