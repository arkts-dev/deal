// @spec: Error handling — throw
// @description: throw with Error type works
// @expected: runtime-ok
// @features: error-handling, throw

export function test_throw(): string {
  let catchRan: boolean = false;
  let caughtCode: string = "";
  try {
    throw { name: "E_TEST", message: "test error" };
  } catch (e) {
    catchRan = true;
    caughtCode = (e as Error).name;
  }
  if (catchRan !== true) {
    throw { name: "TEST_FAIL", message: "expected throw did not reach its catch" };
  }
  if (caughtCode !== "E_TEST") {
    throw { name: "TEST_FAIL", message: "thrown Error name mismatch" };
  }
  return "E_TEST";
}

export function main(): void {
  return ;
}
