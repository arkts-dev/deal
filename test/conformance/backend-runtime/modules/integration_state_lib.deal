// @expected: companion
// @spec: Modules, declarations, standard library, and host ABI — Module values and typed boundaries
// @description: Companion for cross-module class, function, and table integration

export class Counter {
  value: number = 0;
}

export function makeCounter(start: number): Counter {
  return { value: start };
}

export function makeStep(counter: Counter, audit: table): () => number {
  return function(): number {
    counter.value = counter.value + 1;
    let calls: number = audit.calls;
    audit.calls = calls + 1;
    return counter.value;
  };
}
