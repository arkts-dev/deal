// @spec: Modules — Runtime initialization order
// @description: Imported module top-level initialization happens before exported function use
// @expected: runtime-ok
// @features: modules, initialization

import * as Lib from "./init_order_lib"

export function test_module_initialization_order(): int {
  let result: int = Lib.second();
  if (result !== 2) { throw { code: "TEST_FAIL", message: "module initialization order failed" }; }
  return result;
}

export function main(): null {
  return null;
}
