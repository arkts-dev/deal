// @spec: Runtime execution model — Module-qualified class identity
// @description: A nominally refined unknown replaced by a closure with the other module's Point fails the defining parameter boundary with E8001, preserving the exact foreign and expected identities.
// @expected: runtime-error E8001
// @features: modules, classes, runtime-errors

import * as LibA from "./modid_lib_a/lib_a";
import * as LibB from "./modid_lib_b/lib_b";

export function test_cross_module_class_identity(): number {
  let seed: LibB.Point = {x: 7};
  let item: unknown = seed;
  let replace: () => void = function(): void { item = LibA.make(5); };
  if (item instanceof LibB.Point) {
    replace();
    return LibB.needBox(item);
  }
  throw { code: "TEST_FAIL", message: "nominal refinement branch skipped" };
}

export function main(): null {
  return null;
}
