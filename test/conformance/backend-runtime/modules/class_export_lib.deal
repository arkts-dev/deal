// @expected: companion
// @description: Classified support module — compiled by the companion
// catalog when a parent conformance fixture imports it. The v1.2 gate
// (ISSUE-0107) removes unclassified skips: every .deal file carries an
// explicit classification, and companions must keep compiling standalone.
export class Point {
  x: int = 0;
  y: int = 0;
}

export function make(x: int, y: int): Point {
  return { x: x, y: y };
}
