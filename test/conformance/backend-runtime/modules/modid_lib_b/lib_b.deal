// @expected: companion
// @description: Classified support module — compiled by the companion
// catalog when a parent conformance fixture imports it. The v1.2 gate
// (ISSUE-0107) removes unclassified skips: every .deal file carries an
// explicit classification, and companions must keep compiling standalone.
// Companion module B for the modid-class-identity conformance tests. The
// same-name class Point carries a different module-qualified identity;
// instances of A's Point must fail B's check with E8001 (exact descriptor
// compare — no bare-name conflation).

export class Point {
  x: int = 0;
}

export function needBox(p: Point): int {
  return p.x;
}
