// @spec: Modules, declarations, standard library, and host ABI — Imported recursive callback
// @description: An imported recursive function can be passed as a callback and executed
// @expected: runtime-ok
// @features: modules, recursion, callbacks

import * as Lib from "./module_extra_lib";

function call(f: (n: number) => number, n: number): number { return f(n); }

export function test_imported_recursive_callback(): number {
  let result: number = call(Lib.recursiveCountdown, 4);
  if (result !== 4) { throw { code: "TEST_FAIL", message: "imported recursive callback failed" }; }
  return result;
}

export function main(): null {
  return null;
}
