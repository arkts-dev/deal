// @spec: Lexical elements — Template literals — Brace scanning
// @description: The '}' inside a string literal within ${} must not close the interpolation
// @expected: runtime-ok
// @features: template-literal, brace-scanning

export function test_rbrace(): string {
  let result: string = `${ "}" }`;
  if (result !== "}") {
    throw { code: "TEST_FAIL", message: "template literal brace scanning produced wrong byte string" };
  }
  return result;
}
