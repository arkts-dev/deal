// @spec: Lexical elements — Template literals — Nested expressions
// @description: Template literal inside a for-of loop body, and inside a function call argument
// @expected: runtime-ok
// @features: template-literal, for-of

function greet(name: string): string {
  return `Hi, ${name}`;
}

export function test_forof_template(): string {
  let names: string[] = ["Alice", "Bob"];
  let result: string = "";
  for (let n: string of names) {
    result = result + `[${n}]`;
  }
  if (result !== "[Alice][Bob]") {
    throw { code: "TEST_FAIL", message: "for-of template concatenation result mismatch" };
  }
  return result;
}

export function test_call_template(): string {
  let result: string = greet(`World`);
  if (result !== "Hi, World") {
    throw { code: "TEST_FAIL", message: "template inside call argument result mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
