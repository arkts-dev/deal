// @spec: Lexical elements — Template literals — Escape decoding
// @description: Paired backslashes decode once at the closing backtick, before interpolation and in nested templates.
// @expected: runtime-ok
// @features: template-literal, trailing-backslash, runtime

export function test_closing_run(): null {
  let text: string = `a\\`;
  if (text !== "a\\") {
    throw { code: "TEST_FAIL", message: "closing run must decode once" };
  }
  return null;
}

export function test_interpolation_boundary(): null {
  let name: string = "N";
  let text: string = `Hello \\${name}`;
  if (text !== "Hello \\N") {
    throw { code: "TEST_FAIL", message: "run before interpolation must decode once" };
  }
  return null;
}

export function test_nested_run(): null {
  let text: string = `[${ `in\\` }]`;
  if (text !== "[in\\]") {
    throw { code: "TEST_FAIL", message: "nested run must decode once" };
  }
  return null;
}

export function main(): null {
  return null;
}
