// @spec: Lexical elements — Template literals — Basic interpolation
// @description: Template literal with identifier interpolation produces correct string
// @expected: runtime-ok
// @features: template-literal

export function test_greet(): string {
  let name: string = "World";
  let result: string = `Hello, ${name}!`;
  if (result !== "Hello, World!") {
    throw { code: "TEST_FAIL", message: "template basic interpolation produced wrong byte string" };
  }
  return result;
}

export function main(): null {
  return null;
}
