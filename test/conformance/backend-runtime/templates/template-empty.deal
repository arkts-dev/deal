// @spec: Lexical elements — Template literals — Empty template
// @description: An empty template literal (``) produces an empty string
// @expected: runtime-ok
// @features: template-literal

export function test_empty(): string {
  let s: string = ``;
  if (s !== "") {
    throw { code: "TEST_FAIL", message: "empty template literal did not produce an empty string" };
  }
  return s;
}
