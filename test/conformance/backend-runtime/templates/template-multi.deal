// @spec: Lexical elements — Template literals — Multiple interpolations
// @description: Template literal with several interpolations concatenates in order
// @expected: runtime-ok
// @features: template-literal

export function test_multi(): string {
  let a: string = "Alice";
  let b: string = "Bob";
  let result: string = `Hello, ${a}! You have ${b} as a friend.`;
  if (result !== "Hello, Alice! You have Bob as a friend.") {
    throw { code: "TEST_FAIL", message: "template multiple interpolations produced wrong byte string" };
  }
  return result;
}

export function main(): null {
  return null;
}
