// @spec: Modules, declarations, standard library, and host ABI — Shared module instance
// @description: Two imports of one module share one initialized module instance
// @expected: runtime-ok
// @features: modules, initialization, mutation

import * as A from "./shared_state_lib"
import * as B from "./shared_state_lib"

export function test_double_import_shared_state(): int {
  let a: int = A.next();
  let b: int = B.next();
  if (a !== 1 || b !== 2) { throw { code: "TEST_FAIL", message: "double import did not share state" }; }
  return b;
}

export function main(): null {
  return null;
}
