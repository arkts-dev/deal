// @spec: Classes — @jsonable optional nullable nested class
// @description: Optional nullable nested class fields preserve explicit null and value states
// @expected: runtime-ok
// @features: jsonable, optional, nullable, nested

import * as Lib from "./jsonable_batch2_lib"

export function test_jsonable_optional_nullable_nested_class(): null {
  let explicitNull: Lib.MaybeChild | null = Lib.MaybeChild$fromJson("{\"child\":null}");
  if (explicitNull !== null) {
    if (explicitNull.child !== null) { throw { code: "TEST_FAIL", message: "explicit null child mismatch" }; }
  } else {
    throw { code: "TEST_FAIL", message: "explicit null fromJson failed" };
  }

  let value: Lib.MaybeChild | null = Lib.MaybeChild$fromJson("{\"child\":{\"value\":8}}");
  if (value !== null) {
    if (value.child !== null) {
      if (value.child.value !== 8) { throw { code: "TEST_FAIL", message: "nested value mismatch" }; }
      return null;
    }
  }
  throw { code: "TEST_FAIL", message: "nested value fromJson failed" };
}

export function main(): null {
  return null;
}
