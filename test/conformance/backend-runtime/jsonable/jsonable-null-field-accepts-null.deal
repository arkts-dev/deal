// @spec: Standard library builtins — JSON decoding
// @description: Contextual decoding accepts explicit JSON null for a required null-typed field and retains presence.
// @expected: runtime-ok
// @features: json, null, classes

export class Marker { value: null; }

export function main(): null {
  let m: Marker = JSON.parse("{\"value\":null}");
  if (m.value !== null || !Object.hasOwn(m, "value") || !(m instanceof Marker)) {
    throw {code: "TEST_FAIL", message: "null field or nominal identity lost"};
  }
  return null;
}
