// @spec: Standard library builtins — JSON
// @description: Imported aggregate class declarations provide exact contextual JSON reconstruction
// @expected: runtime-ok
// @features: jsonable, modules, lua-abi

import * as Lib from "./jsonable_complex_lib";

export function test_jsonable_helper_exports(): null {
  let u: Lib.User | null = JSON.parse("{\"name\":\"Grace\",\"addresses\":[],\"meta\":{}}");
  if (u !== null) {
    let encoded: string = JSON.stringify(u) as string;
    let u2: Lib.User | null = JSON.parse(encoded);
    if (u2 === null) { throw { code: "TEST_FAIL", message: "helper export toJson failed" }; }
    return null;
  }
  throw { code: "TEST_FAIL", message: "helper export fromJson failed" };
}

export function main(): null {
  return null;
}
