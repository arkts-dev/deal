// @expected: companion
// @description: Classified support module — compiled by the companion
// catalog when a parent conformance fixture imports it. The v1.2 gate
// (ISSUE-0107) removes unclassified skips: every .deal file carries an
// explicit classification, and companions must keep compiling standalone.
// @jsonable
export class Child {
  value: int = 0;
}

// @jsonable
export class Parent {
  children: Child[] = [];
}

// @jsonable
export class MaybeChild {
  child?: Child | null;
}

// @jsonable
export class TableWrap {
  data: table = {};
}

export function child(v: int): Child {
  return { value: v };
}

export function makeParent(a: int, b: int): Parent {
  return { children: [child(a), child(b)] };
}

export function makeTableWrap(): TableWrap {
  return { data: { values: [[1, 2], [3, 4]] } };
}
