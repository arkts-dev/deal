// @spec: Standard library builtins — JSON
// @description: JSON.stringify serializes a class instance for contextual reconstruction
// @expected: runtime-ok
// @features: jsonable, toJson


export class User {
  name: string;
  age: number;
}

export function test_toJson(): null {
  let u: User = { name: "Bob", age: 25 };
  let s: string = JSON.stringify(u) as string;
  // Roundtrip: parse the JSON back and verify values
  let u2: User | null = JSON.parse(s);
  if (u2 !== null) {
    if (u2.name !== "Bob") {
      throw { code: "TEST_FAIL", message: "toJson roundtrip name mismatch" };
    }
    if (u2.age !== 25) {
      throw { code: "TEST_FAIL", message: "toJson roundtrip age mismatch" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "toJson produced invalid JSON" };
  }
  return null;
}

export function main(): null {
  return null;
}
