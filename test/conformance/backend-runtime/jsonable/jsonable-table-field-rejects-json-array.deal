// @spec: Standard library builtins — JSON decoding
// @description: A Record field rejects an empty JSON array; empty and keyed JSON objects reconstruct and encode as Records.
// @expected: runtime-ok
// @features: json, classes, records

export class Wrapper {
  data: Record<string, unknown>;
}

export function test_table_field_rejects_json_array(): null {
  let rejected = false;
  try { let invalid: Wrapper = JSON.parse("{\"data\":[]}"); }
  catch (e) { let error = e as Error; rejected = error.code === "E8001" && error.message === "expected table"; }
  if (!rejected) { throw {code: "TEST_FAIL", message: "empty array accepted as Record field"}; }
  let empty: Wrapper = JSON.parse("{\"data\":{}}");
  let emptyText: string = JSON.stringify(empty) as string;
  if (emptyText !== "{\"data\":{}}") { throw {code: "TEST_FAIL", message: "empty Record encoding changed"}; }
  let keyed: Wrapper = JSON.parse("{\"data\":{\"count\":3}}");
  if ((keyed.data.count as number) !== 3) { throw {code: "TEST_FAIL", message: "keyed Record value changed"}; }
  return null;
}

export function main(): null {
  return null;
}
