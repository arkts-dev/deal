// @spec: Standard library builtins — JSON decoding
// @description: Unknown class keys throw, and rejection preserves an existing destination.
// @expected: runtime-ok
// @features: json, classes, validation

export class Item { name: string; }

export function test_fromJson_extra_keys(): null {
  let original: Item = {name: "original"};
  let result = original;
  let rejected = false;
  try { result = JSON.parse("{\"name\":\"ok\",\"extra\":42}"); }
  catch (e) { let error = e as Error; rejected = error.code === "E8007" && error.message.includes("extra field 'extra'"); }
  if (!rejected || result !== original || result.name !== "original") {
    throw {code: "TEST_FAIL", message: "extra key rejection changed destination"};
  }
  return null;
}

export function main(): null { return null; }
