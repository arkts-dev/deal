// @spec: Standard library builtins — JSON decoding
// @description: Contextual decoding reconstructs a correctly populated nominal class instance.
// @expected: runtime-ok
// @features: json, classes

export class User {
  name: string;
  age: number;
}

export function test_fromJson(): null {
  let u: User = JSON.parse("{\"name\":\"Alice\",\"age\":30}");
  if (!(u instanceof User) || u.name !== "Alice" || u.age !== 30) {
    throw {code: "TEST_FAIL", message: "decoded nominal class value mismatch"};
  }
  return null;
}

export function main(): null { return null; }
