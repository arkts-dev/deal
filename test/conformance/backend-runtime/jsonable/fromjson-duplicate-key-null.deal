// @spec: Classes — @jsonable fromJson
// @description: @jsonable fromJson returns null for a decoded-key duplicate document and keeps the exact decimal classification at an int field (v1.3)
// @expected: runtime-ok
// @features: jsonable, fromJson, duplicate-key, v1.3

// @jsonable
export class Depth {
  value: int = 0;
}

export function test_fromjson_duplicate_key(): null {
  let duplicate: Depth | null = Depth$fromJson("{\"value\":1,\"value\":2}");
  if (duplicate !== null) {
    throw { code: "TEST_FAIL", message: "a duplicate key must decode to null" };
  }
  let escaped: Depth | null = Depth$fromJson("{\"value\":1,\"\\u0076alue\":2}");
  if (escaped !== null) {
    throw { code: "TEST_FAIL", message: "an escaped equivalent must decode to null" };
  }
  let exact: Depth | null = Depth$fromJson("{\"value\":1.0}");
  if (exact !== null) {
    if (exact.value !== 1) {
      throw { code: "TEST_FAIL", message: "1.0 must decode to the int 1" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "1.0 must denote the int value" };
  }
  let rounded: Depth | null = Depth$fromJson("{\"value\":2147483647.00000001}");
  if (rounded !== null) {
    throw { code: "TEST_FAIL", message: "the rounded fractional token must fail an int field" };
  }
  return null;
}

export function main(): null {
  return null;
}
