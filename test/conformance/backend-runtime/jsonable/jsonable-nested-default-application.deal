// @spec: Standard library builtins — JSON decoding
// @description: Nested decoding rejects required omissions and preserves explicitly supplied fields without defaults.
// @expected: runtime-ok
// @features: json, required-presence, nested-class

export class Child { n: number; }
export class Parent { child: Child; }

export function test_nested_default_application(): null {
  for (let text of ["{\"child\":{}}", "{}"]) {
    let rejected = false;
    try { let invalid: Parent = JSON.parse(text); }
    catch (e) { rejected = (e as Error).code === "E8001"; }
    if (!rejected) { throw {code: "TEST_FAIL", message: "required omission accepted"}; }
  }
  let p: Parent = JSON.parse("{\"child\":{\"n\":7}}");
  if (p.child.n !== 7) { throw {code: "TEST_FAIL", message: "provided nested value missing"}; }
  return null;
}

export function main(): null { return null; }
