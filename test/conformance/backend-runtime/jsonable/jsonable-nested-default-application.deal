// @spec: Classes — JSON serialization (@jsonable)
// @description: A nested class field decoded from an empty JSON object applies the nested class's omitted required-present defaults (v1.2 defect snippet 44)
// @expected: runtime-ok
// @features: jsonable, defaults, nested-class, v1.2

// @jsonable
export class Child { n: number = 7; }

// @jsonable
export class Parent { child: Child = {}; }

export function test_nested_default_application(): null {
  let p: Parent | null = Parent$fromJson("{\"child\":{}}");
  if (p === null) {
    throw { code: "TEST_FAIL", message: "nested default rejected" };
  } else {
    let n: number = p.child.n;
    if (n !== 7) { throw { code: "TEST_FAIL", message: "nested default missing" }; }
  }
  return null;
}

export function main(): null {
  return null;
}
