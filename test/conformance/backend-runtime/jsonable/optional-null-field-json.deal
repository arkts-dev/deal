// @spec: Standard library builtins — JSON
// @description: Optional null fields retain missing versus explicit-null reads and presence across encoding and reconstruction.
// @expected: runtime-ok
// @features: json, classes, optional, null, field-read, has

import * as printer from "std/console";

export class Note {
  label: string;
  n?: null;
}

function require(what: string, condition: boolean): null {
  if (!condition) { throw {code: "TEST_FAIL", message: what}; }
  return null;
}

export function main(): null {
  let decodedNull: Note = JSON.parse("{\"label\":\"a\",\"n\":null}");
  require("explicit null field is present", Object.hasOwn(decodedNull, "n"));
  let nullRead: null | undefined = decodedNull.n;
  require("explicit null read is null", nullRead === null);
  let encoded: string = JSON.stringify(decodedNull) as string;
  require("explicit null encodes as JSON null", encoded === "{\"label\":\"a\",\"n\":null}");
  let redecoded: Note = JSON.parse(encoded);
  require("explicit null roundtrip field is present", Object.hasOwn(redecoded, "n"));
  let roundtripRead: null | undefined = redecoded.n;
  require("explicit null roundtrip read is null", roundtripRead === null);

  let decodedMissing: Note = JSON.parse("{\"label\":\"b\"}");
  require("missing field is absent", !Object.hasOwn(decodedMissing, "n"));
  let missingRead: null | undefined = decodedMissing.n;
  require("missing read is undefined", missingRead === undefined);
  let encodedMissing: string = JSON.stringify(decodedMissing) as string;
  require("missing field is omitted from the encode", encodedMissing === "{\"label\":\"b\"}");
  let redecodeMissing: Note = JSON.parse(encodedMissing);
  require("missing roundtrip field stays absent", !Object.hasOwn(redecodeMissing, "n"));
  let roundtripMissingRead: null | undefined = redecodeMissing.n;
  require("missing roundtrip read is undefined", roundtripMissingRead === undefined);

  let original = decodedMissing;
  let rejected = false;
  try { decodedMissing = JSON.parse("{\"label\":\"c\",\"n\":1}"); }
  catch (e) { let error = e as Error; rejected = error.code === "E8001" && error.message === "expected null"; }
  require("non-null value is rejected without publication", rejected && decodedMissing === original);
  require("failed decode preserves missing field", !Object.hasOwn(decodedMissing, "n"));
  printer.log("OK");
  return null;
}
