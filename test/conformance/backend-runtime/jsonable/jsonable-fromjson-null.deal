// @spec: Standard library builtins — JSON decoding
// @description: Malformed JSON throws a syntax error without publishing a class or changing the destination.
// @expected: runtime-ok
// @features: json, classes, error-handling

export class Item { name: string; }

export function test_fromJson_null(): null {
  let original: Item = {name: "original"};
  let result = original;
  let rejected = false;
  try { result = JSON.parse("not valid json"); }
  catch (e) { let error = e as Error; rejected = error.code === "E8001" && error.message.startsWith("JSON parse error at position "); }
  if (!rejected || result !== original || result.name !== "original") {
    throw {code: "TEST_FAIL", message: "malformed JSON changed destination"};
  }
  return null;
}

export function main(): null { return null; }
