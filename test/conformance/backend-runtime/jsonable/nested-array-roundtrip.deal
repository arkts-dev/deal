// @spec: Standard library builtins — JSON
// @description: Contextual class reconstruction preserves nested numeric arrays
// @expected: runtime-ok
// @features: jsonable, arrays, roundtrip


export class Matrix {
  values: number[][];
}

export function test_jsonable_nested_arrays(): null {
  let m: Matrix = { values: [[1, 2], [3, 4]] };
  let json: string = JSON.stringify(m) as string;
  let m2: Matrix | null = JSON.parse(json);
  if (m2 !== null) {
    if (m2.values[0][0] !== 1 || m2.values[1][1] !== 4) {
      throw { code: "TEST_FAIL", message: "nested array roundtrip mismatch" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "fromJson returned null" };
  }
  return null;
}

export function main(): null {
  return null;
}
