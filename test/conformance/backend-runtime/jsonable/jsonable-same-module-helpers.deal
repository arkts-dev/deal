// @spec: Standard library builtins — JSON
// @description: Ordinary same-module functions wrap JSON builtins and retain callable identity through values.
// @expected: runtime-ok
// @features: json, modules, functions

export class Model { name: string; nick?: string | null; }
export function encode(value: Model): string { return JSON.stringify(value) as string; }
export function decode(text: string): Model { return JSON.parse(text); }

export function test_same_module_helpers(): null {
  let a: Model = {name: ""};
  let encoder: (value: Model) => string = encode;
  let decoder: (text: string) => Model = decode;
  let b: Model = decoder(encoder(a));
  if (b.name !== "" || Object.hasOwn(b, "nick") || b === a || encoder !== encode || decoder !== decode) {
    throw {code: "TEST_FAIL", message: "same-module JSON function roundtrip"};
  }
  return null;
}

export function main(): null { return null; }
