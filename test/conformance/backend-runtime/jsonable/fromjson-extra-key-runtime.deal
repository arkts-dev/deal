// @spec: Standard library builtins — JSON decoding
// @description: Contextual class decoding throws on an extra field before consuming a mismatched declared field.
// @expected: runtime-ok
// @features: json, validation, failure-order

export class User { name: string; }

export function test_jsonable_extra_key_rejected(): null {
  let rejected = false;
  try { let u: User = JSON.parse("{\"name\":7,\"extra\":1}"); }
  catch (e) { let error = e as Error; rejected = error.code === "E8007" && error.message.includes("extra field 'extra'"); }
  if (!rejected) { throw {code: "TEST_FAIL", message: "extra field did not reject before declared field"}; }
  let valid: User = JSON.parse("{\"name\":\"Ada\"}");
  if (valid.name !== "Ada") { throw {code: "TEST_FAIL", message: "valid class decode changed"}; }
  return null;
}

export function main(): null { return null; }
