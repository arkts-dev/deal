// @spec: Standard library builtins — JSON encoding
// @description: JSON.stringify raises E8001 for a class containing a cyclic Record
// @expected: runtime-error E8001
// @features: jsonable, toJson, table, cycle


export class Wrapper {
  data: Record<string, unknown>;
}

export function test_jsonable_tojson_cyclic_table(): string {
  let w: Wrapper = { data: {} };
  w.data.self = w.data;
  return JSON.stringify(w) as string;
}

export function main(): null {
  return null;
}
