// @spec: Classes — @jsonable arrays and optional nullable fields
// @description: @jsonable roundtrip preserves arrays of nested classes, table fields, and optional nullable states
// @expected: runtime-ok
// @features: jsonable, arrays, nullable, tables

import * as Lib from "./jsonable_complex_lib"

export function test_jsonable_complex_roundtrip(): null {
  let raw: string = "{\"name\":\"Ada\",\"addresses\":[{\"city\":\"London\"}],\"nickname\":null,\"meta\":{\"score\":7}}";
  let u: Lib.User | null = Lib.User$fromJson(raw);
  if (u !== null) {
    if (u.nickname !== null) { throw { code: "TEST_FAIL", message: "nickname null mismatch" }; }
    if (u.addresses[0].city !== "London") { throw { code: "TEST_FAIL", message: "address mismatch" }; }
    let encoded: string = Lib.User$toJson(u);
    let u2: Lib.User | null = Lib.User$fromJson(encoded);
    if (u2 === null) { throw { code: "TEST_FAIL", message: "roundtrip failed" }; }
    return null;
  }
  throw { code: "TEST_FAIL", message: "fromJson failed" };
}
