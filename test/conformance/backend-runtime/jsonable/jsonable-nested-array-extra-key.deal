// @spec: Standard library builtins — JSON decoding
// @description: Extra keys inside imported class array elements reject without changing the destination
// @expected: runtime-ok
// @features: jsonable, arrays, diagnostics

import * as Lib from "./jsonable_batch2_lib";

export function test_jsonable_nested_array_extra_key_rejected(): null {
  let original: Lib.Parent = Lib.makeParent(3, 4);
  let p = original;
  let rejected = false;
  try { p = JSON.parse("{\"children\":[{\"value\":1,\"extra\":2}]}"); }
  catch (e) { let error = e as Error; rejected = error.code === "E8007" && error.message.includes("extra field 'extra'"); }
  if (!rejected || p !== original || p.children[1].value !== 4) { throw { code: "TEST_FAIL", message: "nested extra key rejection or rollback failed" }; }
  return null;
}

export function main(): null {
  return null;
}
