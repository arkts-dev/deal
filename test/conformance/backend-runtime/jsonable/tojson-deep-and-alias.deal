// @spec: Classes — @jsonable toJson
// @description: @jsonable toJson serializes a finite 600-level table chain (no fixed depth cap) and duplicates a shared acyclic child (an alias is not a cycle) (v1.3)
// @expected: runtime-ok
// @features: jsonable, toJson, deep, alias, v1.3

import * as json from "std/json";

// @jsonable
export class Holder {
  data: table;
}

export function test_tojson_deep_and_alias(): null {
  let h: Holder = { data: {} };
  let cur: table = h.data;
  { let v14Loop0: number = 0; while (v14Loop0 < 600) { let i: number = v14Loop0; {
    let next: table = {};
    cur.next = next;
    cur = next;
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  let shared: table = { v: 1 };
  h.data.aliasA = shared;
  h.data.aliasB = shared;
  let text: string = Holder$toJson(h);
  let decoded: table = json.parse(text);
  let data: table = decoded.data;
  let aliasA: table = data.aliasA;
  let aliasB: table = data.aliasB;
  let a: number = aliasA.v;
  let b: number = aliasB.v;
  if (aliasA === aliasB || a !== 1 || b !== 1) {
    throw { code: "TEST_FAIL", message: "the shared acyclic child must serialize twice with its value" };
  }
  let cursor: table = data;
  let depth: number = 0;
  while (depth < 600) {
    let next: table = cursor.next;
    cursor = next;
    depth = depth + 1;
  }
  return null;
}

export function main(): null {
  return null;
}
