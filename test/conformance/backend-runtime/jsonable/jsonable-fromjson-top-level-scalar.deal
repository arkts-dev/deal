// @spec: Standard library builtins — JSON decoding
// @description: A class target rejects scalar, null, array and missing-required documents; a complete object decodes.
// @expected: runtime-ok
// @features: json, classes, validation

export class C {
  x: number;
}

function rejects(text: string): void {
  let rejected = false;
  try { let value: C = JSON.parse(text); }
  catch (e) { let error = e as Error; rejected = error.code === "E8001"; }
  if (!rejected) { throw {code: "TEST_FAIL", message: "class target accepted " + text}; }
}

export function test_fromJson_top_level_scalars(): null {
  rejects("42");
  rejects("\"x\"");
  rejects("true");
  rejects("null");
  rejects("[1,2]");
  return null;
}

export function test_fromJson_empty_documents(): null {
  rejects("{}");
  let from_obj: C = JSON.parse("{\"x\":0}");
  if (from_obj.x !== 0) { throw {code: "TEST_FAIL", message: "provided zero field was lost"}; }
  rejects("[]");
  rejects(" [ ] ");
  return null;
}

export function main(): null {
  return null;
}
