// @spec: Classes — @jsonable roundtrip
// @description: @jsonable toJson→fromJson roundtrip preserves all field values
// @expected: runtime-ok
// @features: jsonable, roundtrip

// @jsonable
export class Person {
  name: string = "";
  active: boolean = true;
  score: number = 0.0;
}

export function test_roundtrip(): null {
  let p: Person = { name: "Carol", active: false, score: 99.5 };
  let json: string = Person$toJson(p);
  let p2: Person | null = Person$fromJson(json);
  if (p2 !== null) {
    if (p2.name !== "Carol") {
      throw { code: "TEST_FAIL", message: "roundtrip name mismatch" };
    }
    if (p2.active !== false) {
      throw { code: "TEST_FAIL", message: "roundtrip active mismatch" };
    }
    if (p2.score !== 99.5) {
      throw { code: "TEST_FAIL", message: "roundtrip score mismatch" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "roundtrip fromJson returned null" };
  }
  return null;
}

export function main(): null {
  return null;
}
