// @spec: Standard library builtins — JSON
// @description: Class JSON roundtrips preserve missing, explicit null, and non-null optional states
// @expected: runtime-ok
// @features: jsonable, optional, nullable, roundtrip


export class User {
  name: string;
  nick?: string | null;
}

export function test_jsonable_optional_nullable_three_state(): null {
  let missing: User = { name: "A" };
  let missingJson: string = JSON.stringify(missing) as string;
  let missing2: User | null = JSON.parse(missingJson);
  if (missing2 !== null) {
    if (Object.hasOwn(missing2, "nick")) {
      throw { code: "TEST_FAIL", message: "missing optional field not preserved" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "fromJson returned null for missing-state user" };
  }

  let explicitNull: User = { name: "B", nick: null };
  let nullJson: string = JSON.stringify(explicitNull) as string;
  let null2: User | null = JSON.parse(nullJson);
  if (null2 !== null) {
    if (!Object.hasOwn(null2, "nick") || null2.nick !== null) {
      throw { code: "TEST_FAIL", message: "explicit null optional field not preserved" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "fromJson returned null for explicit-null user" };
  }

  let value: User = { name: "C", nick: "cee" };
  let valueJson: string = JSON.stringify(value) as string;
  let value2: User | null = JSON.parse(valueJson);
  if (value2 !== null) {
    if (!Object.hasOwn(value2, "nick")) {
      throw { code: "TEST_FAIL", message: "optional field value not present" };
    }
    let nick: string | null | undefined = value2.nick;
    if (nick !== null) {
      if ((nick as string) !== "cee") {
        throw { code: "TEST_FAIL", message: "optional field value not preserved" };
      }
    } else {
      throw { code: "TEST_FAIL", message: "optional field value became null" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "fromJson returned null for value user" };
  }
  return null;
}

export function main(): null {
  return null;
}
