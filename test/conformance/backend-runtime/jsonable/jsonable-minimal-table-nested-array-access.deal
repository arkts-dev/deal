// @spec: Classes — @jsonable minimal table nested arrays
// @description: Indexing a dynamic table value as an array is rejected statically
// @expected: compile-error E3007
// @features: jsonable, tables, arrays, diagnostics

// @jsonable
export class Wrap { data: table = {}; }

export function test_jsonable_minimal_table_nested_array_access(): null {
  let w: Wrap | null = Wrap$fromJson("{\"data\":{\"values\":[[1,2],[3,4]]}}");
  if (w !== null) {
    let values: table = w.data.values;
    let row: table = values[1];
    let v: int = row[0];
    if (v !== 3) { throw { code: "TEST_FAIL", message: "minimal table nested arrays failed" }; }
    return null;
  }
  throw { code: "TEST_FAIL", message: "fromJson failed" };
}

export function main(): null { return null; }
