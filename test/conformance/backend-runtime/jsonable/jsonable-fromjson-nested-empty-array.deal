// @spec: Standard library builtins — JSON decoding
// @description: Class fields and class-array elements reject JSON arrays; object forms and an empty class array reconstruct normally.
// @expected: runtime-ok
// @features: json, classes, nested-class, validation

export class Child {
  n: number;
}

export class Parent {
  child: Child;
  items: Child[];
}

export function test_nested_empty_array_rejected(): null {
  for (let text of ["{\"child\":[],\"items\":[]}", "{\"child\":{\"n\":7},\"items\":[[]]}"]) {
    let rejected = false;
    try { let value: Parent = JSON.parse(text); }
    catch (e) { rejected = (e as Error).code === "E8001"; }
    if (!rejected) { throw {code: "TEST_FAIL", message: "nested array accepted as class"}; }
  }
  let ok: Parent = JSON.parse("{\"child\":{\"n\":7},\"items\":[]}");
  if (ok.child.n !== 7) { throw {code: "TEST_FAIL", message: "provided nested value changed"}; }
  if (ok.items.length !== 0) { throw {code: "TEST_FAIL", message: "empty class array changed"}; }
  return null;
}

export function main(): null {
  return null;
}
