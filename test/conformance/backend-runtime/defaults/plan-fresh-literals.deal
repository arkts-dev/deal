// @spec: Classes — Construction
// @description: Explicit table literals are evaluated separately for each construction; mutation remains instance-local.
// @expected: runtime-ok
// @features: classes, construction, tables

class Box {
  data: Record<string, unknown>;
}

export function test_plan_fresh_literals(): null {
  let a: Box = {data: {}};
  let b: Box = {data: {}};
  a.data.x = 7;
  let bx: unknown = b.data.x;
  if (bx !== undefined || Object.hasOwn(b.data, "x")) {
    throw { code: "TEST_FAIL", message: "provided table literals shared across instances" };
  }
  return null;
}

export function main(): null {
  return null;
}
