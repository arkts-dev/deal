// @spec: Classes — Construction
// @description: An imported ordinary producer resolves its private helper in the declaring module and returns the exact exported class.
// @expected: runtime-ok
// @features: classes, construction, modules

import * as P from "./plan_provider_lib";

export function test_plan_imported_provider_scope(): null {
  let a: P.Provider = P.make();
  let b: P.Provider = P.make();
  if (a.value !== 7 || b.value !== 7) {
    throw { code: "TEST_FAIL", message: "declaring-scope producer result mismatch" };
  }
  return null;
}

export function main(): null {
  return null;
}
