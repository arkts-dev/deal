// @spec: Classes — Construction
// @description: Structural class registration runs no host code; a provided expression invokes its host producer exactly once.
// @expected: runtime-ok
// @features: classes, construction, functions, modules, host-abi

import * as probe from "host/planprobe";

class Probe {
  value: number;
}

export function test_plan_load_time_zero_invocations(): null {
  if (probe.valueCount() !== 0) {
    throw { code: "TEST_FAIL", message: "host producer ran at module load" };
  }
  let p: Probe = {value: probe.nextValue()};
  if (probe.valueCount() !== 1) {
    throw { code: "TEST_FAIL", message: "provided producer did not run exactly once" };
  }
  if (p.value !== 10) {
    throw { code: "TEST_FAIL", message: "provided producer result mismatch" };
  }
  return null;
}

export function main(): null {
  return null;
}
