// @spec: Classes — Construction
// @description: Explicit finite recursive structures retain exact providers, nullable links, optional presence and per-construction producer effects; structural registration invokes nothing.
// @expected: runtime-ok
// @features: runtime, construction, classes, recursion, host-abi

import * as probe from "host/planprobe";

function nextStamp(): number { return probe.nextValue(); }

function check(condition: boolean, message: string): null {
  if (!condition) { throw {code: "TEST_FAIL", message: message}; }
  return null;
}

class Node {
  stamp: number;
  next: Node | null;
  tag?: string | null;
}
class Ping { pong: Pong | null; }
class Pong { ping: Ping | null; }
class Holder { node: Node; }
class Spin { next: Spin | null; spin: number; }

export function test_suppressed_self_default_keeps_override(): null {
  let base: number = probe.valueCount();
  let first: Node = {stamp: nextStamp(), next: null};
  check(probe.valueCount() === base + 1, "first provided producer must run once");
  check(first.stamp === (base + 1) * 10, "first producer result");
  check(first.next === null, "explicit nullable link");
  let second: Node = {stamp: nextStamp(), next: first};
  check(probe.valueCount() === base + 2, "second provided producer must run once");
  check(second.stamp === (base + 2) * 10, "second producer result");
  let secondNext: Node | null = second.next;
  if (secondNext !== null) {
    check(secondNext === first, "recursive link must retain provided identity");
  } else { check(false, "recursive link became null"); }
  let explicit: Node = {stamp: 5, next: null};
  check(probe.valueCount() === base + 2, "plain values invoke no producer");
  check(explicit.stamp === 5, "provided stamp");
  check(explicit.next === null, "provided null");
  check(!has(explicit.tag), "omitted optional stays absent");
  let absentTag: string | null = explicit.tag;
  check(absentTag === null, "absent optional reads null");
  let presentNull: Node = {stamp: nextStamp(), next: null, tag: null};
  check(probe.valueCount() === base + 3, "present-null construction producer count");
  check(has(presentNull.tag), "explicit null is present");
  let nullTag: string | null = presentNull.tag;
  check(nullTag === null, "present optional retains null");
  let presentText: Node = {stamp: nextStamp(), next: second, tag: "kept"};
  check(probe.valueCount() === base + 4, "present-value construction producer count");
  let textTag: string | null = presentText.tag;
  check(textTag !== null, "present optional retains value");
  if (textTag !== null) { check(textTag === "kept", "provided text"); }
  let textNext: Node | null = presentText.next;
  if (textNext !== null) {
    check(textNext === second, "recursive chain retains identity");
  } else { check(false, "recursive chain became null"); }
  return null;
}

export function test_suppressed_mutual_defaults(): null {
  let base: number = probe.valueCount();
  let ping: Ping = {pong: null};
  let pong: Pong = {ping: ping};
  ping.pong = pong;
  let linkedPong: Pong | null = ping.pong;
  if (linkedPong !== null) {
    check(linkedPong === pong, "mutual link retains exact Pong");
  } else { check(false, "Pong link became null"); }
  let linkedPing: Ping | null = pong.ping;
  if (linkedPing !== null) {
    check(linkedPing === ping, "mutual link retains exact Ping");
  } else { check(false, "Ping link became null"); }
  check(probe.valueCount() === base, "mutual links invoke no producer");
  return null;
}

export function test_nonexecuted_suppressed_default_side_effect(): null {
  let base: number = probe.valueCount();
  let spun: Spin = {next: null, spin: 0};
  check(spun.next === null, "explicit recursive null");
  check(spun.spin === 0, "explicit zero");
  check(probe.valueCount() === base, "structural construction invokes no hook");
  return null;
}

export function test_nested_default_literal_override(): null {
  let base: number = probe.valueCount();
  let holder: Holder = {node: {stamp: 0, next: null}};
  check(holder.node.next === null, "finite nested recursive literal");
  check(holder.node.stamp === 0, "provided nested stamp");
  check(probe.valueCount() === base, "nested literal invokes no producer");
  return null;
}

export function main(): null {
  check(probe.valueCount() === 0, "structural registration invoked a producer");
  return null;
}
