// @spec: Classes — Construction
// @description: A recursive non-jsonable class default is plan availability, never execution demand: only a construction that omits the recursive field evaluates it (docs/spec-v1.3.md §Construction — provided fields suppress defaults), so the self-defaulting Node, the mutual Ping/Pong pair and a default whose own literal supplies the recursive field all stay finite when the construction supplies the recursive field. The effectful default beside the suppressed one still runs exactly once per construction in declaration order, a supplied field runs none, class registration runs none, a supplied value is never replaced by the default it suppresses, a suppressed default contributes none of its own host calls, and the construction's explicit null, absent-optional and present-optional states stay distinct.
// @expected: runtime-ok
// @features: v1.3, runtime, defaults, classes, recursion

import * as probe from "host/planprobe";

function nextStamp(): int {
  return probe.nextValue();
}

function check(condition: boolean, message: string): null {
  if (!condition) {
    throw { code: "TEST_FAIL", message: message };
  }
  return null;
}

class Node {
  stamp: int = nextStamp();
  next: Node | null = {};
  tag?: string | null;
}

class Ping {
  pong: Pong | null = {};
}

class Pong {
  ping: Ping | null = {};
}

class Holder {
  node: Node = { stamp: 0, next: null };
}

class Spin {
  next: Spin | null = { spin: nextStamp() };
  spin: int = 0;
}

export function test_suppressed_self_default_keeps_override(): null {
  let base: int = probe.valueCount();
  let first: Node = { next: null };
  check(probe.valueCount() === base + 1, "the omitted effectful default did not run exactly once for this construction");
  check(first.stamp === (base + 1) * 10, "the omitted effectful default publishes this construction's value");
  check(first.next === null, "the supplied recursive field suppresses its default");
  let second: Node = { next: null };
  check(probe.valueCount() === base + 2, "the second construction did not evaluate its own omission");
  check(second.stamp === (base + 2) * 10, "the second construction's default value is fresh");
  check(second.next === null, "the second supplied recursive field suppresses its default");
  let explicit: Node = { stamp: 5, next: null };
  check(probe.valueCount() === base + 2, "a fully supplied literal runs no default");
  check(explicit.stamp === 5, "the supplied effectful field keeps its value");
  check(explicit.next === null, "the supplied recursive field keeps its value");
  check(!has(explicit.tag), "an omitted optional field stays absent");
  let explicitTag: string | null = explicit.tag;
  check(explicitTag === null, "the absent optional field reads as null");
  let presentNull: Node = { next: null, tag: null };
  check(probe.valueCount() === base + 3, "the present-null construction ran its omitted default once");
  check(has(presentNull.tag), "an explicitly null optional field is present");
  let presentNullTag: string | null = presentNull.tag;
  check(presentNullTag === null, "the present optional field keeps its explicit null");
  let presentText: Node = { next: null, tag: "kept" };
  check(probe.valueCount() === base + 4, "the present-value construction ran its omitted default once");
  let presentTextTag: string | null = presentText.tag;
  check(presentTextTag !== null, "the present optional field lost its value");
  if (presentTextTag !== null) {
    check(presentTextTag === "kept", "the present optional field keeps its value");
  }
  check(presentText.next === null, "the supplied recursive field still suppresses its default");
  return null;
}

export function test_suppressed_mutual_defaults(): null {
  let base: int = probe.valueCount();
  let ping: Ping = { pong: null };
  let pong: Pong = { ping: null };
  check(ping.pong === null, "the supplied field suppresses its recursive default");
  check(pong.ping === null, "the other class's supplied field suppresses its recursive default");
  check(probe.valueCount() === base, "a suppressed recursive default ran its effect");
  return null;
}

export function test_nonexecuted_suppressed_default_side_effect(): null {
  let base: int = probe.valueCount();
  let spun: Spin = { next: null };
  check(spun.next === null, "the supplied recursive field suppresses its own host call");
  check(spun.spin === 0, "the omitted non-recursive default still runs for this construction");
  check(probe.valueCount() === base, "the suppressed recursive default evaluated its host call");
  return null;
}

export function test_nested_default_literal_override(): null {
  let base: int = probe.valueCount();
  let holder: Holder = {};
  check(holder.node.next === null, "the demanded default's own literal supplies the recursive field, so its construction terminates");
  check(holder.node.stamp === 0, "the demanded default's own literal supplies the effectful field");
  check(probe.valueCount() === base, "a suppressed default ran for the nested construction");
  return null;
}

export function main(): null {
  check(probe.valueCount() === 0, "class registration executed a default");
  return null;
}
