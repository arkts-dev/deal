// @spec: Classes — Construction
// @description: Provided host calls execute independently on each construction and retain each invocation's result.
// @expected: runtime-ok
// @features: classes, construction, functions, modules, host-abi

import * as probe from "host/planprobe";

class Counter {
  value: number;
}

export function test_plan_reexecuted_calls(): null {
  let a: Counter = {value: probe.nextValue()};
  let b: Counter = {value: probe.nextValue()};
  if (probe.valueCount() !== 2) {
    throw { code: "TEST_FAIL", message: "provided calls did not execute independently" };
  }
  if (a.value !== 10 || b.value !== 20) {
    throw { code: "TEST_FAIL", message: "per-attempt provided results mismatch" };
  }
  return null;
}

export function main(): null {
  return null;
}
