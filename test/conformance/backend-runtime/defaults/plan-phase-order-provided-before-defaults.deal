// @spec: Classes — Construction
// @description: Provided expressions execute in source order before declaration-order boundaries; failure stops later effects and leaves the existing target unchanged.
// @expected: runtime-ok
// @features: classes, construction, functions, modules, host-abi, arrays

import * as probe from "host/planprobe";

class C {
  a: number;
  b: number;
}

function pick(): number {
  let xs: number[] = [1];
  return xs[-1];
}

export function test_plan_phase_order(): null {
  let caught: Error | null = null;
  let target: C = {a: 1, b: 2};
  let original: C = target;
  try {
    target = { b: pick(), a: probe.nextValue() };
  } catch (e) {
    caught = e;
  }
  if (caught !== null) {
    if (caught.code !== "E8002") {
      throw { code: "TEST_FAIL", message: "provided-value bounds error did not fire first" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "provided-value bounds error did not raise" };
  }
  if (probe.valueCount() !== 0) {
    throw { code: "TEST_FAIL", message: "later provided expression ran after failure" };
  }
  if (target !== original || target.a !== 1 || target.b !== 2) {
    throw {code: "TEST_FAIL", message: "failed construction replaced the target"};
  }
  let c2: C = { b: 3, a: probe.nextValue() };
  if (probe.valueCount() !== 1) {
    throw { code: "TEST_FAIL", message: "clean attempt did not run its producer once" };
  }
  if (c2.a !== 10) {
    throw { code: "TEST_FAIL", message: "clean attempt provided result mismatch" };
  }
  return null;
}

export function main(): null {
  return null;
}
