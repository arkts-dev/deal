// @spec: Standard library builtins — JSON encoding
// @description: Class Record content preserves lone UTF-16 units, omission, substitution and ordering; cycles fail encoding.
// @expected: runtime-ok
// @features: classes, jsonable, toJson, tables, host-abi, v1.6

import * as host from "host/jsonabletable";


function equivalent(text: string, expected: string): boolean {
  return JSON.stringify(JSON.parse(text)) === JSON.stringify(JSON.parse(expected));
}

function check(condition: boolean, message: string): null {
  if (!condition) {
    throw { code: "TEST_FAIL", message: message };
  }
  return null;
}

// The closed outcome of one helper call: the exact text, or the failure's
// code and message. Each call is independent (JsonEncodeV13), so a probe
// never observes another call's state.
function closedOutcome(w: TableField): string {
  let outcome: string = "no-failure";
  try {
    outcome = "OK:" + (JSON.stringify(w) as string);
  } catch (e) {
    let error: Error = e as Error;
    outcome = error.code + "|" + error.message;
  }
  return outcome;
}

export class TableField {
  data: Record<string, unknown>;
}

export class TableElements {
  rows: Record<string, unknown>[];
}

export function test_host_table_field(): null {
  let w: TableField = { data: host.makeTable() };
  let text: string = JSON.stringify(w) as string;
  check(equivalent(text, "{\"data\":{\"a\":1}}"), "the host table field spells " + text);
  return null;
}

export function test_host_table_nested_content(): null {
  let carrier: TableField = { data: { inner: host.makeTable() } };
  let carrierText: string = JSON.stringify(carrier) as string;
  check(equivalent(carrierText, "{\"data\":{\"inner\":{\"a\":1}}}"),
    "the plain host table nested in a table carrier spells " + carrierText);
  let nested: TableField = { data: host.makeNested() };
  let nestedText: string = JSON.stringify(nested) as string;
  check(equivalent(nestedText, "{\"data\":{\"inner\":{\"a\":1},\"xs\":[10,20]}}"),
    "the host table's nested object and array members spell " + nestedText);
  return null;
}

export function test_host_table_array_elements(): null {
  let w: TableElements = { rows: [host.makeTable(), host.makeNested()] };
  let text: string = JSON.stringify(w) as string;
  check(equivalent(text, "{\"rows\":[{\"a\":1},{\"inner\":{\"a\":1},\"xs\":[10,20]}]}"),
    "a table[] element holding a host table spells " + text);
  return null;
}

export function test_host_parsed_table_field(): null {
  let w: TableField = { data: host.makeParsed() };
  let text: string = JSON.stringify(w) as string;
  check(equivalent(text, "{\"data\":{\"v\":0.1,\"w\":1.0E17}}"),
    "the host std/json object at a table field spells " + text);
  return null;
}

export function test_host_parsed_table_element(): null {
  let w: TableElements = { rows: [host.makeParsed()] };
  let text: string = JSON.stringify(w) as string;
  check(equivalent(text, "{\"rows\":[{\"v\":0.1,\"w\":1.0E17}]}"),
    "a table[] element holding the host std/json object spells " + text);
  return null;
}

export function test_host_table_non_finite(): null {
  let infinite: TableField = { data: host.makeInfinite() };
  check(closedOutcome(infinite)
      === "OK:{\"data\":{\"a\":null}}",
    "an infinite host-table member becomes JSON null: "
      + closedOutcome(infinite));
  let nan: TableField = { data: host.makeNotANumber() };
  check(closedOutcome(nan)
      === "OK:{\"data\":{\"a\":null}}",
    "a NaN host-table member becomes JSON null: "
      + closedOutcome(nan));
  let nested: TableField = { data: host.makeNestedInfinite() };
  check(closedOutcome(nested)
      === "OK:{\"data\":{\"inner\":{\"a\":null}}}",
    "a nested non-finite leaf becomes JSON null: "
      + closedOutcome(nested));
  let elements: TableField = { data: host.makeInfiniteElements() };
  check(equivalent(JSON.stringify(elements) as string, "{\"data\":{\"xs\":[null,2]}}"),
    "a non-finite array element becomes JSON null: "
      + closedOutcome(elements));
  return null;
}

export function test_host_table_invalid_key(): null {
  let root: TableField = {data:host.makeBadKey()};
  let rootDecoded=(JSON.parse(JSON.stringify(root) as string) as Record<string,unknown>).data as Record<string,unknown>;
  check((rootDecoded[`\uD800`] as number)===1,"lone root key survives generated JSON");
  let nested: TableField = {data:host.makeNestedBadKey()};
  let nestedDecoded=(JSON.parse(JSON.stringify(nested) as string) as Record<string,unknown>).data as Record<string,unknown>;
  let inner=nestedDecoded.inner as Record<string,unknown>;
  check((inner[`\uD800`] as number)===1,"lone nested key survives generated JSON");
  let leaf: TableField = {data:host.makeBadString()};
  let leafDecoded=(JSON.parse(JSON.stringify(leaf) as string) as Record<string,unknown>).data as Record<string,unknown>;
  check((leafDecoded.a as string)===`\uD800`,"lone nested string survives generated JSON");
  return null;
}

export function test_host_table_cycle(): null {
  let w: TableField = { data: host.makeCycle() };
  let closed: boolean = false;
  try {
    let text: string = JSON.stringify(w) as string;
    check(text === "", "a cyclic host table must not serialize");
  } catch (e) {
    let error: Error = e as Error;
    closed = error.code === "E8001"
      && error.message === "cyclic value cannot be encoded as JSON";
  }
  check(closed, "the host table cycle takes the closed cycle arm");
  return null;
}

export function main(): null {
  return null;
}
