// @spec: Runtime execution model — String boundary validation
// @description: A host-returned embedded lone UTF-16 unit survives the declared string boundary exactly
// @expected: runtime-ok
// @features: modules, host-abi, string, unicode, runtime-errors

import * as host from "host/bad_string";

export function test_host_bad_utf8(): string {
  let s: string = host.embeddedSurrogateString();
  if(s!==`a\uD800b`){throw {code:"TEST",message:"host embedded lone unit lost"};}
  return s;
}

export function main(): null {
  return null;
}
