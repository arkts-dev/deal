// @spec: Modules, declarations, standard library, and host ABI
// @description: A declared host class constructs from supplied structural fields without defaults hooks; optional presence and the instance survive a declared host parameter crossing.
// @expected: runtime-ok
// @features: modules, host-abi, classes

import * as cfg from "host/cfg";

export function test_host_class_export(): string {
  let s: cfg.ServerConfig = {
    port: 9090,
    endpoint: { path: "/api" },
    tags: ["dev"],
    note: null,
  };
  if (s.port !== 9090) {
    throw { code: "TEST_FAIL", message: "host class port field mismatch" };
  }
  if (s.endpoint.path !== "/api") {
    throw { code: "TEST_FAIL", message: "host class endpoint field mismatch" };
  }
  let tags: string[] | undefined = s.tags;
  if (tags !== undefined) {
    if (tags[0] !== "dev") {
      throw { code: "TEST_FAIL", message: "host class array field mismatch" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "host class array field was null" };
  }
  if (s.note !== null) {
    throw { code: "TEST_FAIL", message: "host class nullable field mismatch" };
  }
  let described: string = cfg.describe(s);
  if (described !== "/api:9090") {
    throw { code: "TEST_FAIL", message: "host class instance failed the boundary roundtrip" };
  }
  return "host class export ok";
}

export function main(): null {
  return null;
}
