// @spec: Modules, declarations, standard library, and host ABI
// @description: A closure-cleared boolean refinement crossing a declared host parameter raises E8010 at the call boundary — never a masking assertion or read-site E8001.
// @expected: runtime-error E8010
// @features: modules, host-abi, boolean, runtime-errors

import * as host from "host/boundary";

export function test_host_boolean_param_mismatch(): boolean {
  let value: boolean | null = true;
  let clear: () => void = function(): void { value = null; };
  if (value !== null) {
    clear();
    return host.echoBoolean(value);
  }
  throw { code: "TEST_FAIL", message: "refined parameter branch skipped" };
}

export function main(): null {
  return null;
}
