// @spec: Modules, declarations, standard library, and host ABI
// @description: Boolean false crosses both directions at the host boundary without truthiness coercion
// @expected: runtime-ok
// @features: host-abi, boolean, outbound-boundary, inbound-boundary

import * as host from "host/boundary";
export function main(): null { let value: boolean = host.echoBoolean(false); if (value) { throw { code: "TEST_FAIL", message: "host boolean false mapping" }; } return null; }
