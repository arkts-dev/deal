// @spec: Modules, declarations, standard library, and host ABI
// @description: An arity-extended host async call through an adapter-over-async preserves the declared class and function arguments at the leading positions and never forwards the extra target parameter, at both the statically fixed and the runtime-resolved nested-source shapes: the host observes the declared class field, invokes the function argument with the declared argument and its exact declared result, and the extra target parameter is evaluated in DEAL exactly once per call.
// @expected: runtime-ok
// @features: modules, host-abi, async-await, functions, arity-extension

import * as host from "host/carrierarity";

class Marker {
  count: int = 0;
}

function check(condition: boolean, message: string): null {
  if (!condition) {
    throw { code: "TEST_FAIL", message: message };
  }
  return null;
}

function bump(x: int): int {
  let y: int = x + 1;
  return y;
}

function pick(): async (t: host.Target, g: (x: int) => int) => string {
  return host.describeAsync;
}

export async function test_arity_extended_adapter(): null {
  let target: host.Target = { name: "target" };
  let callback: (x: int) => int = bump;
  let marker: Marker = {};
  let extra = function(): int {
    marker.count = marker.count + 1;
    return 1;
  };
  let source: async (t: host.Target, g: (x: int) => int) => string =
    host.describeAsync;
  source = source;
  let fixed: async (t: host.Target, g: (x: int) => int, extra: int) => string =
    source;
  let fixedText: string = await fixed(target, callback, extra());
  check(fixedText === "T|target|true:42", "the statically fixed arity-extended host async call");
  let runtimeSource: async (t: host.Target, g: (x: int) => int) => string =
    pick();
  let dynamic: async (t: host.Target, g: (x: int) => int, extra: int) => string =
    runtimeSource;
  let dynamicText: string = await dynamic(target, callback, extra());
  check(dynamicText === fixedText, "the runtime-resolved arity-extended host async call");
  check(marker.count === 2, "the extra target parameter is evaluated once per call and never forwarded");
  return null;
}

export function main(): null {
  return null;
}
