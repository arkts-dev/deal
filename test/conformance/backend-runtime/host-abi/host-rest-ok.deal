// @spec: Modules, declarations, standard library, and host ABI
// @description: A declared rest-param host export loads and calls through the emitted full-array rest arm (...string[]), with several rest args checked per element.
// @expected: runtime-ok
// @features: modules, host-abi, rest

import * as host from "host/rest_join"

export function test_host_rest_ok(): string {
  let joined: string = host.join("-", "a", "b", "c");
  if (joined !== "a-b-c") {
    throw { code: "TEST_FAIL", message: "rest-param join mismatch" };
  }
  let empty: string = host.join("+");
  if (empty !== "") {
    throw { code: "TEST_FAIL", message: "rest-param zero-rest mismatch" };
  }
  return "host rest ok";
}
