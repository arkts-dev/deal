// @spec: Modules, declarations, standard library, and host ABI
// @description: Extra host exports beyond the declared surface are ignored — the load succeeds and the declared surface works.
// @expected: runtime-ok
// @features: modules, host-abi

import * as host from "host/extra_export"

export function test_host_extra_export_ignored(): string {
  let pong: string = host.ping();
  if (pong !== "pong") {
    throw { code: "TEST_FAIL", message: "declared export returned unexpected value" };
  }
  return "host extra export ignored ok";
}
