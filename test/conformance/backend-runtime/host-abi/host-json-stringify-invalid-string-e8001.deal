// @spec: Modules, declarations, standard library, and host ABI
// @description: Lone UTF-16 host strings survive ingress and JSON roundtrip.
// @expected: runtime-ok
// @features: stdlib, json, host-abi, unicode, v1.6
import * as host from "host/jsonabletable";

export function test_json_stringify_invalid_string(): void {
  let value = host.makeBadString();
  let text = JSON.stringify(value) as string;
  let decoded: Record<string, unknown> = JSON.parse(text);
  if((value.a as string)!==`\uD800` || (decoded.a as string)!==`\uD800`) {
    throw {code:"FAIL",message:"lone string lost during host or JSON crossing"};
  }
}
export function main(): null { return null; }
