// @spec: Modules, declarations, standard library, and host ABI
// @description: Malformed unread nested host strings reject ingress before json.stringify can observe them.
// @expected: runtime-ok
// @features: stdlib, json, host-abi, unicode, v1.5
import * as host from "host/jsonabletable";
export function test_json_stringify_invalid_string(): void {
  let rejected: boolean = false;
  try { host.makeBadString(); } catch (e) { if (e instanceof Error) { rejected = e.code === "E8010"; } }
  if (!rejected) { throw {code: "FAIL", message: "malformed string published"}; }
}
export function main(): null { return null; }
