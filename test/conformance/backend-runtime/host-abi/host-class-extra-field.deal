// @spec: Modules, declarations, standard library, and host ABI
// @description: A declared optional host field is accepted from structural metadata regardless of retired defaults-map contents; explicit null remains present.
// @expected: runtime-ok
// @features: modules, host-abi, classes

import * as presence from "host/presence";

export function test_host_class_extra_field(): null {
  let c: presence.Config = {
    port: 9000,
    fallback: null,
  };
  if (c.port !== 9000 || !Object.hasOwn(c, "fallback") || c.fallback !== null || Object.hasOwn(c, "peers")) {
    throw {code: "TEST_FAIL", message: "host structural field presence mismatch"};
  }
  return null;
}

export function main(): null {
  return null;
}
