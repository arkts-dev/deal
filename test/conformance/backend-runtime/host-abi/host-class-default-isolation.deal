// @spec: Modules, declarations, standard library, and host ABI
// @description: Structural host construction keeps separately supplied values and optional presence isolated; no retired defaults hook supplies or mutates instance fields.
// @expected: runtime-ok
// @features: modules, host-abi, classes

import * as cfg from "host/cfg";

export function test_host_class_default_isolation(): string {
  // The first instance omits optional fields; the second supplies them.
  // Neither construction may acquire fields from the other's values.
  let a: cfg.ServerConfig = {
    port: 9090,
    endpoint: { path: "/first" },
  };
  let b: cfg.ServerConfig = {
    port: 8080,
    endpoint: { path: "/second" },
    tags: ["two"],
    note: null,
  };
  if (Object.hasOwn(a, "tags") || Object.hasOwn(a, "note")) { throw {code: "TEST_FAIL", message: "omitted fields became present"}; }
  if (a.port !== 9090) {
    throw { code: "TEST_FAIL", message: "first instance port mismatch" };
  }
  if (b.port !== 8080) {
    throw { code: "TEST_FAIL", message: "default table shared across instances" };
  }
  let tags: string[] | undefined = b.tags;
  if (tags !== undefined) {
    if (tags[0] !== "two") {
      throw { code: "TEST_FAIL", message: "second instance tag value mismatch" };
    }
  } else {
    throw { code: "TEST_FAIL", message: "second instance optional field lost" };
  }
  if (b.note !== null) {
    throw { code: "TEST_FAIL", message: "second instance nullable field mismatch" };
  }
  return "host class default isolation ok";
}

export function main(): null {
  return null;
}
