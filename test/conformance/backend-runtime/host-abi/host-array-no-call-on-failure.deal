// @spec: Modules, declarations, standard library, and host ABI
// @description: A failed number[] parameter check invokes no host method: the caught E8010 leaves the host call counter unchanged, while a subsequent good call is counted exactly once.
// @expected: runtime-ok
// @features: modules, host-abi, arrays, runtime-errors

import * as host from "host/array_roundtrip";

export function test_host_array_no_call_on_failure(): string {
  let before: number = host.callCount();
  let holder: table = { item: "not number[]" };
  let failed: boolean = false;
  try {
    let x: number[] = host.echoArray(holder.item);
  } catch (e) {
    if (e.code !== "E8010") {
      throw { code: "TEST_FAIL", message: "expected E8010, got " + e.code };
    }
    failed = true;
  }
  if (!failed) {
    throw { code: "TEST_FAIL", message: "no E8010 raised by the failing number[] parameter" };
  }
  let after: number = host.callCount();
  if (after !== before) {
    throw { code: "TEST_FAIL", message: "host invoked after a failed parameter check" };
  }
  let b: number[] = [0];
  let echo: number[] = host.echoArray(b);
  if (echo.length !== 1 || echo[0] !== 0) {
    throw { code: "TEST_FAIL", message: "good echo lost array content" };
  }
  if (host.callCount() !== before + 1) {
    throw { code: "TEST_FAIL", message: "good host call not counted exactly once" };
  }
  return "no-call-ok";
}

export function main(): null {
  return null;
}
