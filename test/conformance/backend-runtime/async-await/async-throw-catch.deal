// @spec: Async/Await — throw inside async caught by catch
// @description: throw inside async function caught by catch in same async function
// @expected: runtime-ok
// @features: async, error-handling, runtime

export async function f(): string {
  let intendedCatchRan: boolean = false;
  let fallbackCatchRan: boolean = false;
  let normalRan: boolean = false;
  let intendedCode: string = "";
  let fallbackCode: string = "";

  try {
    try {
      throw { code: "E_TEST", message: "test error" };
      normalRan = true;
    } catch (e) {
      intendedCatchRan = true;
      intendedCode = e.code;
    }
  } catch (e) {
    fallbackCatchRan = true;
    fallbackCode = e.code;
  }

  if (intendedCatchRan !== true ||
      fallbackCatchRan !== false ||
      normalRan !== false ||
      intendedCode !== "E_TEST" ||
      fallbackCode !== "") {
    throw { code: "TEST_FAIL", message: "E_TEST must reach only the intended same-async catch with empty fallback state" };
  }

  return "E_TEST";
}

export function main(): null {
  return null;
}
