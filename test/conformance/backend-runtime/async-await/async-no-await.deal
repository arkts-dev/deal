// @spec: Async/Await — async function without internal await
// @description: async function that returns immediately without any internal await exercises the __done guard; must not crash
// @expected: runtime-ok
// @features: async-await

export async function test_no_await(): int {
  let result: int = 42;
  if (result !== 42) {
    throw { code: "TEST_FAIL", message: "no-await completion value mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
