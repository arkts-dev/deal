// @spec: Async/Await — Async operation semantics
// @description: Error thrown by awaited async callee is catchable around await in caller
// @expected: runtime-ok
// @features: async, await, try-catch, error

async function boom(): Promise<number> {
  throw { name: "E_INNER", message: "inner" };
}

export async function test_awaited_error_catch(): Promise<null> {
  try {
    let x: number = await boom();
    throw { name: "TEST_FAIL", message: "awaited throw returned a value" };
  } catch (e) {
    if ((e as Error).name !== "E_INNER") {
      throw { name: "TEST_FAIL", message: "wrong error name" };
    }
  }
  return null;
}

export function main(): void {
  return ;
}
