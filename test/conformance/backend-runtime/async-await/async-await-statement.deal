// @spec: Async/Await — await as expression statement
// @description: await expression used as a statement (discarding result) compiles and runs
// @expected: runtime-ok
// @features: async, await, runtime

export async function f(): int {
  let completionState: int = 0;
  let completionCount: int = 0;

  async function g(): int {
    let result: int = 42;
    completionState = result;
    completionCount = completionCount + 1;
    return result;
  }

  await g();

  if (completionState !== 42) {
    throw { code: "TEST_FAIL", message: "discarded await completion state mismatch" };
  }
  if (completionCount !== 1) {
    throw { code: "TEST_FAIL", message: "discarded await invocation count mismatch" };
  }

  return 0;
}

export function main(): null {
  return null;
}
