// @spec: Async/Await — async imports
// @description: Awaiting an imported async function works through module boundaries
// @expected: runtime-ok
// @features: async, await, modules

import * as Lib from "./async_module_lib"

export async function test_async_import_await(): int {
  let result: int = await Lib.plusOne(4);
  if (result !== 5) { throw { code: "TEST_FAIL", message: "async import await failed" }; }
  return result;
}
