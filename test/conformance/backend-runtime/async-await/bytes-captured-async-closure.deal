// @spec: Bytes — Recursive array/nullable closure
// @description: An async closure captures a number[] buffer, writes through it, and completes with the observed byte (v1.2 defect snippet 69)
// @expected: runtime-ok
// @features: number[], async, closures, capture, v1.2

export async function check(): number {
  let b: number[] = [0];
  let set: async (n: number) => null = async function(n: number): null {
    b[0] = n;
    return null;
  };
  await set(255);
  if (b[0] !== 255) { throw {code: "TEST_FAIL", message: "captured async byte write"}; }
  return b[0];
}

export function main(): null {
  return null;
}
