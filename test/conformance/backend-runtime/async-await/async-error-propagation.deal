// @spec: Async/Await — error propagation through await
// @description: Error in awaited function propagates and is caught by catch around await
// @expected: runtime-ok
// @features: async, await, error-handling, runtime

async function inner(): int {
  throw { code: "E_INNER", message: "inner error" };
  return 0;
}

export async function outer(): string {
  try {
    let _: int = await inner();
    return "no error";
  } catch (e) {
    return e.code;
  }
}
