// @spec: Async/Await — error propagation through await
// @description: Error in awaited function propagates and is caught by catch around await
// @expected: runtime-ok
// @features: async, await, error-handling, runtime

async function inner(): int {
  throw { code: "E_INNER", message: "inner error" };
  return 0;
}

export async function outer(): string {
  let intendedCatchRan: boolean = false;
  let fallbackCatchRan: boolean = false;
  let normalRan: boolean = false;
  let intendedCode: string = "";
  let fallbackCode: string = "";

  try {
    try {
      let _: int = await inner();
      normalRan = true;
    } catch (e) {
      intendedCatchRan = true;
      intendedCode = e.code;
    }
  } catch (outerErr) {
    fallbackCatchRan = true;
    fallbackCode = outerErr.code;
  }

  if (!intendedCatchRan || fallbackCatchRan || normalRan || intendedCode !== "E_INNER" || fallbackCode !== "") {
    throw { code: "TEST_FAIL", message: "awaited E_INNER must be caught only by the caller catch with no normal or fallback path" };
  }

  return "E_INNER";
}

export function main(): null {
  return null;
}
