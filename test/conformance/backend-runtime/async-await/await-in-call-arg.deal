// @spec: Async/Await — await in call arguments
// @description: Await inside function call arguments preserves evaluation and type checking
// @expected: runtime-ok
// @features: async, await, calls

async function one(): int { return 1; }
function add(a: int, b: int): int { return a + b; }

export async function test_await_in_call_arg(): int {
  let result: int = add(await one(), 2);
  if (result !== 3) { throw { code: "TEST_FAIL", message: "await in call arg failed" }; }
  return result;
}

export function main(): null {
  return null;
}
