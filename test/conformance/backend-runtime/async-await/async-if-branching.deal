// @spec: Async/Await — async with if branching around await
// @description: Async function with if/else branching uses await in both branches
// @expected: runtime-ok
// @features: async, await, control-flow, runtime

async function g(x: int): int { return x * 2; }

async function branchValue(n: int): int {
  if (n > 0) {
    return await g(n);
  } else {
    return await g(0);
  }
}

export async function f(): int {
  let positive: int = await branchValue(5);
  if (positive !== 10) {
    throw { code: "TEST_FAIL", message: "positive branch await result mismatch" };
  }
  let zero: int = await branchValue(0);
  if (zero !== 0) {
    throw { code: "TEST_FAIL", message: "else branch await result mismatch" };
  }
  return positive;
}

export function main(): null {
  return null;
}
