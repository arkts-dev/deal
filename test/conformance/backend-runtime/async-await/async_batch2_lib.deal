// @expected: companion
// @description: Classified support module — compiled by the companion
// catalog when a parent conformance fixture imports it. The v1.2 gate
// (ISSUE-0107) removes unclassified skips: every .deal file carries an
// explicit classification, and companions must keep compiling standalone.
export async function makeInt(): number { return 5; }
export async function makeArray(): number[] { return [4, 9]; }
export class Box { value: number = 0; }
export async function makeBox(): Box { return { value: 12 }; }
export async function fail(): number { throw { code: "ASYNC_MODULE_FAIL", message: "fail" }; }
export async function plus(x: number): number { return x + 1; }
