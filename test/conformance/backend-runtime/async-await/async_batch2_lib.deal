// @expected: companion
// @description: Classified support module — compiled by the companion
// catalog when a parent conformance fixture imports it. The v1.2 gate
// (ISSUE-0107) removes unclassified skips: every .deal file carries an
// explicit classification, and companions must keep compiling standalone.
export async function makeInt(): Promise<number> { return 5; }
export async function makeArray(): Promise<number[]> { return [4, 9]; }
export class Box { value: number; }
export async function makeBox(): Promise<Box> { return { value: 12 }; }
export async function fail(): Promise<number> { throw { code: "ASYNC_MODULE_FAIL", message: "fail" }; }
export async function plus(x: number): Promise<number> { return x + 1; }
