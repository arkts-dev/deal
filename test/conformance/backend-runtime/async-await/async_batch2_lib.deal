export async function makeInt(): int { return 5; }
export async function makeArray(): int[] { return [4, 9]; }
export class Box { value: int = 0; }
export async function makeBox(): Box { return { value: 12 }; }
export async function fail(): int { throw { code: "ASYNC_MODULE_FAIL", message: "fail" }; }
export async function plus(x: int): int { return x + 1; }
