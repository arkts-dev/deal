// @spec: Async/Await — multiple sequential await calls
// @description: multiple await calls in sequence within a single async function, each suspending and resuming correctly
// @expected: runtime-ok
// @features: async-await

async function double(x: int): int {
  return x * 2;
}

async function triple(x: int): int {
  return x * 3;
}

export async function test_multiple_await(): int {
  let stage: int = 0;
  let a: int = await double(10);
  if (a !== 20) {
    throw { code: "TEST_FAIL", message: "first awaited completion mismatch" };
  }
  stage = stage + 1;
  let b: int = await triple(a);
  if (b !== 60) {
    throw { code: "TEST_FAIL", message: "second awaited completion mismatch" };
  }
  stage = stage + 1;
  if (stage !== 2) {
    throw { code: "TEST_FAIL", message: "multiple await stage sequence mismatch" };
  }
  return b;
}

export function main(): null {
  return null;
}
