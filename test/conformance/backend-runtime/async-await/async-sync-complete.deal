// @spec: Async/Await — async function without internal await
// @description: Async function that completes synchronously (no internal await) does not crash
// @expected: runtime-ok
// @features: async, runtime

export async function f(): int {
  let result: int = 5;
  if (result !== 5) {
    throw { code: "TEST_FAIL", message: "synchronous completion value mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
