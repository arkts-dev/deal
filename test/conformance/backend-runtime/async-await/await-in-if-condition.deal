// @spec: Async/Await — await in conditions
// @description: Await can appear in an if condition and resume with boolean value
// @expected: runtime-ok
// @features: async, await, control-flow

async function yes(): boolean { return true; }

export async function test_await_in_if_condition(): int {
  let result: int = 0;
  let trueBranch: boolean = false;
  let falseBranch: boolean = false;
  if (await yes()) {
    trueBranch = true;
    result = 1;
  } else {
    falseBranch = true;
    result = 0;
  }
  if (!trueBranch) {
    throw { code: "TEST_FAIL", message: "awaited condition did not select the true branch" };
  }
  if (falseBranch) {
    throw { code: "TEST_FAIL", message: "awaited condition selected the forbidden false branch" };
  }
  if (result !== 1) {
    throw { code: "TEST_FAIL", message: "true branch result mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
