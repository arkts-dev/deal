// @spec: Async/Await — simple async with await
// @description: Simple async function with await compiles and runs correctly
// @expected: runtime-ok
// @features: async, await, runtime

async function g(): int { return 42; }

export async function f(): int {
  let x: int = await g();
  if (x !== 42) {
    throw { code: "TEST_FAIL", message: "simple await value mismatch" };
  }
  return x;
}

export function main(): null {
  return null;
}
