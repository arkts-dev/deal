// @spec: Async/Await — async function expression
// @description: async function expression assigned to variable and awaited
// @expected: runtime-ok
// @features: async-await

export async function test_async_expr(): int {
  let f: async () => int = async function(): int {
    return 42;
  };
  let result: int = await f();
  if (result !== 42) {
    throw { code: "TEST_FAIL", message: "async function expression awaited result mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
