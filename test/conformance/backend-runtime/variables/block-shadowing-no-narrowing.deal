// @spec: Variables — Null narrowing
// @description: A block-local binding shadows without inheriting the outer narrowing (v1.2 defect snippet 08)
// @expected: runtime-ok
// @features: variables, narrowing, shadowing

export function test_block_shadow(): number {
  let x: string | null = "a";
  let n: number = 0;
  if (x !== null) {
    let x: number = 4;
    n = x;
  }
  if (n !== 4 || x === null) { throw {code: "TEST_FAIL", message: "block binding shadow"}; }
  if (x !== null) { if (x !== "a") { throw {code: "TEST_FAIL", message: "outer binding changed"}; } }
  return n;
}

export function main(): null {
  return null;
}
