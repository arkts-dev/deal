// @spec: Runtime execution model — Class parameter checks
// @description: A closure-cleared nominal class refinement fails at class parameter admission, not at an assertion.
// @expected: runtime-error E8001
// @features: classes, type-system, runtime-errors

import * as json from "std/json";

class Box { value: number; }
function needBox(b: Box): number { return b.value; }

export function test_dynamic_bad_class_param(): number {
  let item: Box | null = {value: 7};
  let clear: () => void = function(): void { item = null; };
  if (item !== null) {
    clear();
    return needBox(item);
  }
  throw { code: "TEST_FAIL", message: "refined class branch skipped" };
}

export function main(): null {
  return null;
}
