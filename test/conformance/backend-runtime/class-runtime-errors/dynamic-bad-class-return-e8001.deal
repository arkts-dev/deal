// @spec: Runtime execution model — Class return checks
// @description: A closure-cleared nominal class refinement fails at class return admission, independently of assertions.
// @expected: runtime-error E8001
// @features: classes, type-system, runtime-errors

import * as json from "std/json";

class Box { value: number; }

export function test_dynamic_bad_class_return(): Box {
  let item: Box | null = {value: 7};
  let clear: () => void = function(): void { item = null; };
  if (item !== null) {
    clear();
    return item;
  }
  throw { code: "TEST_FAIL", message: "refined class return branch skipped" };
}

export function main(): null {
  return null;
}
