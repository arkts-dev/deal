// @spec: Runtime execution model — Class array checks
// @description: A closure-invalidated nominal refinement fails at the first class array construction element with E8003, independently from checked extraction.
// @expected: runtime-error E8003
// @features: classes, arrays, runtime-errors

import * as json from "std/json";

class Box { value: number; }

export function test_dynamic_bad_class_array_element(): number {
  let item: Box | null = {value: 7};
  let clear: () => void = function(): void { item = null; };
  if (item !== null) {
    clear();
    let xs: Box[] = [item];
    return xs[0].value;
  }
  throw { code: "TEST_FAIL", message: "nominal element branch skipped" };
}

export function main(): null {
  return null;
}
