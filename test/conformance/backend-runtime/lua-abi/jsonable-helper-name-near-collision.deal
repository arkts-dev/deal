// @spec: Standard library builtins — JSON
// @description: Ordinary JSON wrapper names and similar local bindings remain distinct in generated artifacts.
// @expected: runtime-ok
// @features: lua-abi, json, naming

export class User { name: string; }
export function User_fromJson(text: string): User { return JSON.parse(text); }

export function test_jsonable_helper_name_near_collision(): null {
  let User_fromJson_local: string = "local";
  let u: User = User_fromJson("{\"name\":\"Ada\"}");
  if (User_fromJson_local !== "local" || u.name !== "Ada") {
    throw {code: "TEST_FAIL", message: "ordinary wrapper name collision"};
  }
  return null;
}

export function main(): null { return null; }
