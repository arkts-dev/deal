// @spec: Runtime execution model — Lua backend ABI — exported names
// @description: Exported function names that are normal DEAL identifiers remain callable cross-module
// @expected: runtime-ok
// @features: lua-abi, modules, exports

import * as Lib from "./lua_abi_export_lib"

export function test_export_name_runtime_key(): int {
  let result: int = Lib.normalExport(4);
  if (result !== 8) { throw { code: "TEST_FAIL", message: "export runtime key failed" }; }
  return result;
}
