// @spec: Standard library declarations — std/string errors
// @description: std/string.length rejects a closure-cleared string refinement at its parameter boundary.
// @expected: runtime-error E8001
// @features: stdlib, string, runtime-errors

import * as str from "std/string";

export function test_string_length_dynamic_nonstring(): number {
  let text: string | null = "ok";
  let clear: () => void = function(): void { text = null; };
  if (text !== null) {
    clear();
    return str.length(text);
  }
  throw { code: "TEST_FAIL", message: "string parameter branch skipped" };
}

export function main(): null {
  return null;
}
