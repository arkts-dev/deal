// @spec: Standard library declarations — std/time
// @description: std/time.nowMillis returns epoch milliseconds as number — the v1.3 number return crosses the declared boundary unchanged (no int terminal)
// @expected: runtime-ok
// @features: stdlib, time

import * as time from "std/time";

export function test_time_now_millis_positive(): number {
  let now: number = time.nowMillis();
  if (now <= 0.0) { throw { code: "TEST_FAIL", message: "time.nowMillis not positive" }; }
  if (now < 2147483648.0) { throw { code: "TEST_FAIL", message: "time.nowMillis not above the signed-32 range" }; }
  return now;
}

export function main(): null {
  return null;
}
