// @spec: Standard library declarations — std/console errors
// @description: std/console.log rejects a closure-cleared string refinement at its parameter boundary.
// @expected: runtime-error E8001
// @features: stdlib, console, runtime-errors

import * as console from "std/console";

export function test_console_log_dynamic_nonstring(): null {
  let text: string | null = "ok";
  let clear: () => void = function(): void { text = null; };
  if (text !== null) {
    clear();
    console.log(text);
  }
  return null;
}

export function main(): null {
  return null;
}
