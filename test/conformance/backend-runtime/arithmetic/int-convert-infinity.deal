// @spec: Type system
// @description: Binary64 arithmetic admits and preserves the computed value without signed32 refinement
// @expected: runtime-ok
// @features: runtime, int, conversion, infinity

export function test_int_infinity(): number {
  let one: number = 1.0;
  let zero: number = 0.0;
  let result: number = one / zero;
  if (result !== (one / zero)) {
    throw { code: "TEST_FAIL", message: "binary64 arithmetic value mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
