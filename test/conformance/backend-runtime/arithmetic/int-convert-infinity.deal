// @spec: Runtime execution model — Intrinsic conversions
// @description: int(Infinity) raises E8001 because Infinity is not a valid int value
// @expected: runtime-error E8001
// @features: runtime, int, conversion, infinity

export function test_int_infinity(): int {
  let one: number = 1.0;
  let zero: number = 0.0;
  return int(one / zero);
}
