// @spec: Lexical elements — Operators
// @description: The v1.3 expression-type table admits '%' for int operands only, so a number remainder is rejected at admission (E3007). The v1.2 floor-result subject (-5.0 % 2.0) is retained as a rejection control.
// @expected: compile-error E3007
// @features: types, operators, diagnostics, arithmetic

export function test_number_modulo_floor(): null {
  let n: number = -5.0 % 2.0;
  if (n !== 1.0) { throw { code: "FLOOR_MOD_CHANGED", message: "number modulo" }; }
  return null;
}

export function main(): null {
  return null;
}
