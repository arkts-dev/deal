// @spec: Standard library builtins — Number — Math
// @description: Numeric predicates do not coerce; min/max/round preserve IEEE values and evaluation order.
// @expected: runtime-ok
// @features: number, binary64, builtin

function check(ok:boolean):void {
  if (!ok) { throw {name:"TEST",message:"numeric builtin value"}; }
}

export function main():void {
  check(Number("")===0 && Number(" \t\n\uFEFF\u00A0\u2000\u2029")===0);
  check(Number(" +.5 ")===0.5 && Number("1.")===1 && Number("001.25e+2")===125);
  check(Number("0xFF")===255 && Number("0B101")===5 && Number("0o17")===15);
  check(Number("Infinity")===1/0 && Number("+Infinity")===1/0 && Number("-Infinity")===-1/0);
  check(1/Number("-0")===-1/0 && 1/Number("-1e-9999")===-1/0);
  check(Number("9007199254740993")===9007199254740992 && Number("5e-324")===5e-324);
  check(Number("1e309")===1/0 && Number("1e-310")===1e-310);
  for(let bad of ["1x","1e","0x","0b2","0o8","+0x1","-0b1","1_0","1n","inf","infinity","0x1p2","1f","1\u0000","\uD800","\u0085","\u180E","1 2"]){check(Number.isNaN(Number(bad)));}
  let decimal="0.";let zeros="0.";let k=0;while(k<310){decimal=decimal+"1";if(k<309){zeros=zeros+"0";}k=k+1;}
  check(Number(decimal)===0.1111111111111111 && Number(zeros+"1")===1e-310);
  let once=0;let text=():string=>{once=once+1;return "42";};check(Number(text())===42 && once===1);
  let destination=9;try{destination=Number((():string=>{throw {name:"STOP",message:"conversion"};})());}catch(e){}check(destination===9);
  let nan = 0/0;
  let inf = 1/0;
  check(Number.isFinite(1) && Number.isFinite(-0) && Number.isFinite(5e-324));
  check(!Number.isFinite(nan) && !Number.isFinite(inf) && !Number.isFinite(-inf));
  check(Number.isNaN(nan) && !Number.isNaN(inf) && !Number.isNaN(-0));
  let values:unknown[] = ["1",true,null,undefined,{},[1],():number=>1];
  for (let value of values) { check(!Number.isFinite(value) && !Number.isNaN(value)); }
  check(Math.min(3,-2) === -2 && Math.max(-2,3) === 3);
  check(Math.min(inf,1) === 1 && Math.max(-inf,1) === 1);
  check(Number.isNaN(Math.min(nan,1)) && Number.isNaN(Math.min(1,nan)));
  check(Number.isNaN(Math.max(nan,1)) && Number.isNaN(Math.max(1,nan)));
  check(1/Math.min(0,-0) === -inf && 1/Math.min(-0,0) === -inf);
  check(1/Math.max(0,-0) === inf && 1/Math.max(-0,0) === inf);
  check(1/Math.max(-0,-0) === -inf && 1/Math.min(0,0) === inf);
  check(Math.round(1.5) === 2 && Math.round(2.5) === 3 && Math.round(-1.5) === -1);
  check(Math.round(0.49999999999999994) === 0 && Math.round(-0.5000000000000001) === -1);
  check(1/Math.round(-0.5) === -inf && 1/Math.round(-5e-324) === -inf);
  check(1/Math.round(-0) === -inf && 1/Math.round(0) === inf);
  check(Math.round(inf) === inf && Math.round(-inf) === -inf && Number.isNaN(Math.round(nan)));
  check(Math.round(4503599627370495.5) === 4503599627370496);
  check(Math.round(4503599627370497) === 4503599627370497);
  let order = "";
  let mark = (text:string,value:number):number=>{order=order+text;return value;};
  check(Number.isNaN(Math.min(mark("a",nan),mark("b",1))) && order === "ab");
  order = "";
  check(Math.max(mark("a",1),mark("b",2)) === 2 && order === "ab");
  let fail = ():number=>{order=order+"x";throw {name:"STOP",message:"stop"};};
  order = "";
  try { Math.min(fail(),mark("b",2)); } catch(e) { check(order === "x"); }
  check(order === "x");
  return ;
}
