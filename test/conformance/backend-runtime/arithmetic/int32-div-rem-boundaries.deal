// @spec: Type system
// @description: Binary64 arithmetic admits and preserves the computed value without signed32 refinement
// @expected: runtime-ok
// @features: int32, arithmetic, errors, evaluation-order

export function main(): null {
  if (5 / 2 !== 2.5 || -5 / 2 !== -2.5) {
    throw { code: "TEST_FAIL", message: "signed division or remainder mismatch" };
  }

  let trace: string = "";
  function lhs(): number { trace = trace + "L"; return -2147483648; }
  function rhs(): number { trace = trace + "R"; return -1; }

  let result: number = lhs() / rhs();
  trace = trace + "X";
  if (result !== 2147483648 || trace !== "LRX") {
    throw { code: "TEST_FAIL", message: "binary64 division value or operand order" };
  }
  return null;
}
