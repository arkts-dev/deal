// @spec: Lexical elements — Operators
// @description: Exponentiation is unsupported; diagnose the complete '**' operator at admission (E1042). The v1.2 runtime subject (a zero int exponent returning one) is retained as a rejection control.
// @expected: compile-error E1042
// @features: parser, operators, diagnostics, arithmetic

export function test_int_power_zero(): null {
  let value: number = 7 ** 0;
  if (value !== 1) { throw { name: "TEST_FAIL", message: "integer zero exponent did not return one" }; }
  return null;
}

export function main(): void { test_int_power_zero(); }
