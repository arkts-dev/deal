// @spec: Lexical elements — Operators
// @description: The v1.3 operator set has no exponentiation: '**' lexes as two '*' operators and the second one has no operand, so the removed-operator subject is rejected at admission (E1037). The v1.2 runtime subject (a zero int exponent returning one) is retained as a rejection control.
// @expected: compile-error E1037
// @features: parser, operators, diagnostics, arithmetic

export function test_int_power_zero(): null {
  let value: int = 7 ** 0;
  if (value !== 1) { throw { code: "TEST_FAIL", message: "integer zero exponent did not return one" }; }
  return null;
}

export function main(): null { return test_int_power_zero(); }
