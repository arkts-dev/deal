// @spec: Lexical elements
// @description: Integer exponentiation with exponent zero returns one
// @expected: runtime-ok
// @features: arithmetic, int32, exponentiation

export function test_int_power_zero(): null {
  let value: int = 7 ** 0;
  if (value !== 1) { throw { code: "TEST_FAIL", message: "integer zero exponent did not return one" }; }
  return null;
}

export function main(): null { return test_int_power_zero(); }
