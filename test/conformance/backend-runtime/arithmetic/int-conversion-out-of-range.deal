// @spec: Runtime execution model — Intrinsic conversions
// @description: int() of a finite number outside the signed 32-bit range raises E8004 — int(2147483648.0) and int(-2147483649.0) (v1.2)
// @expected: runtime-error E8004
// @features: runtime, int, conversion, overflow, v1.2

export function test_int_conversion_out_of_range(): int {
  return int(2147483648.0);
}

export function test_int_conversion_out_of_range_negative(): int {
  return int(-2147483649.0);
}

export function main(): null {
  return null;
}
