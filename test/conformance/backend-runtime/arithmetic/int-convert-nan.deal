// @spec: Type system
// @description: Binary64 arithmetic admits and preserves the computed value without signed32 refinement
// @expected: runtime-ok
// @features: runtime, int, conversion, nan

export function test_int_nan(): number {
  let z: number = 0.0;
  let n: number = z / z;
  if (n === n) { throw { code: "TEST_FAIL", message: "zero divided by zero must be NaN" }; }
  return n;
}

export function main(): null {
  return null;
}
