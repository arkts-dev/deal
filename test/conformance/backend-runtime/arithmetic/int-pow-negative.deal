// @spec: Lexical elements — Operators
// @description: The v1.3 operator set has no exponentiation: '**' lexes as two '*' operators and the second one has no operand, so the removed-operator subject is rejected at admission (E1037). The v1.2 runtime subject (a negative int exponent raising E8006) is retained as a rejection control.
// @expected: compile-error E1037
// @features: parser, operators, diagnostics, arithmetic

export function test_int_pow_negative(): number {
  return 2 ** -1;
}

