// @spec: Type system
// @description: Binary64 arithmetic admits and preserves the computed value without signed32 refinement
// @expected: runtime-ok
// @features: runtime, int, conversion

export function test_int_fraction(): number {
  let result: number = 3.5;
  if (result !== (3.5)) {
    throw { code: "TEST_FAIL", message: "binary64 arithmetic value mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
