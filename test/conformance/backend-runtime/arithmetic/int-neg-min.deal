// @spec: Type system
// @description: Binary64 arithmetic admits and preserves the computed value without signed32 refinement
// @expected: runtime-ok
// @features: runtime, int, overflow, v1.2

export function test_int_neg_min(): number {
  let result: number = -(-2147483648);
  if (result !== (2147483648)) {
    throw { code: "TEST_FAIL", message: "binary64 arithmetic value mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
