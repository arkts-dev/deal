import * as math from "std/math";
// @spec: Control flow — Runtime errors in loops
// @description: Runtime error inside while loop propagates with its error code
// @expected: runtime-error E8002
// @features: control-flow, loops, runtime-errors

export function test_error_inside_while_loop(): number {
  let i: number = 0;
  while (i < 2) {
    if (i === 1) { return [1][1]; }
    i = i + 1;
  }
  return 0;
}

export function main(): null {
  return null;
}
