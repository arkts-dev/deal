      { v14Loop0 = i; v14Loop0 = v14Loop0 + 1; continue; }
    }
    total = total + i;
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  if (total !== 2) { throw { code: "TEST_FAIL", message: "continue after caught error failed" }; }
  return total;
}

