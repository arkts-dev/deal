import * as math from "std/math";
// @spec: Control flow — Runtime errors in for-of
// @description: Runtime error inside for-of loop propagates with its error code
// @expected: runtime-error E8001
// @features: control-flow, for-of, runtime-errors

export function test_error_inside_for_of(): number {
  let xs: number[] = [1, 2, 0];
  for (let x: number of xs) {
    if (x === 0) { return math.sqrt(-1); }
  }
  return 0;
}

export function main(): null {
  return null;
}
