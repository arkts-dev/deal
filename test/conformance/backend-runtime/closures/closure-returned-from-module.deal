// @spec: Modules, declarations, standard library, and host ABI — Closures returned from modules
// @description: A closure returned by an imported function retains its captured module-local state
// @expected: runtime-ok
// @features: closures, modules

import * as Lib from "./closure_batch2_lib";

export function test_closure_returned_from_module(): number {
  let c: () => number = Lib.makeCounter(10);
  let a: number = c();
  let b: number = c();
  if (a !== 11 || b !== 12) { throw { code: "TEST_FAIL", message: "module closure state failed" }; }
  return b;
}

export function main(): null {
  return null;
}
