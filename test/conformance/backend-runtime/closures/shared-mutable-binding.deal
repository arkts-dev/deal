// @spec: Functions — Closures and mutable captured locals
// @description: Multiple closures over the same local share the same mutable binding
// @expected: runtime-ok
// @features: closures, mutation

export function test_shared_closure_binding(): number {
  let x: number = 0;
  let inc: () => number = function(): number { x = x + 1; return x; };
  let read: () => number = function(): number { return x; };
  inc();
  inc();
  let result: number = read();
  if (result !== 2) { throw { code: "TEST_FAIL", message: "shared closure binding failed" }; }
  return result;
}

export function main(): null {
  return null;
}
