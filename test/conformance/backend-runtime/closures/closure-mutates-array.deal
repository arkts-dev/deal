// @spec: Functions — Closures mutating arrays
// @description: A closure mutating an array captures the shared array binding
// @expected: runtime-ok
// @features: closures, arrays, mutation

export function test_closure_mutates_array(): number {
  let xs: number[] = [1, 2];
  let bump: () => number = function(): number {
    xs[0] = xs[0] + 5;
    return xs[0];
  };
  bump();
  let result: number = xs[0];
  if (result !== 6) { throw { code: "TEST_FAIL", message: "closure array mutation failed" }; }
  return result;
}

export function main(): null {
  return null;
}
