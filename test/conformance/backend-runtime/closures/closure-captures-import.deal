// @spec: Modules, declarations, standard library, and host ABI — Imported functions and closures
// @description: A closure can capture and call an imported function binding
// @expected: runtime-ok
// @features: closures, modules, imports

import * as Lib from "./closure_import_lib";

export function test_closure_import_capture(): number {
  let base: number = 5;
  let f: (x: number) => number = function(x: number): number {
    return Lib.add(base, x);
  };
  let result: number = f(7);
  if (result !== 12) { throw { code: "TEST_FAIL", message: "closure import capture failed" }; }
  return result;
}

export function main(): null {
  return null;
}
