// @spec: Functions — Closures and captured variables
// @description: For-loop closures stored in an array capture per-iteration values
// @expected: runtime-ok
// @features: closures, for-loop, arrays

export function test_loop_closure_sum(): number {
  let fs: (() => number)[] = [function(): number { return -1; }, function(): number { return -1; }, function(): number { return -1; }, function(): number { return -1; }];
  { let v14Loop0: number = 0; while (v14Loop0 < 4) { let i: number = v14Loop0; {
    fs[i] = function(): number { return i; };
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  let total: number = fs[0]() + fs[1]() + fs[2]() + fs[3]();
  if (total !== 6) { throw { code: "TEST_FAIL", message: "loop closure binding failed" }; }
  return total;
}

export function main(): null {
  return null;
}
