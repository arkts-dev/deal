// @spec: Bytes — Recursive array/nullable closure
// @description: A closure captures a int[] buffer and writes through it; the write is visible through the captured reference (v1.2 defect snippet 68)
// @expected: runtime-ok
// @features: int[], closures, capture, v1.2

export function test_bytes_captured_closure(): null {
  let b: int[] = [0];
  let set: (n: int) => null = function(n: int): null {
    b[0] = n;
    return null;
  };
  set(255);
  if (b[0] !== 255) { throw { code: "TEST_FAIL", message: "int[] capture" }; }
  return null;
}

export function main(): null {
  return null;
}
