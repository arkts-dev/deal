// @spec: Functions — Closures and captured variables
// @description: Nested closures capture outer locals and observe mutation through the captured binding
// @expected: runtime-ok
// @features: closures, mutation

export function test_nested_closure_mutation(): number {
  let x: number = 1;
  let make: () => () => number = function(): () => number {
    return function(): number {
      return x;
    };
  };
  let f: () => number = make();
  x = 9;
  let result: number = f();
  if (result !== 9) { throw { code: "TEST_FAIL", message: "closure mutation failed" }; }
  return result;
}

export function main(): null {
  return null;
}
