// @spec: Functions — Function type compatibility; Arity extension adapter
// @description: An async function value whose declared type is itself an adapter's adapts at a wider async position: the assignment control makes the position's source an assigned binding cell, the adapter-of-adapter invocation descends each level's own leading-M projection, the async marker and the ignored target parameters are preserved, and every adapted invocation completes with the innermost source's result.
// @expected: runtime-ok
// @features: functions, arity-extension, async-await

import * as console from "std/console";

function check(condition: boolean, message: string): null {
  if (!condition) {
    throw { code: "TEST_FAIL", message: message };
  }
  return null;
}

async function base(x: number): Promise<number> { return x + 40; }

async function zero(): Promise<number> { return 41; }

async function widen(): Promise<(x: number) => Promise<number>> {
  let inner: (x: number) => Promise<number> = zero;
  return inner;
}

export async function test_arity_extension_async_adapter_source(): Promise<number> {
  let source: (x: number) => Promise<number> = zero;
  let handed: (x: number) => Promise<number> = zero;
  source = handed;
  let widened: (x: number, y: number) => Promise<number> = source;
  let first: number = await widened(1, 2);
  check(first === 41, "an assigned adapter-valued async source descends its chain");

  let exact: (x: number) => Promise<number> = base;
  let widenedExact: (x: number, y: number) => Promise<number> = exact;
  let second: number = await widenedExact(1, 2);
  check(second === 41, "the exact async source control adapts once");

  let returned: (x: number) => Promise<number> = await widen();
  let widenedReturned: (x: number, y: number) => Promise<number> = returned;
  let third: number = await widenedReturned(1, 2);
  check(third === 41, "a zero-to-one adapter value returned from an async function adapts");

  console.log("ASYNC ADAPTER SOURCE OK");
  return first + second + third;
}

export function main(): null {
  return null;
}
