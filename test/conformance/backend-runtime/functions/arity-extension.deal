// @spec: Functions — Function type compatibility
// @description: Arity extension: shorter function assigned to longer target
// @expected: runtime-ok
// @features: functions, arity

function one(x: number): number { return x; }

export function test_arity(): number {
  let takesTwo: (x: number, y: number) => number = one;
  let result: number = takesTwo(10, 20);
  if (result !== 10) {
    throw { code: "TEST_FAIL", message: "arity-extension: extended call result mismatch" };
  }
  return result;
}

export function main(): null {
  return null;
}
