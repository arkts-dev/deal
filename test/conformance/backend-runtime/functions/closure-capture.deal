// @spec: Functions — Closures and captured variables
// @description: Closure captures variable by binding, sees current value
// @expected: runtime-ok
// @features: functions, closures

export function test_closure(): number {
  let x: number = 1;
  let f: () => number = function(): number {
    return x;
  };
  x = 2;
  let result: number = f(); // closure invoked once after x = 2
  if (result !== 2) {
    throw { code: "TEST_FAIL", message: "closure capture result mismatch after x = 2" };
  }
  return result; // should return 2
}

export function main(): null {
  return null;
}
