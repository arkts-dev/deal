// @spec: Functions — Arity extension adapter
// @description: A value that is already an adapter is never adapted again: the position keeps its own exact-signature cell, so a second arity-extension position over an adapted binding reports the pinned E8010 signature mismatch instead of stacking adapters.
// @expected: runtime-error E8010
// @features: functions, arity-extension, descriptors, runtime-errors

function one(x: int): int { return x; }

function needTriple(f: (x: int, y: int, z: int) => int): int { return f(1, 2, 3); }

export function main(): null {
  let pair: (x: int, y: int) => int = one;
  let r: int = needTriple(pair);
  return null;
}
