// @spec: Functions — Function values and recursive functions
// @description: Function values can call a hoisted recursive function binding
// @expected: runtime-ok
// @features: functions, recursion, function-values

function factorial(n: int): int {
  if (n === 0) { return 1; }
  return n * factorial(n - 1);
}

export function test_recursive_function_value(): int {
  let f: (x: int) => int = factorial;
  let result: int = f(5);
  if (result !== 120) { throw { code: "TEST_FAIL", message: "factorial failed" }; }
  return result;
}

export function main(): null {
  return null;
}
