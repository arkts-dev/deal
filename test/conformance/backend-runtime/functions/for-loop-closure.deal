// @spec: Functions — Closures and captured variables
// @description: For-loop creates per-iteration closure binding
// @expected: runtime-ok
// @features: functions, closures, for-loop

export function test_for_closure(): number {
  let f0: (() => number) = function(): number { return -1; };
  let f1: (() => number) = function(): number { return -1; };
  let f2: (() => number) = function(): number { return -1; };
  { let v14Loop0: number = 0; while (v14Loop0 < 3) { let i: number = v14Loop0; {
    if (i === 0) { f0 = function(): number { return i; }; }
    if (i === 1) { f1 = function(): number { return i; }; }
    if (i === 2) { f2 = function(): number { return i; }; }
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  let v0: number = f0(); // each captured closure invoked once
  let v1: number = f1();
  let v2: number = f2();
  if (v0 !== 0) {
    throw { code: "TEST_FAIL", message: "for-loop closure f0 captured value mismatch" };
  }
  if (v1 !== 1) {
    throw { code: "TEST_FAIL", message: "for-loop closure f1 captured value mismatch" };
  }
  if (v2 !== 2) {
    throw { code: "TEST_FAIL", message: "for-loop closure f2 captured value mismatch" };
  }
  return v0 * 100 + v1 * 10 + v2; // should return 12
}

export function main(): null {
  return null;
}
