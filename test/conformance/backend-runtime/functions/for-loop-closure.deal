// @spec: Functions — Closures and captured variables
// @description: For-loop creates per-iteration closure binding
// @expected: runtime-ok
// @features: functions, closures, for-loop

export function test_for_closure(): int {
  let f0: (() => int) = function(): int { return -1; };
  let f1: (() => int) = function(): int { return -1; };
  let f2: (() => int) = function(): int { return -1; };
  for (let i: int = 0; i < 3; i = i + 1) {
    if (i === 0) { f0 = function(): int { return i; }; }
    if (i === 1) { f1 = function(): int { return i; }; }
    if (i === 2) { f2 = function(): int { return i; }; }
  }
  let v0: int = f0(); // each captured closure invoked once
  let v1: int = f1();
  let v2: int = f2();
  if (v0 !== 0) {
    throw { code: "TEST_FAIL", message: "for-loop closure f0 captured value mismatch" };
  }
  if (v1 !== 1) {
    throw { code: "TEST_FAIL", message: "for-loop closure f1 captured value mismatch" };
  }
  if (v2 !== 2) {
    throw { code: "TEST_FAIL", message: "for-loop closure f2 captured value mismatch" };
  }
  return v0 * 100 + v1 * 10 + v2; // should return 12
}

export function main(): null {
  return null;
}
