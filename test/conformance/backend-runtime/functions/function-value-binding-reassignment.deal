// @spec: Functions — Closures and captured variables
// @description: An assigned function-typed binding is read by binding: the closure body, a nested capture, an alias of a later read, the repeated loop condition and a post-branch call dispatch on the current function value, while never-assigned, recursive and mutually recursive callees stay statically resolved
// @expected: runtime-ok
// @features: functions, closures, mutation, loops, recursion, arity

import * as console from "std/console";
import * as json from "std/json";

function one(): number { return 1; }
function two(): number { return 2; }
function bump(x: number): number { return x + 1; }

function fib(n: number): number {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}

function isEven(n: number): boolean {
  if (n === 0) { return true; }
  return isOdd(n - 1);
}

function isOdd(n: number): boolean {
  if (n === 0) { return false; }
  return isEven(n - 1);
}

function check(condition: boolean, message: string): null {
  if (!condition) {
    throw { code: "TEST_FAIL", message: message };
  }
  return null;
}

// The captured read: the closure body calls the binding's current value.
export function test_captured_function_binding(): number {
  let f: () => number = one;
  let call: () => number = function(): number { return f(); };
  f = two;
  let result: number = call();
  check(result === 2, "the captured read observes the current binding");
  return result;
}

// The repeated loop condition: the assignment inside the body governs the
// next iteration's condition. The visits guard bounds the loop, so a stale
// callee terminates after at most five iterations instead of never.
export function test_loop_function_binding(): number {
  let f: () => number = one;
  let visits: number = 0;
  while (f() === 1 && visits < 5) {
    visits = visits + 1;
    f = two;
  }
  check(visits === 1, "the loop condition observes the current binding");
  return visits;
}

// The nested capture: a closure body nested inside another closure body
// reads the enclosing binding's current value.
export function test_nested_capture_function_binding(): number {
  let f: () => number = one;
  let outer: () => (() => number) = function(): (() => number) {
    return function(): number { return f(); };
  };
  f = two;
  let inner: () => number = outer();
  let result: number = inner();
  check(result === 2, "the nested capture read observes the current binding");
  return result;
}

// The alias: a copied value keeps the function value it copied, while a read
// of the source binding observes the current one — including when the store
// sits on a conditional path.
export function test_alias_function_binding(): number {
  let f: () => number = one;
  let copied: () => number = f;
  f = two;
  let copiedValue: number = copied();
  let currentValue: number = f();
  let cond: boolean = false;
  let branchy: () => number = one;
  if (cond) { branchy = two; }
  let branchAlias: () => number = branchy;
  let branchValue: number = branchAlias();
  check(copiedValue === 1, "the alias keeps the copied function value");
  check(currentValue === 2, "the source read observes the current value");
  check(branchValue === 1, "the branch alias copies the taken path's value");
  return copiedValue * 100 + currentValue * 10 + branchValue;
}

// The conditional store: a call after the branch observes the value of the
// path that ran.
export function test_branch_function_binding(): number {
  let f: () => number = one;
  let cond: boolean = false;
  if (cond) { f = two; }
  let result: number = f();
  check(result === 1, "the post-branch call observes the taken path");
  return result;
}

// The positive static controls: a never-assigned binding, direct recursion
// and mutual recursion keep their statically resolved callees.
export function test_static_function_controls(): number {
  let stable: () => number = two;
  let stableValue: number = stable();
  let recursive: number = fib(10);
  let mutual: boolean = isEven(10);
  check(stableValue === 2, "the never-assigned binding stays callable");
  check(recursive === 55, "direct recursion");
  check(mutual, "mutual recursion");
  return stableValue + recursive;
}

// The arity-extension control: the adapter keeps its own source mode.
export function test_arity_extension_control(): number {
  let src: (x: number) => number = bump;
  let widened: (x: number, y: number) => number = src;
  src = bump;
  let result: number = widened(3, 4);
  check(result === 4, "arity extension keeps the source value");
  return result;
}

export function main(): null {
  let captured: number = test_captured_function_binding();
  let visits: number = test_loop_function_binding();
  let nested: number = test_nested_capture_function_binding();
  let alias: number = test_alias_function_binding();
  let afterBranch: number = test_branch_function_binding();
  let staticControls: number = test_static_function_controls();
  let widened: number = test_arity_extension_control();
  console.log(json.stringify({
    captured: captured === 2,
    visits: visits === 1,
    nested: nested === 2,
    alias: alias === 121,
    afterBranch: afterBranch === 1,
    staticControls: staticControls === 57,
    widened: widened === 4
  }));
  return null;
}
