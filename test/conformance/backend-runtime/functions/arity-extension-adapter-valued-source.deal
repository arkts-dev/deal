// @spec: Functions — Function type compatibility; Arity extension adapter
// @description: A function value whose declared type is a shorter signature adapts at a further statically typed position, whether the source value was itself produced by an arity-extension adapter: the binding, field, array element, argument and return positions each add exactly one adapter over the value's declared signature and the nested invocation protocol forwards only each level's leading parameters. Reassigning the parameter does not change the already adapted function value.
// @expected: runtime-ok
// @features: functions, arity-extension, classes, arrays, closures

import * as console from "std/console";

class Marker {
  count: number;
}

class Holder {
  pair: (x: number, y: number) => number;
}

function check(condition: boolean, message: string): null {
  if (!condition) {
    throw { code: "TEST_FAIL", message: message };
  }
  return null;
}

function one(x: number): number { return x; }

function zero(): number { return 41; }

function needTriple(f: (x: number, y: number, z: number) => number): number { return f(1, 2, 3); }

function needPair(f: (x: number, y: number) => number): number { return f(3, 4); }

function passTriple(f: (x: number, y: number, z: number) => number): number { return f(4, 5, 6); }

function bump(marker: Marker): number {
  marker.count = marker.count + 1;
  return 2;
}

function widenPair(f: (x: number, y: number) => number): (x: number, y: number, z: number) => number {
  let widened: (x: number, y: number, z: number) => number = f;
  f = function(x: number, y: number): number { return x + y; };
  return widened;
}

function widenZero(f: () => number): (x: number, y: number) => number {
  return f;
}

function escapingCall(f: (x: number, y: number) => number): () => number {
  let widened: (x: number, y: number, z: number) => number = f;
  f = function(x: number, y: number): number { return x + y; };
  let call: () => number = function(): number { return widened(7, 8, 9); };
  return call;
}

export function main(): null {
  // --- a parameter position over an adapted binding ------------------------
  let pair: (x: number, y: number) => number = one;
  check(needTriple(pair) === 1, "an adapted binding adapts again at a parameter");
  check(passTriple(pair) === 4,
    "the second adapter forwards only the declared source's leading parameters");

  // --- a class-field source -----------------------------------------------
  let holder: Holder = {pair: one};
  check(needTriple(holder.pair) === 1, "an adapted field value adapts at a parameter");

  // --- an array-element source --------------------------------------------
  let pairs: ((x: number, y: number) => number)[] = [one];
  check(needTriple(pairs[0]) === 1, "an adapted array element adapts at a parameter");

  // --- a return position ---------------------------------------------------
  let widened: (x: number, y: number, z: number) => number = widenPair(pair);
  check(widened(7, 8, 9) === 7,
    "an escaped adapter retains its evaluated source value");
  let call: () => number = escapingCall(pair);
  check(call() === 7,
    "an escaped closure invokes the saved adapter value");

  // --- an assignment position ---------------------------------------------
  let assigned: (x: number, y: number, z: number) => number = one;
  assigned = pair;
  check(assigned(8, 9, 10) === 8, "an adapted value adapts at an assignment position");

  // --- a zero-to-one chain -------------------------------------------------
  let zeroValue: () => number = zero;
  let oneWide: (x: number) => number = zeroValue;
  let twoWide: (x: number, y: number) => number = oneWide;
  check(twoWide(9, 10) === 41, "a zero-to-one chain keeps each level's marker");

  // --- once-only evaluation of the ignored target argument -----------------
  let marker: Marker = {count: 0};
  let short: (x: number, y: number) => number = one;
  let wide: (x: number, y: number, z: number) => number = short;
  check(wide(3, bump(marker), 9) === 3,
    "the ignored third parameter is evaluated and never forwarded");
  check(marker.count === 1, "the ignored third parameter evaluates exactly once");

  // --- an exact adapted value keeps its own working identity ---------------
  let exact: (x: number, y: number) => number = pair;
  check(needPair(exact) === 3, "an exact target stores the adapted value directly");

  console.log("OK");
  return null;
}
