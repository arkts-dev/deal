// @spec: Runtime execution model
// @description: Lone UTF-16 Error message survives a reached return boundary and host repair
// @expected: runtime-ok
// @features: boundary-validation, host-abi
import * as printer from "std/console";
import * as host from "host/probe";
function take(e:Error):void{printer.log("PARAM_BODY");}
export function main():null{let e:Error={code:"X",message:"m"};let original:Error={code:"OLD",message:"old"};let destination=original;let alias=e;let get: () => Error = function():Error{printer.log("RETURN_BODY");return e;};host.edit(e);let returned=get();if(returned!==alias || returned.message!==`\uD800`){throw {code:"TEST",message:"lone message return lost value or identity"};}printer.log("ACCEPT");host.repair();if(e!==alias || destination!==original || returned.message!=="repaired"){throw {code:"TEST",message:"repair lost alias or unrelated destination"};}printer.log("IDENTITY");take(e);printer.log("RECOVERED");return null;}
