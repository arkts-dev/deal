// @spec: Runtime execution model
// @description: external-live-unknown-unknown-write
// @expected: runtime-ok
// @features: boundary-validation
import * as console from "std/console";
import * as host from "host/probe";

export function main():null{let n:host.C={x:1};host.mutate(n);let v=n.x as number;if(v===9){console.log("LIVE");}else{console.log("STALE");}return null;}