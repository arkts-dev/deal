// @spec: Runtime execution model
// @description: Lone UTF-16 Error message survives Record graph admission with live aliases
// @expected: runtime-ok
// @features: boundary-validation, host-abi
import * as console from "std/console";
import * as host from "host/probe";

export function main():null {
  let e:Error={code:"X",message:"original"};
  let alias=e;
  let original:Record<string,unknown>={};
  let destination=original;
  host.edit(e);
  destination={unread:e};
  let admitted=destination.unread as Error;
  if(admitted!==alias || admitted.message!==`\uD800` || destination===original) {
    throw {code:"TEST",message:"Record admission lost lone message or identity"};
  }
  console.log("ACCEPT");
  host.repair();
  if(e!==alias || admitted.message!=="repaired") {
    throw {code:"TEST",message:"Record alias did not observe repair"};
  }
  console.log("IDENTITY");
  destination={unread:e};
  console.log("RECOVERED");
  return null;
}
