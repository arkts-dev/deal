// @spec: Runtime execution model
// @description: Revalidate retained graph at state-callable-return
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as host from "host/probe";
class B{r:Record<string,unknown>;}function consume(r:Record<string,unknown>):void{printer.log("PARAM_BODY");}
export function main():null{let r:Record<string,unknown>={};r.self=r;let old:Record<string,unknown>={};let d=old;let b:B={r:old};let xs:Record<string,unknown>[]=[old];let get: () => Record<string,unknown> = function():Record<string,unknown>{printer.log("RETURN_BODY");return r;};host.corrupt(r);try{get();printer.log("ACCEPT");}catch(e){printer.log("REJECT");}host.repair();if(d===old){printer.log("UNCHANGED");}else{printer.log("STORED");}consume(r);printer.log("RECOVERED");return null;}
