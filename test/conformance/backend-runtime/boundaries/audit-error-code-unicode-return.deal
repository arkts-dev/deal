// @spec: Runtime execution model
// @description: Lone UTF-16 Error name survives a reached return boundary and host repair
// @expected: runtime-ok
// @features: boundary-validation, host-abi
import * as printer from "std/console";
import * as host from "host/probe";
function take(e:Error):void{printer.log("PARAM_BODY");}
export function main():void{let e:Error={name:"X",message:"m"};let original:Error={name:"OLD",message:"old"};let destination=original;let alias=e;let get: () => Error = function():Error{printer.log("RETURN_BODY");return e;};host.edit(e);let returned=get();if(returned!==alias || returned.name!==`\uD800`){throw {name:"TEST",message:"lone name return lost value or identity"};}printer.log("ACCEPT");host.repair();if(e!==alias || destination!==original || returned.name!=="repaired"){throw {name:"TEST",message:"repair lost alias or unrelated destination"};}printer.log("IDENTITY");take(e);printer.log("RECOVERED");return ;}
