// @spec: Runtime execution model
// @description: Revalidate retained graph at state-unicode-parameter
// @expected: runtime-ok
// @features: boundary-validation
import * as console from "std/console";
import * as host from "host/probe";
class B{r:Record<string,unknown>;}function consume(r:Record<string,unknown>):void{console.log("PARAM_BODY");}
export function main():null{let r:Record<string,unknown>={};r.self=r;let old:Record<string,unknown>={};let d=old;let b:B={r:old};let xs:Record<string,unknown>[]=[old];let get: () => Record<string,unknown> = function():Record<string,unknown>{console.log("RETURN_BODY");return r;};host.corrupt(r);consume(r);if(r.self!==(r as unknown) || (r.bad as string)!==`\uD800`){throw {code:"TEST",message:"parameter lost lone graph"};}console.log("ACCEPT");host.repair();if(Object.hasOwn(r,"bad")){throw {code:"TEST",message:"parameter alias did not observe repair"};}if(d===old && b.r===old && xs[0]===old){console.log("UNCHANGED");}else{console.log("STORED");}consume(r);console.log("RECOVERED");return null;}
