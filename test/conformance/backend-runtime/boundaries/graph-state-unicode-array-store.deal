// @spec: Runtime execution model
// @description: Revalidate retained graph at state-unicode-array-store
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as host from "host/probe";
class B{r:Record<string,unknown>;}function consume(r:Record<string,unknown>):void{printer.log("PARAM_BODY");}
export function main():null{let r:Record<string,unknown>={};r.self=r;let old:Record<string,unknown>={};let d=old;let b:B={r:old};let xs:Record<string,unknown>[]=[old];let get: () => Record<string,unknown> = function():Record<string,unknown>{printer.log("RETURN_BODY");return r;};host.corrupt(r);xs[0]=r;if(xs[0]!==r || xs[0].self!==(r as unknown) || (xs[0].bad as string)!==`\uD800` || d!==old || b.r!==old){throw {code:"TEST",message:"lone graph element store changed value, aliases or unrelated destinations"};}printer.log("ACCEPT");host.repair();if(xs[0]!==r || Object.hasOwn(xs[0],"bad")){throw {code:"TEST",message:"retained element did not observe repair"};}printer.log("STORED");xs[0]=r;if(xs[0]!==r){throw {code:"TEST",message:"retry lost identity"};}consume(r);printer.log("RECOVERED");return null;}
