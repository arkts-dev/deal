// @spec: Runtime execution model
// @description: cyclic-class-wrong-field-store
// @expected: runtime-ok
// @features: boundary-validation
import * as console from "std/console";
import * as host from "host/probe";
class Node{x:number;next:Node|null;}class Box{n:Node;}function consume(n:Node):void{}function identity(n:Node):Node{return n;}
export function main():null{let n:Node={x:1,next:null};n.next=n;let old:Node={x:2,next:null};let b:Box={n:old};host.mutate(n);try{b.n=n;console.log("OK");}catch(e){console.log("REJECT");}if(b.n!==old){throw {code:"TEST",message:"rejected store changed destination"};}return null;}