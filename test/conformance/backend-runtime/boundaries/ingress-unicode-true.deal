import * as printer from "std/console";
import * as host from "host/probe";

export function main():null{let u=host.f();let r=u as Record<string,unknown>;if((r.x as string)!==`\uD800`){throw {code:"TEST",message:"lone nested string lost"};}printer.log("PUBLISHED");return null;}