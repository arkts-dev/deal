// @spec: Runtime execution model
// @description: Revalidate retained graph at async-unicode-field-store
// @expected: runtime-ok
// @features: boundary-validation
import * as host from "host/probe";
class B{r:Record<string,unknown>;}export function main():null{return null;}export async function run():Promise<number>{let r:Record<string,unknown>={};r.self=r;let old:Record<string,unknown>={};let b:B={r:old};let get: () => Record<string,unknown> = function():Record<string,unknown>{return r;};await host.mutate(r);b.r=r;if(b.r!==r || b.r===old || b.r.self!==(r as unknown) || (b.r.bad as string)!==`\uD800`){throw {code:"TEST",message:"async field store lost graph or lone unit"};}return 1;}
