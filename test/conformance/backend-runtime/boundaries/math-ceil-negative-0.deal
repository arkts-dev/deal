// @spec: Runtime execution model
// @description: math-ceil--0
// @expected: runtime-ok
// @features: boundary-validation
import * as console from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.ceil(-0);if(1/x===-1/0){console.log("NEGZERO");}else{console.log("WRONG");}}catch(e){console.log("THREW");}return null;}