// @spec: Runtime execution model
// @description: Revalidate retained graph at async-unicode-return
// @expected: runtime-ok
// @features: boundary-validation
import * as host from "host/probe";
class B{r:Record<string,unknown>;}export function main():null{return null;}export async function run():Promise<number>{let r:Record<string,unknown>={};r.self=r;let b:B={r:r};let get: () => Record<string,unknown> = function():Record<string,unknown>{return r;};await host.mutate(r);let returned=get();if(returned!==r || returned.self!==(r as unknown) || (returned.bad as string)!==`\uD800`){throw {code:"TEST",message:"async return lost graph or lone unit"};}return 1;}
