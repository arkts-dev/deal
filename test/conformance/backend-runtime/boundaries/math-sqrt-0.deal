// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.sqrt(0);if(x===(0)){printer.log("OK");}else{printer.log("WRONG");}}catch(e){printer.log("THREW");}return null;}