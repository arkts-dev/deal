// @spec: Runtime execution model
// @description: error code valid parameter
// @expected: runtime-ok
// @features: boundary-validation, host-abi
import * as console from "std/console";
import * as host from "host/probe";
function take(e:Error):void{console.log("PARAM_BODY");}
export function main():null{let e:Error={code:"X",message:"m"};let original:Error={code:"OLD",message:"old"};let destination=original;let alias=e;function get():Error{console.log("RETURN_BODY");return e;}host.edit(e);try{take(e);console.log("ACCEPT");}catch(x){if(x instanceof Error){console.log(x.code);}else{console.log("NOT_ERROR");}}host.repair();if(e===alias && destination===original){console.log("IDENTITY");}take(e);console.log("RECOVERED");return null;}
