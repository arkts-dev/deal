// @spec: Runtime execution model
// @description: async-sqrt--1
// @expected: runtime-ok
// @features: boundary-validation
import * as m from "std/math";
export async function run():Promise<number>{try{let x=m.sqrt(-1);if(x!==x){return 1;}return 0;}catch(e){return 0;}}
export function main():null{return null;}