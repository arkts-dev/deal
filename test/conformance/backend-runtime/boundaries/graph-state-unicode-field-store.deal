// @spec: Runtime execution model
// @description: Revalidate retained graph at state-unicode-field-store
// @expected: runtime-ok
// @features: boundary-validation
import * as console from "std/console";
import * as host from "host/probe";
class B{r:Record<string,unknown>;}function consume(r:Record<string,unknown>):void{console.log("PARAM_BODY");}
export function main():null{let r:Record<string,unknown>={};r.self=r;let old:Record<string,unknown>={};let d=old;let b:B={r:old};let xs:Record<string,unknown>[]=[old];let get: () => Record<string,unknown> = function():Record<string,unknown>{console.log("RETURN_BODY");return r;};host.corrupt(r);b.r=r;if(b.r!==r || b.r.self!==(r as unknown) || (b.r.bad as string)!==`\uD800` || d!==old || xs[0]!==old){throw {code:"TEST",message:"lone graph field store changed value, aliases or unrelated destinations"};}console.log("ACCEPT");host.repair();if(b.r!==r || Object.hasOwn(b.r,"bad")){throw {code:"TEST",message:"retained field did not observe repair"};}console.log("STORED");b.r=r;if(b.r!==r){throw {code:"TEST",message:"retry lost identity"};}consume(r);console.log("RECOVERED");return null;}
