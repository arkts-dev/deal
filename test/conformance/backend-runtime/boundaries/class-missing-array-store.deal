// @spec: Runtime execution model
// @description: class-missing-array-store
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as host from "host/probe";
class C{x:number;}function consume(c:C):void{}function identity(c:C):C{return c;}
export function main():null{let c:C={x:1};host.f(c);try{let xs:C[]=[];xs[0]=c;printer.log("OK");}catch(e){printer.log("REJECT");}return null;}