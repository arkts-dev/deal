// @description: math-absNumber--1
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.absNumber(-1);if(x===(1)){printer.log("OK");}else{printer.log("WRONG");}}catch(e){printer.log("THREW");}return null;}