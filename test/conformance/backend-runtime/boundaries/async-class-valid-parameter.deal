// @spec: Runtime execution model
// @description: async-class-valid-parameter
// @expected: runtime-ok
// @features: boundary-validation
import * as host from "host/probe";
class N{x:number;}function consume(n:N):void{}function identity(n:N):N{return n;}
export async function run():Promise<number>{let n:N={x:1};await host.mutate(n);try{consume(n);return 1;}catch(e){return 0;}}
export function main():null{return null;}