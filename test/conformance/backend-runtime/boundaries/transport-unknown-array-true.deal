import * as printer from "std/console";
import * as host from "host/probe";

export function main():null{let u=host.f();if(u.length!==1 || (u[0] as string)!==`\uD800`){throw {code:"TEST",message:"lone unknown array lost at host ingress"};}printer.log("OK");return null;}