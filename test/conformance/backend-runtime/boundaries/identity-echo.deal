export function main():null{let r=json.parse("{\"a\":[[1]]}");let xs=r.a as unknown[];let child=xs[0] as unknown[];let out=host.f(xs);let y=out[0] as unknown[];if(child===y){console.log("SAME");}else{console.log("COPY");}return null;}