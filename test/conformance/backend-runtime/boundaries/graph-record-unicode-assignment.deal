// @spec: Runtime execution model
// @description: Revalidate retained graph at record-unicode-assignment
// @expected: runtime-ok
// @features: boundary-validation
import * as console from "std/console";
import * as host from "host/probe";
class B{r:Record<string,unknown>;}function consume(r:Record<string,unknown>):void{console.log("PARAM_BODY");}
export function main():null{let r:Record<string,unknown>={};r.self=r;let box:B={r:r};let xs:Record<string,unknown>[]=[];let get: () => Record<string,unknown> = function():Record<string,unknown>{console.log("RETURN_BODY");return r;};host.corrupt(r);console.log("CORRUPTED");let d:Record<string,unknown>=r;if(d!==r || d.self!==(r as unknown) || (d.bad as string)!==`\uD800`){throw {code:"TEST",message:"Record lost lone graph"};}console.log("ACCEPT");host.repair();if(Object.hasOwn(d,"bad")){throw {code:"TEST",message:"Record alias did not observe repair"};}consume(r);console.log("RECOVERED");return null;}
