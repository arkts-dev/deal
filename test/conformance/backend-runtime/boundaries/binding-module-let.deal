// @spec: Runtime execution model
// @description: binding-module-let
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";

export function main():null{let f:()=>number=function():number{return 1;};f=function():number{return 2;};if(f()===2){printer.log("OK");}else{printer.log("STALE");}return null;}