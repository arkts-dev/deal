// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as host from "host/probe";

export function main():null{let u=host.f();if(u!==`\uD800`){throw {code:"TEST",message:"lone string lost at host ingress"};}printer.log("OK");return null;}