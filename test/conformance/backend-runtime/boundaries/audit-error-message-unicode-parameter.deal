// @spec: Runtime execution model
// @description: Lone UTF-16 Error message reaches parameter body with live identity
// @expected: runtime-ok
// @features: boundary-validation, host-abi
import * as console from "std/console";
import * as host from "host/probe";
function take(e:Error):void{console.log("PARAM_BODY");}
export function main():null{let e:Error={code:"X",message:"m"};let original:Error={code:"OLD",message:"old"};let destination=original;let alias=e;let get: () => Error = function():Error{console.log("RETURN_BODY");return e;};host.edit(e);take(e);if(e!==alias || e.message!==`\uD800`){throw {code:"TEST",message:"parameter lost lone message or identity"};}console.log("ACCEPT");host.repair();if(e!==alias || destination!==original || e.message!=="repaired"){throw {code:"TEST",message:"repair lost alias or unrelated destination"};}console.log("IDENTITY");take(e);console.log("RECOVERED");return null;}
