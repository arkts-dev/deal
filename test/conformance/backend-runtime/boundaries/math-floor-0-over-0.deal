// @spec: Runtime execution model
// @description: math-floor-0/0
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.floor(0/0);if(x!==x){printer.log("NAN");}else{printer.log("WRONG");}}catch(e){printer.log("THREW");}return null;}