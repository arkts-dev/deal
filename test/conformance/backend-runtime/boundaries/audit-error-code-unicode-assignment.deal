// @spec: Runtime execution model
// @description: Lone UTF-16 Error code survives assignment, aliasing and host repair
// @expected: runtime-ok
// @features: boundary-validation, host-abi
import * as console from "std/console";
import * as host from "host/probe";
function take(e:Error):void{console.log("PARAM_BODY");}
export function main():null{let e:Error={code:"X",message:"m"};let original:Error={code:"OLD",message:"old"};let destination=original;let alias=e;let get: () => Error = function():Error{console.log("RETURN_BODY");return e;};host.edit(e);destination=e;if(e.code!==`\uD800` || destination!==e || e!==alias){throw {code:"TEST",message:"lone code assignment lost value or identity"};}console.log("ACCEPT");host.repair();if(e.code!=="repaired" || destination!==alias){throw {code:"TEST",message:"repair lost alias"};}console.log("IDENTITY");take(e);console.log("RECOVERED");return null;}
