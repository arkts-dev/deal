// @spec: Runtime execution model
// @description: callback-record-False
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as host from "host/probe";

export function main():null{let f:()=>number=function():number{return 7;};let r:Record<string,unknown>={f:f};let u=host.echo(r);let t=u as Record<string,unknown>;let g=t.f as ()=>number;if(g===f&&g()===7){printer.log("OK");}else{printer.log("WRONG");}return null;}