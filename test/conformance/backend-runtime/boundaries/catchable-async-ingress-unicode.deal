// @spec: Runtime execution model
// @description: catchable-async-ingress-unicode
// @expected: runtime-ok
// @features: boundary-validation
import * as host from "host/probe";

export async function run():Promise<number>{let u=await host.f();if((u as string)!==`\uD800`){throw {code:"TEST",message:"async lone unit lost"};}return 1;}
export function main():null{return null;}