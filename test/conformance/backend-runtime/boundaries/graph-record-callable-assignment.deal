// @spec: Runtime execution model
// @description: Revalidate retained graph at record-callable-assignment
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as host from "host/probe";
class B{r:Record<string,unknown>;}function consume(r:Record<string,unknown>):void{printer.log("PARAM_BODY");}
export function main():null{let r:Record<string,unknown>={};r.self=r;let box:B={r:r};let xs:Record<string,unknown>[]=[];let get: () => Record<string,unknown> = function():Record<string,unknown>{printer.log("RETURN_BODY");return r;};host.corrupt(r);printer.log("CORRUPTED");try{let d:Record<string,unknown>=r;printer.log("BAD_ACCEPTED");}catch(e){printer.log("REJECT");}host.repair();consume(r);printer.log("RECOVERED");return null;}
