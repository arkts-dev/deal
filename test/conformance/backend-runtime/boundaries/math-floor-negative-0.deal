// @spec: Runtime execution model
// @description: math-floor--0
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.floor(-0);if(1/x===-1/0){printer.log("NEGZERO");}else{printer.log("WRONG");}}catch(e){printer.log("THREW");}return null;}