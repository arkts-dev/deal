// @spec: Runtime execution model
// @description: math-floor-4
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.floor(4);if(x===(4)){printer.log("OK");}else{printer.log("WRONG");}}catch(e){printer.log("THREW");}return null;}