// @expected: runtime-ok
// @features: boundary-validation
import * as console from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.sqrt(1/0);if(x===(1/0)){console.log("OK");}else{console.log("WRONG");}}catch(e){console.log("THREW");}return null;}