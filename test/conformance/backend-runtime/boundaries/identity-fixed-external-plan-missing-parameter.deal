function consume(n:host.Node):void{}function identity(n:host.Node):host.Node{return n;}
export function main():null{let n:host.Node={x:1,next:null};n.next=n;host.mutate(n);try{consume(n);console.log("OK");}catch(e){console.log("REJECT");}return null;}