export function main():null{let r:Record<string,unknown>=JSON.parse("{\"a\":[[1]]}");let xs=r.a as unknown[];let child=xs[0] as unknown[];let out=host.f(xs);let y=out.a as unknown[];if(child===y){printer.log("SAME");}else{printer.log("COPY");}return null;}