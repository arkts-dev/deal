// @spec: Runtime execution model
// @description: math-ceil-1/0
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as m from "std/math";
export function main():null{try{let x=m.ceil(1/0);if(x===(1/0)){printer.log("OK");}else{printer.log("WRONG");}}catch(e){printer.log("THREW");}return null;}