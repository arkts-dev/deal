// @spec: Runtime execution model
// @description: cyclic-class-missing-return
// @expected: runtime-ok
// @features: boundary-validation
import * as printer from "std/console";
import * as host from "host/probe";
class Node{x:number;next:Node|null;}class Box{n:Node;}function consume(n:Node):void{}function identity(n:Node):Node{return n;}
export function main():null{let n:Node={x:1,next:null};n.next=n;host.mutate(n);try{let d=identity(n);printer.log("OK");}catch(e){printer.log("REJECT");}return null;}