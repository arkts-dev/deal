import * as printer from "std/console";
import * as host from "host/probe";

export function main():null{let r:Record<string,unknown>=JSON.parse("{\"a\":[1,2]}");let a=r.a as unknown[];host.f(a);let n=a[0] as number;if(n===9){printer.log("LIVE");}else{printer.log("STALE");}return null;}