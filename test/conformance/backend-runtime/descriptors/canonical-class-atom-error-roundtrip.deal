// @spec: Runtime execution model — Runtime type descriptor format
// @description: Error values reified by error_value carry the canonical Error class atom (the one class atom without the leading '@'); a thrown and caught Error crosses an Error-typed boundary byte-for-byte with name and message intact, and the canonical matcher re-matches the atom exactly.
// @expected: runtime-ok
// @features: descriptors, error-handling, classes

function passThrough(): Error {
  try {
    throw { name: "E_CANON", message: "roundtrip" };
  } catch (e) {
    return e as Error;
  }
}

export function test_canonical_error_atom_roundtrip(): string {
  let e: Error = passThrough();
  if (e.name !== "E_CANON" || e.message !== "roundtrip") {
    throw { name: "TEST_FAIL", message: "error atom roundtrip lost fields" };
  }
  return "canonical error atom ok";
}

export function main(): void {
  return ;
}
