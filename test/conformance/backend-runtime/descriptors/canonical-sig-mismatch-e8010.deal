// @spec: Runtime execution model — Runtime type descriptor format
// @description: A function wrapper whose carried signature differs byte-for-byte from the expected canonical descriptor raises E8010 at the typed boundary — the canonical matcher's function row compares the exact descriptor text.
// @expected: runtime-error E8010
// @features: descriptors, functions, runtime-errors

import * as host from "host/signature_mutation";
function asString(x: number): string {
  return "s";
}

export function test_canonical_sig_mismatch(): number {
  let source: (x: number) => number = function(x: number): number { return x; };
  if (!host.replaceSignature({value: source}, "(number)->string")) { throw {code: "TEST_FAIL", message: "signature mutation failed"}; }
  let f: (x: number) => number = source;
  return f(1);
}

export function main(): null {
  return null;
}
