// @spec: Runtime execution model — Runtime type descriptor format
// @description: Canonical [T] array descriptors cross typed boundaries end to end: array parameters and returns, nested [[int]] arrays, and [(int)->int] function-element arrays all pass through the canonical boundary matcher byte-for-byte.
// @expected: runtime-ok
// @features: descriptors, arrays, functions

function first(xs: number[]): number {
  return xs[0];
}

function applyAll(fs: ((x: number) => number)[], x: number): number {
  let acc: number = x;
  for (let f: (x: number) => number of fs) {
    acc = f(acc);
  }
  return acc;
}

function nested(): number[][] {
  return [[1, 2], [3, 4]];
}

export function test_canonical_array_boundary(): string {
  let xs: number[] = [7, 8, 9];
  let f: number = first(xs);
  let fs: ((x: number) => number)[] = [
    function(x: number): number { return x + 1; },
    function(x: number): number { return x * 2; }
  ];
  let total: number = applyAll(fs, f);
  let grid: number[][] = nested();
  if (total !== 16) {
    throw { code: "TEST_FAIL", message: "array boundary value mismatch" };
  }
  if (grid[1][0] !== 3) {
    throw { code: "TEST_FAIL", message: "nested array boundary value mismatch" };
  }
  return "canonical array boundary ok";
}

export function main(): null {
  return null;
}
