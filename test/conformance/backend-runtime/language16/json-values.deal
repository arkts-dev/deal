// @spec: Standard library builtins — JSON
// @description: Persistent descriptors on dynamic JSON arrays and ordinary JSON rules inside generated Record fields.
// @expected: runtime-ok
// @features: jsonable, arrays, unknown, assertions


export class Box { data: Record<string, unknown>; numbers: number[]; }
class Child { payload: number; }
function check(ok: boolean): void { if (!ok) { throw {code: "FAIL", message: "JSON value contract"}; } }
function callback(): void {}
function rejectsNumbers(value: unknown): boolean {
  let rejected: boolean = false;
  try { let numbers = value as number[]; }
  catch (e) { if (e instanceof Error) { rejected = e.code === "E8001"; } }
  return rejected;
}
function parsedArray(text: string): void {
    let parsed: Record<string, unknown> = JSON.parse("{\"value\":" + text + "}");
    let value: unknown = parsed["value"];
    check(rejectsNumbers(value));
    let items = value as unknown[];
    check((items as unknown) === (value as unknown));
    items[items.length] = "text";
}
export function main(): null {
  let paired = `🌍\\`;
  check(paired === "🌍\\");
  let interpolated = `🌍\\${"x"}`;
  check(interpolated === "🌍\\x");
  let nestedTemplate = `${`🌍\\`}`;
  check(nestedTemplate === paired);
  parsedArray("[]"); parsedArray("[1]"); parsedArray("[null]");
  let nested = JSON.parse("{\"inner\":[[]]}") as Record<string, unknown>;
  let outer = nested.inner as unknown[];
  check(rejectsNumbers(outer[0]));
  let decoded: Box = JSON.parse("{\"data\":{\"inner\":[1]},\"numbers\":[1]}");
  let box = decoded;
  check(rejectsNumbers(box.data.inner));
  let nulls: Box = JSON.parse("{\"data\":{\"leaf\":null},\"numbers\":[]}");
  {
    let record = nulls.data;
    check(Object.hasOwn(record, "leaf"));
    check(record.leaf === null); check(null === record.leaf);
    check(!(record.leaf !== null)); check(!(null !== record.leaf));
    record.leaf = undefined;
    check(record.leaf !== null); check(null !== record.leaf);
    check(!(record.leaf === null)); check(!(null === record.leaf));
    delete record.leaf;
    check(record.leaf !== null); check(!(record.leaf === null));
    check(!Object.hasOwn(record, "leaf"));
  }
  let numbers: unknown = box.numbers;
  check((numbers as number[]) === box.numbers);
  let wrong: boolean = false;
  try { numbers as unknown[]; } catch (e) { if (e instanceof Error) { wrong = true; } }
  check(wrong);
  let child: Child = {payload: 4};
  let data: Record<string, unknown> = {};
  data.z = undefined;
  data["2"] = "two";
  data["1"] = "one";
  data.callback = callback;
  let items: unknown[] = [undefined, callback, 1 / 0, 0 / 0, -0];
  data.items = items;
  data.child = child;
  let value: Box = {data: data, numbers: []};
  let encoded = JSON.stringify(value) as string;
  let round = JSON.stringify(JSON.parse(encoded));
  check(round === JSON.stringify(JSON.parse("{\"data\":{\"1\":\"one\",\"2\":\"two\",\"items\":[null,null,null,null,0],\"child\":{\"payload\":4}},\"numbers\":[]}")));
  let shared: Record<string, unknown> = {a: data, b: data};
  JSON.stringify(shared);
  data.cycle = data;
  let cycle: boolean = false;
  try { JSON.stringify(value); } catch (e) { if (e instanceof Error) { cycle = e.code === "E8001"; } }
  check(cycle);
  return null;
}
