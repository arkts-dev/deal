// @spec: Bytes
// @description: bytes(0) constructs an empty mutable byte buffer.
// @expected: runtime-ok
// @features: bytes, construction, length

export function main(): null {
  let b: bytes = bytes(0);
  if (b.length !== 0) { throw { code: "TEST_FAIL", message: "zero bytes length mismatch" }; }
  return null;
}
