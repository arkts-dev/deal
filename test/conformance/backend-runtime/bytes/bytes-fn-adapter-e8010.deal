// @spec: Functions — arity extension at a check position
// @description: a table-produced function value whose carried signature is shorter than the declared parameter raises E8010 with the pinned function signature mismatch contract (v1.2): the dynamic value's own signature is validated exactly at the parameter cell, never silently adapted
// @expected: runtime-error E8010
// @features: bytes, functions, arity, runtime-errors

function id(b: bytes): bytes { return b; }

function apply2(cb: (b: bytes, v: int) => bytes, b: bytes): bytes {
  return cb(b, 5);
}

export function test_bytes_fn_adapter_e8010(): int {
  let holder: table = { f: id };
  return apply2(holder.f, bytes(1))[0];
}

export function main(): null {
  return null;
}
