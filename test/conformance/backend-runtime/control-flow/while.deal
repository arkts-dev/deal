// @spec: Control flow — While
// @description: While loop works
// @expected: runtime-ok
// @features: control-flow, while

export function test_while(): int {
  let x: int = 0;
  while (x < 10) {
    x = x + 1;
  }
  if (x !== 10) {
    throw { code: "TEST_FAIL", message: "while loop terminated at the wrong value" };
  }
  return x;
}

export function main(): null {
  return null;
}
