// @spec: Error handling — try / catch
// @description: break inside try within for-loop exits loop
// @expected: runtime-ok
// @features: error-handling, try, break

export function test_break_in_try(): int {
  let found: int = 0;
  let catchRan: boolean = false;
  { let v14Loop0: int = 0; while (v14Loop0 < 10) { let i: int = v14Loop0; {
    try {
      if (i === 5) { break; }
    } catch (e) {
      catchRan = true;
    }
    found = i;
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  if (found !== 4 || catchRan) {
    throw { code: "TEST_FAIL", message: "break-in-try terminal result or forbidden catch path mismatch" };
  }
  return found;
}

export function main(): null {
  return null;
}
