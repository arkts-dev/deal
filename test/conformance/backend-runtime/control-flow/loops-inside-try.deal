// @spec: Control flow — loops inside try
// @description: Loops execute normally inside try blocks and return the expected result
// @expected: runtime-ok
// @features: loops, try

export function test_loops_inside_try(): number {
  let total: number = 0;
  try {
    let i: number = 0;
    while (i < 3) {
      total = total + i;
      i = i + 1;
    }
    { let v14Loop0: number = 0; while (v14Loop0 < 3) { let j: number = v14Loop0; {
      total = total + j;
    } v14Loop0 = j; v14Loop0 = v14Loop0 + 1; } }
  } catch (e) {
    throw { code: "TEST_FAIL", message: "unexpected catch" };
  }
  if (total !== 6) { throw { code: "TEST_FAIL", message: "loop total mismatch" }; }
  return total;
}

export function main(): null {
  return null;
}
