// @spec: Error handling — try / catch
// @description: return inside try within for-loop exits function correctly
// @expected: runtime-ok
// @features: error-handling, try, return, for-loop

export function test_return_in_try_loop(): int {
  let catchRan: boolean = false;
  function findFive(): int {
    let found: int = 0;
    { let v14Loop0: int = 0; while (v14Loop0 < 10) { let i: int = v14Loop0; {
      try {
        if (i === 5) { return i; }
      } catch (e) {
        catchRan = true;
      }
      found = i;
    } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
    return found;
  }
  let got: int = findFive();
  if (got !== 5 || catchRan !== false) {
    throw { code: "TEST_FAIL", message: "return inside try in loop: wrong result or catch executed" };
  }
  return 5;
}

export function main(): null {
  return null;
}
