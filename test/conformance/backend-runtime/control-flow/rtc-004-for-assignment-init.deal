// @spec: Control flow
// @description: A C-style for loop accepts assignment as its initializer
// @expected: runtime-ok
// @features: control-flow, for, assignment

export function test_for_assignment_init(): null {
  let i: int = 0;
  let visits: int = 0;
  for (i = 1; i < 4; i = i + 1) { visits = visits + 1; }
  if (visits !== 3) { throw { code: "TEST_FAIL", message: "for assignment initializer produced wrong count" }; }
  return null;
}

export function main(): null { return test_for_assignment_init(); }
