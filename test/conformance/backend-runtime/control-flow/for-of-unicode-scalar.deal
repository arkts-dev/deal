// @spec: Control flow — For-of
// @description: string for-of yields one string containing exactly one Unicode scalar value per iteration, in order (v1.2)
// @expected: runtime-ok
// @features: for-of, unicode, v1.2

export function main(): null {
  let count: int = 0;
  for (let c: string of "é") {
    count = count + 1;
    if (c !== "é") {
      throw { code: "TEST_FAIL", message: "for-of unicode: scalar value mismatch" };
    }
  }
  if (count !== 1) {
    throw { code: "TEST_FAIL", message: "for-of unicode: iteration count mismatch" };
  }
  return null;
}
