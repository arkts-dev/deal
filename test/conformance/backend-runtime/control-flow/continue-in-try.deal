// @spec: Error handling — try / catch
// @description: continue inside try within for-loop jumps to update step
// @expected: runtime-ok
// @features: error-handling, try, continue

export function test_continue_in_try(): int {
  let sum: int = 0;
  let catchRan: boolean = false;
  { let v14Loop0: int = 0; while (v14Loop0 < 5) { let i: int = v14Loop0; {
    try {
      if (i === 2) { { v14Loop0 = i; v14Loop0 = v14Loop0 + 1; continue; } }
    } catch (e) {
      catchRan = true;
    }
    sum = sum + i;
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  if (sum !== 8 || catchRan) {
    throw { code: "TEST_FAIL", message: "continue-in-try sum or forbidden catch path mismatch" };
  }
  return sum;
}

export function main(): null {
  return null;
}
