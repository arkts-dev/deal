// @spec: Control flow — Conditional
// @description: If/else works
// @expected: runtime-ok
// @features: control-flow, if

export function test_ifelse(): int {
  let x: int = 0;
  if (x === 0) {
    x = 1;
  } else {
    x = 2;
  }
  // should be 1
  if (x !== 1) {
    throw { code: "TEST_FAIL", message: "if/else took the wrong branch" };
  }
  return x;
}

export function main(): null {
  return null;
}
