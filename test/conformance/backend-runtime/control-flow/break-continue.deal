// @spec: Control flow — Break / Continue
// @description: Break exits the loop
// @expected: runtime-ok
// @features: control-flow, break

export function test_break(): int {
  let found: int = 0;
  { let v14Loop0: int = 0; while (v14Loop0 < 10) { let i: int = v14Loop0; {
    if (i === 5) { break; }
    found = i;
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  // i runs 0..4, so last is 4
  if (found !== 4) {
    throw { code: "TEST_FAIL", message: "break did not exit the loop at i === 5" };
  }
  return found;
}

export function main(): null {
  return null;
}
