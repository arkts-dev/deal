// @spec: Control flow — Break / Continue
// @description: Continue skips to next iteration
// @expected: runtime-ok
// @features: control-flow, continue

export function test_continue(): int {
  let sum: int = 0;
  for (let i: int = 0; i < 5; i = i + 1) {
    if (i === 2) { continue; }
    sum = sum + i;
  }
  // 0+1+3+4 = 8
  if (sum !== 8) {
    throw { code: "TEST_FAIL", message: "continue did not skip iteration i === 2" };
  }
  return sum;
}

export function main(): null {
  return null;
}
