// @spec: Control flow — Break / Continue
// @description: Continue skips to next iteration
// @expected: runtime-ok
// @features: control-flow, continue

export function test_continue(): number {
  let sum: number = 0;
  { let v14Loop0: number = 0; while (v14Loop0 < 5) { let i: number = v14Loop0; {
    if (i === 2) { { v14Loop0 = i; v14Loop0 = v14Loop0 + 1; continue; } }
    sum = sum + i;
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  // 0+1+3+4 = 8
  if (sum !== 8) {
    throw { code: "TEST_FAIL", message: "continue did not skip iteration i === 2" };
  }
  return sum;
}

export function main(): null {
  return null;
}
