// @spec: Control flow — For-of — Closure capture
// @description: Each for-of iteration creates a fresh binding; closures capture distinct values
// @expected: runtime-ok
// @features: for-of, closure

export function test_closure_capture(): int {
  let vals: int[] = [1, 2, 3];
  let fs: (() => int)[] = [function(): int { return -1; }, function(): int { return -1; }, function(): int { return -1; }];
  let i: int = 0;
  for (let x: int of vals) {
    fs[i] = function(): int { return x; };
    i = i + 1;
  }
  if (fs.length !== 3) {
    throw { code: "TEST_FAIL", message: "for-of closure array length mismatch" };
  }
  let r0: int = fs[0]();
  let r1: int = fs[1]();
  let r2: int = fs[2]();
  if (r0 !== 1) {
    throw { code: "TEST_FAIL", message: "for-of closure first capture mismatch" };
  }
  if (r1 !== 2) {
    throw { code: "TEST_FAIL", message: "for-of closure second capture mismatch" };
  }
  if (r2 !== 3) {
    throw { code: "TEST_FAIL", message: "for-of closure third capture mismatch" };
  }
  return r0 * 100 + r1 * 10 + r2;
}

export function main(): null {
  return null;
}
