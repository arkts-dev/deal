// @spec: Control flow — For-of — Break and continue
// @description: break exits for-of early, continue skips an element
// @expected: runtime-ok
// @features: for-of, break, continue

export function test_break(): int {
  let xs: int[] = [1, 2, 3, 4, 5];
  let total: int = 0;
  for (let x: int of xs) {
    if (x === 3) { break; }
    total = total + x;
  }
  if (total !== 3) {
    throw { code: "TEST_FAIL", message: "for-of break path mismatch" };
  }
  return total;
}

export function test_continue(): int {
  let xs: int[] = [1, 2, 3, 4, 5];
  let total: int = 0;
  for (let x: int of xs) {
    if (x === 3) { continue; }
    total = total + x;
  }
  if (total !== 12) {
    throw { code: "TEST_FAIL", message: "for-of continue path mismatch" };
  }
  return total;
}
