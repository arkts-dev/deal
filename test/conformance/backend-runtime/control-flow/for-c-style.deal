// @spec: Control flow — For (C-style)
// @description: C-style for loop works
// @expected: runtime-ok
// @features: control-flow, for

export function test_for(): number {
  let x: number = 0;
  { let v14Loop0: number = 0; while (v14Loop0 < 5) { let i: number = v14Loop0; {
    x = x + i;
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  // 0+1+2+3+4 = 10
  if (x !== 10) {
    throw { code: "TEST_FAIL", message: "C-style for loop produced the wrong sum" };
  }
  return x;
}

export function main(): null {
  return null;
}
