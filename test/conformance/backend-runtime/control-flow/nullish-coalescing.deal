// @spec: Control flow — Nullish coalescing and lazy selection
// @expected: runtime-ok
// @features: control-flow, classes, closures, arrays
class Item {x:number;}
function check(ok:boolean,label:string):void{if(!ok){throw {name:label,message:label};}}
function assertionFallback():number{let bad:unknown=opaque("wrong");return bad as number;}
function opaque(value:unknown):unknown{return value;}
function badSelection():number{let absent:number|null=null;return absent??assertionFallback();}
export async function asyncCoalescing():Promise<number>{
  let effects="";
  const take=async(value:number):Promise<number>=>{effects=effects+String(value);return value;};
  let present:number|null=3;let absent:number|undefined=undefined;
  const a=present??await take(1);const b=absent??await take(4);
  check(a===3 && b===4 && effects==="4","async lazy fallback");
  const c=(await take(5))??await take(6);
  check(c===5 && effects==="45","awaited left");
  return a+b+c;
}
export function main():void {
  let calls=0;let effects="";
  const rhs=():number=>{calls=calls+1;effects=effects+"r";return 7;};
  const source=(value:number|null|undefined):number|null|undefined=>{effects=effects+"l";return value;};
  let n:number|null|undefined=null;
  check((source(n)??rhs())===7 && calls===1 && effects==="lr","null and once");
  n=undefined;check((n??rhs())===7 && calls===2,"undefined");
  n=-0;check(1/(n??rhs())===-1/0 && calls===2,"negative zero");
  n=0/0;check(Number.isNaN(n??rhs()) && calls===2,"NaN");
  n=1/0;check((n??rhs())===1/0,"infinity");
  let b:boolean|null=false;check((b??true)===false,"false");
  let s:string|undefined="";check((s??"fallback")==="","empty text");
  s="\ud800\0";check((s??"fallback").length===2,"UTF16");
  let c:Item|null=null;let item:Item=c??{x:9};check(item.x===9,"contextual class");
  c=item;const same:Item=c??{x:10};check(same===item,"class identity");
  const skipped:Item=c??JSON.parse("invalid");check(skipped===item,"lazy parse");
  c=null;const parsed:Item=c??JSON.parse('{"x":11}');check(parsed.x===11,"contextual parse");
  let fn:(()=>number)|null=():number=>12;
  let selected:(x:number)=>number=fn??((x:number):number=>x);
  check(selected(5)===12,"selected adapter");
  const singleton:(x:number)=>number=null??(():number=>14);
  check(singleton(5)===14,"nullish-only adapter");
  fn=null;selected=fn??((x:number):number=>x+1);check(selected(5)===6,"assignment adapter");
  let u:unknown=false;let v:unknown=u??rhs();check((v as boolean)===false && calls===2,"unknown false");
  u=undefined;v=u??rhs();check((v as number)===7 && calls===3,"unknown undefined");
  let xs:Item[]|null=null;const fallback:Item[]=xs??[{x:13}];xs=fallback;
  const alias:Item[]=xs??[];check(alias===fallback && alias[0]===fallback[0],"array identity");
  let nothing:null|undefined=null;check((nothing??undefined??rhs())===7 && calls===4,"left association");
  check((null??7)===7 && (undefined??8)===8,"singletons");
  const fail=():number=>{throw {name:"STOP",message:"stop"};};
  let result=19;let caught=false;n=2;result=n??fail();check(result===2,"skip failure");n=null;
  try{result=n??fail();}catch(e){caught=(e as Error).name==="STOP";}
  check(caught && result===2,"abrupt destination");
  const first=():number|null=>{throw {name:"FIRST",message:"first"};};caught=false;
  try{result=first()??rhs();}catch(e){caught=(e as Error).name==="FIRST";}
  check(caught && result===2 && calls===4,"abrupt left");
  const capture=(value:number):()=>number=>{let f:(()=>number)|null=null;return f??(():number=>value);};
  check(capture(21)()===21 && capture(22)()===22,"fresh captures");
  const recurse=(value:number):number=>{let base:number|null=value===0?0:null;return base??(value+recurse(value-1));};
  check(recurse(4)===10,"recursion");
  const cells:number[]=[0];cells[0]=n??23;check(cells[0]===23,"array assignment");
  item.x=n??24;check(item.x===24,"field assignment");
  check((b??true?1:2)===2 && ((b??true)||true),"conditional and parenthesized logical");
  return ;
}
