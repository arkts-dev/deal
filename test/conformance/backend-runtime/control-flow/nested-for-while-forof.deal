// @spec: Control flow — nested loops
// @description: Nested for, while, and for-of loops interact correctly
// @expected: runtime-ok
// @features: loops, for-of, arrays

export function test_nested_loop_mix(): number {
  let values: number[] = [1, 2, 3];
  let total: number = 0;
  { let v14Loop0: number = 0; while (v14Loop0 < 2) { let i: number = v14Loop0; {
    let j: number = 0;
    while (j < 2) {
      for (let v: number of values) {
        total = total + v;
      }
      j = j + 1;
    }
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  if (total !== 24) { throw { code: "TEST_FAIL", message: "nested loop mix failed" }; }
  return total;
}

export function main(): null {
  return null;
}
