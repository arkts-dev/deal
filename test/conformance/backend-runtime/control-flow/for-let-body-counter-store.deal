// @spec: Control flow — For (C-style)
// @description: A for-let body store feeds the iteration's update and the subsequent test
// @expected: runtime-ok
// @features: control-flow, for, closures

function testBodyStoreFeedsUpdateAndTest(): null {
  let visits: int = 0;
  for (let i: int = 0; i < 3; i = i + 1) {
    visits = visits + 1;
    i = i + 1;
  }
  if (visits !== 2) {
    throw { code: "TEST_FAIL", message: "the body store did not reach the update and test" };
  }
  return;
}

function testOmittedUpdateStillCarries(): null {
  let visits: int = 0;
  for (let i: int = 0; i < 2;) {
    visits = visits + 1;
    i = i + 1;
    if (visits === 3) { break; }
  }
  if (visits !== 2) {
    throw { code: "TEST_FAIL", message: "the update-less row lost the body store" };
  }
  return;
}

function testContinueInTryAfterStore(): null {
  let visits: int = 0;
  for (let i: int = 0; i < 3; i = i + 1) {
    visits = visits + 1;
    i = i + 1;
    try {
      if (visits === 1) { continue; }
    } catch (e) {
      visits = 100;
    }
  }
  if (visits !== 2) {
    throw { code: "TEST_FAIL", message: "a continue path lost the body store" };
  }
  return;
}

function testClosureMutationFeedsUpdate(): null {
  let visits: int = 0;
  for (let i: int = 0; i < 4; i = i + 1) {
    visits = visits + 1;
    let mutate: () => null = function(): null { i = i + 1; return; };
    mutate();
  }
  if (visits !== 2) {
    throw { code: "TEST_FAIL", message: "a closure's counter store was dropped" };
  }
  return;
}

function testUpdateReadsOtherState(): null {
  let total: int = 0;
  let step: int = 1;
  for (let i: int = 0; i < 6; i = i + step) {
    total = total + i;
    i = i + 1;
    step = 2;
  }
  if (total !== 3) {
    throw { code: "TEST_FAIL", message: "the update read a stale counter value" };
  }
  return;
}

function testBreakBeforeUpdate(): null {
  let visits: int = 0;
  for (let i: int = 0; i < 10; i = i + 1) {
    visits = visits + 1;
    i = i + 1;
    if (visits === 2) { break; }
  }
  if (visits !== 2) {
    throw { code: "TEST_FAIL", message: "the break path iterated the wrong number of times" };
  }
  return;
}

function testNestedLoopsTransferTheirOwnBinding(): null {
  let outer: int = 0;
  let inner: int = 0;
  for (let i: int = 0; i < 2; i = i + 1) {
    outer = outer + 1;
    i = i + 1;
    for (let j: int = 0; j < 2; j = j + 1) {
      inner = inner + 1;
      j = j + 1;
    }
  }
  if (outer !== 1 || inner !== 1) {
    throw { code: "TEST_FAIL", message: "a nested loop transferred the wrong binding" };
  }
  return;
}

function testCapturesStayPerIteration(): null {
  let fs: (() => int)[] = [
    function(): int { return -1; },
    function(): int { return -1; }
  ];
  let k: int = 0;
  for (let i: int = 0; i < 4; i = i + 1) {
    fs[k] = function(): int { return i; };
    k = k + 1;
    i = i + 1;
  }
  if (k !== 2) {
    throw { code: "TEST_FAIL", message: "the body store did not shorten the loop" };
  }
  if (fs[0]() !== 1 || fs[1]() !== 3) {
    throw { code: "TEST_FAIL", message: "the per-iteration captures are not fresh" };
  }
  return;
}

function testStringCounterStore(): null {
  let visits: int = 0;
  for (let s: string = ""; s !== "aa"; s = s + "a") {
    visits = visits + 1;
    s = s + "a";
  }
  if (visits !== 1) {
    throw { code: "TEST_FAIL", message: "the string counter store was dropped" };
  }
  return;
}

function testNumberCounterStore(): null {
  let visits: int = 0;
  for (let n: number = 0.0; n < 1.5; n = n + 0.5) {
    visits = visits + 1;
    n = n + 0.5;
  }
  if (visits !== 2) {
    throw { code: "TEST_FAIL", message: "the number counter store was dropped" };
  }
  return;
}

function testReturnAndThrowSkipUpdate(): null {
  let calls: int = 0;
  function next(x: int): int {
    calls = calls + 1;
    return x + 1;
  }
  function firstBodyValue(): int {
    for (let i: int = 0; i < 3; i = next(i)) {
      i = i + 1;
      return i;
    }
    return -1;
  }
  let got: int = firstBodyValue();
  if (got !== 1) {
    throw { code: "TEST_FAIL", message: "the returning body lost its store" };
  }
  let caught: boolean = false;
  try {
    for (let i: int = 0; i < 3; i = next(i)) {
      if (i === 0) { throw { message: "stop" }; }
    }
  } catch (e) {
    caught = true;
  }
  if (!caught || calls !== 0) {
    throw { code: "TEST_FAIL", message: "a return or throw ran the update" };
  }
  return;
}

export function main(): null {
  testBodyStoreFeedsUpdateAndTest();
  testOmittedUpdateStillCarries();
  testContinueInTryAfterStore();
  testClosureMutationFeedsUpdate();
  testUpdateReadsOtherState();
  testBreakBeforeUpdate();
  testNestedLoopsTransferTheirOwnBinding();
  testCapturesStayPerIteration();
  testStringCounterStore();
  testNumberCounterStore();
  testReturnAndThrowSkipUpdate();
  return null;
}
