// @spec: Control flow — For-of — Array iteration
// @description: For-of over int[] sums the array elements
// @expected: runtime-ok
// @features: for-of, array

export function test_sum(): int {
  let xs: int[] = [1, 2, 3, 4, 5];
  let total: int = 0;
  for (let x: int of xs) {
    total = total + x;
  }
  return total;
}
