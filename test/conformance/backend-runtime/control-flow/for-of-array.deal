// @spec: Control flow — For-of — Array iteration
// @description: For-of over number[] sums the array elements
// @expected: runtime-ok
// @features: for-of, array

export function test_sum(): number {
  let xs: number[] = [1, 2, 3, 4, 5];
  let total: number = 0;
  for (let x of xs) {
    total = total + x;
  }
  if (total !== 15) {
    throw { code: "TEST_FAIL", message: "for-of array sum mismatch" };
  }
  return total;
}

export function main(): null {
  return null;
}
