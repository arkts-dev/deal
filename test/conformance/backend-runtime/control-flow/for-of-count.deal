// @spec: Control flow — For-of — Iteration count
// @description: for-of iterates exactly the number of elements in the array/string
// @expected: runtime-ok
// @features: for-of

export function test_array_count(): number {
  let xs: number[] = [1, 2, 3, 4, 5];
  let n: number = 0;
  for (let x: number of xs) {
    n = n + 1;
  }
  if (n !== 5) {
    throw { code: "TEST_FAIL", message: "for-of array count mismatch" };
  }
  return n;
}

export function test_string_count(): number {
  let s: string = "hello";
  let n: number = 0;
  for (let c: string of s) {
    n = n + 1;
  }
  if (n !== 5) {
    throw { code: "TEST_FAIL", message: "for-of string byte count mismatch" };
  }
  return n;
}

export function main(): null {
  return null;
}
