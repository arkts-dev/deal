// @spec: Error handling — return through try/catch
// @description: Return inside try exits the function without executing catch
// @expected: runtime-ok
// @features: try, return

export function test_return_inside_try(): int {
  let catchRan: boolean = false;
  function attemptReturn(): int {
    try {
      return 7;
    } catch (e) {
      catchRan = true;
      return 99;
    }
  }
  let got: int = attemptReturn();
  if (got !== 7 || catchRan !== false) {
    throw { code: "TEST_FAIL", message: "return inside try: wrong result or catch executed" };
  }
  return 7;
}
