// @spec: Control flow — For-of — String iteration
// @description: For-of over string counts characters
// @expected: runtime-ok
// @features: for-of, string

export function test_count(): int {
  let s: string = "hello";
  let n: int = 0;
  for (let c: string of s) {
    n = n + 1;
  }
  if (n !== 5) {
    throw { code: "TEST_FAIL", message: "for-of string byte count mismatch" };
  }
  return n;
}
