// @spec: Type system — Runtime checked return boundaries
// @description: Returning a closure-cleared number refinement fails at return admission with E8001, independently of assertions.
// @expected: runtime-error E8001
// @features: type-system, functions, runtime-errors

export function test_dynamic_return_runtime_error(): number {
  let value: number | null = 7;
  let clear: () => void = function(): void { value = null; };
  if (value !== null) {
    clear();
    return value;
  }
  throw { code: "TEST_FAIL", message: "refined return branch skipped" };
}

export function main(): null {
  return null;
}
