// @spec: Type system — Nullable runtime checks
// @description: Assigning dynamic wrong type to nullable number fails with E8001
// @expected: runtime-error E8001
// @features: type-system, nullable, runtime-errors

export function test_dynamic_wrong_to_nullable_runtime_error(): number | null {
  let t: Record<string, unknown> = { value: "bad" };
  let x: number | null = t.value as number | null;
  return x;
}

export function main(): null {
  return null;
}
