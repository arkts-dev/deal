// @spec: Type system — Nullable semantics (narrowing invalidation across calls)
// @description: The .length controls of the call-preserved narrowing refinement: while the value is valid the refined array receivers read their live length unchanged (the empty array included, with the array identity, contents and append behavior preserved), a call preserves the refinement, a call receiver is evaluated exactly once, and after a capturing closure clears the binding every .length position — direct and composed — raises its own catchable E8001 whose caught flag is asserted after the try.
// @expected: runtime-ok
// @features: type-system, nullable, narrowing, arrays, runtime-errors

function expectNoError(what: string): null {
  throw { code: "CONTROL_FAIL", message: what + ": no error was raised" };
}

function expectCaught(e: Error, what: string, code: string, message: string): null {
  if (e.code !== code || e.message !== message) {
    throw { code: "CONTROL_FAIL", message: what + ": expected " + code + " " + message
      + ", got " + e.code + " " + e.message };
  }
  return null;
}

function expectEqual(what: string, actual: number, expected: number): null {
  if (actual !== expected) {
    throw { code: "CONTROL_FAIL", message: what + " changed the value" };
  }
  return null;
}

function preserveCall(): null {
  return null;
}

export function main(): null {
  // A live refinement reads the live length: the valid non-null binding, the
  // empty array keep their normal length behavior.
  let xs: number[] | null = [3, 4];
  let alias: number[] = [];
  if (xs !== null) {
    expectEqual("valid array length", xs.length, 2);
    alias = xs;
    if (alias !== xs) {
      throw { code: "CONTROL_FAIL", message: "the reference capture lost the array identity" };
    }
    preserveCall();
    expectEqual("call-preserved array length", xs.length, 2);
  }
  let empty: number[] | null = [];
  if (empty !== null) {
    expectEqual("empty array length", empty.length, 0);
  }


  // The receiver expression completes exactly once per length read.
  let calls: number = 0;
  let make: () => number[] = function(): number[] {
    calls = calls + 1;
    return [7, 8];
  };
  let made: number = make().length;
  expectEqual("receiver evaluations", calls, 1);
  expectEqual("call receiver length", made, 2);

  // A capturing closure clears the bindings behind the preserved refinement.
  let clear: () => null = function(): null {
    xs = null;
    return null;
  };

  if (xs !== null) {
    clear();

    // The reference capture survives the cleared binding: the alias keeps the
    // array identity and contents, and its own length reads stay normal.
    expectEqual("alias length after clear", alias.length, 2);
    expectEqual("alias element after clear", alias[1], 4);
    alias[alias.length] = 5;
    expectEqual("alias append length", alias.length, 3);
    expectEqual("alias append element", alias[2], 5);

    // Direct .length: the caught flag asserted after the try proves the
    // canonical error was caught, never a raw backend error or a coercion.
    let directCaught: boolean = false;
    try {
      let n: number = xs.length;
      expectNoError("direct length");
    } catch (e) {
      expectCaught(e, "direct length", "E8001", "expected array");
      directCaught = true;
    }
    if (!directCaught) {
      throw { code: "CONTROL_FAIL", message: "direct length: the caught flag stayed false" };
    }

    // Composed-expression paths: the arithmetic operand, the comparison
    // operand, the loop condition and a chain key consume the same receiver
    // admission and each raises its own catchable E8001.
    let arithmeticCaught: boolean = false;
    try {
      let total: number = 1 + xs.length;
      expectNoError("arithmetic length");
    } catch (e) {
      expectCaught(e, "arithmetic length", "E8001", "expected array");
      arithmeticCaught = true;
    }
    if (!arithmeticCaught) {
      throw { code: "CONTROL_FAIL", message: "arithmetic length: the caught flag stayed false" };
    }
    let comparisonCaught: boolean = false;
    try {
      if (xs.length > 0) {
        expectNoError("comparison length");
      }
      expectNoError("comparison length");
    } catch (e) {
      expectCaught(e, "comparison length", "E8001", "expected array");
      comparisonCaught = true;
    }
    if (!comparisonCaught) {
      throw { code: "CONTROL_FAIL", message: "comparison length: the caught flag stayed false" };
    }
    let loopCaught: boolean = false;
    try {
      { let v14Loop0: number = 0; while (v14Loop0 < xs.length) { let i: number = v14Loop0; {
        expectNoError("loop length");
      } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
      expectNoError("loop length");
    } catch (e) {
      expectCaught(e, "loop length", "E8001", "expected array");
      loopCaught = true;
    }
    if (!loopCaught) {
      throw { code: "CONTROL_FAIL", message: "loop length: the caught flag stayed false" };
    }
    let keyCaught: boolean = false;
    try {
      alias[xs.length] = 6;
      expectNoError("chain key length");
    } catch (e) {
      expectCaught(e, "chain key length", "E8001", "expected array");
      keyCaught = true;
    }
    if (!keyCaught) {
      throw { code: "CONTROL_FAIL", message: "chain key length: the caught flag stayed false" };
    }
    // The failed append wrote nothing.
    expectEqual("alias length after failed append", alias.length, 3);
  }
  return null;
}
