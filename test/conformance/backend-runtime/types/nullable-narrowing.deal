// @spec: Type system — Nullable semantics
// @description: Narrowing allows T | null to be assigned to T after null check
// @expected: runtime-ok
// @features: type-system, nullable, narrowing

export function test_narrowing(): int {
  let n: int | null = 1;
  if (n !== null) {
    let i: int = n; // OK: narrowed to int
    if (i !== 1) {
      throw { code: "TEST_FAIL", message: "nullable narrowing: narrowed value mismatch" };
    }
    return i;
  }
  throw { code: "TEST_FAIL", message: "nullable narrowing: null is a failing path" };
}
