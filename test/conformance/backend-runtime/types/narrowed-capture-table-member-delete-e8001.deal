// @spec: Type system — Nullable semantics (narrowing invalidation across calls)
// @description: A cleared T | null binding read as a table member delete's receiver is validated before the delete: the chain reports the typed-boundary tuple (E8001, expected table, actual null) at the receiver instead of a raw index error or a null dereference, and no member is deleted.
// @expected: runtime-error E8001
// @features: type-system, nullable, narrowing, tables, runtime-errors

export function main(): null {
  let t: table | null = {a: 1};
  let clear: () => null = function(): null {
    t = null;
    return null;
  };
  if (t !== null) {
    clear();
    delete t.a;
  }
  return null;
}
