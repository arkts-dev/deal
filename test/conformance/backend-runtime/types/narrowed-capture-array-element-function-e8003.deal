// @spec: Runtime execution model — Array runtime checks (E8003)
// @description: A narrowed function-typed read used as an array literal element is validated by the array-element cell: the failure is the specified E8003 arm (array element 1 type mismatch, the element descriptor as expected, null as actual) at the element read on every backend — never the bare E8010 row and never the array element's own E8001.
// @expected: runtime-error E8003
// @features: type-system, nullable, narrowing, arrays, functions, descriptors, runtime-errors

function asInt(value: number): number {
  return value;
}

export function main(): null {
  let f: ((value: number) => number) | null = asInt;
  let clear: () => null = function(): null {
    f = null;
    return null;
  };
  if (f !== null) {
    clear();
    let xs: ((value: number) => number)[] = [f];
  }
  return null;
}
