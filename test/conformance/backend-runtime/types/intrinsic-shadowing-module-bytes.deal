// @spec: Variables — Scope
// @description: A module-level function named bytes resolves and executes as an ordinary user function.
// @expected: runtime-ok
// @features: variables, name-resolution, shadowing, intrinsics

function bytes(n: int): int { return n + 100; }

export function main(): null {
  if (bytes(2) !== 102) {
    throw { code: "TEST_FAIL", message: "module-level bytes declaration ignored" };
  }
  return null;
}
