// @spec: Type system — Nullable semantics (narrowing invalidation across calls)
// @description: A narrowed int read consumed by unary minus is validated at the operand: the negation reports the typed-boundary tuple (E8001, expected int, actual null) at the read instead of accepting a negated null or escaping a raw backend arithmetic error.
// @expected: runtime-error E8001
// @features: type-system, nullable, narrowing, runtime-errors

export function main(): null {
  let x: number | null = 1;
  let clear: () => null = function(): null {
    x = null;
    return null;
  };
  if (x !== null) {
    clear();
    let y: number = -x;
  }
  return null;
}
