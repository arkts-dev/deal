// @spec: Type system — Nullable semantics (narrowing invalidation across calls)
// @description: A cleared T | null binding read as an array write's receiver is validated at that read: the write reports the typed-boundary tuple (E8001, expected array, actual null) at the receiver instead of a raw backend index error, and the write never runs.
// @expected: runtime-error E8001
// @features: type-system, nullable, narrowing, arrays, runtime-errors

export function main(): null {
  let xs: number[] | null = [0];
  let clear: () => null = function(): null {
    xs = null;
    return null;
  };
  if (xs !== null) {
    clear();
    xs[0] = 7;
  }
  return null;
}
