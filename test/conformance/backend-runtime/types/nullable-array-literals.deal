// @spec: Type system — Array literals
// @description: Empty and mixed nullable element array literals take the contextual nullable array type (v1.2 defect snippets 19 and 20)
// @expected: runtime-ok
// @features: types, arrays, nullable

export function test_empty_nullable_array(): number {
  let a: number[] | null = [];
  if (a === null) {
    throw {code: "TEST_FAIL", message: "empty nullable array became null"};
  } else {
    if (a.length !== 0) { throw {code: "TEST_FAIL", message: "empty nullable array length"}; }
    return a.length;
  }
}

export function test_parenthesized_nullable_array(): number {
  let a: (number | null)[] = [1, null, 3];
  let count: number = 0;
  { let v14Loop0: number = 0; while (v14Loop0 < a.length) { let i: number = v14Loop0; {
    let v: number | null = a[i];
    if (v === null) {
      count = count + 1;
    } else {
      count = count + v;
    }
  } v14Loop0 = i; v14Loop0 = v14Loop0 + 1; } }
  if (count !== 5) { throw {code: "TEST_FAIL", message: "nullable element sum"}; }
  return count;
}

export function main(): null {
  return null;
}
