// @spec: Type system — Nullable semantics (narrowing invalidation across calls)
// @description: A refined read consumed as an operand inside an address chain's index completes at that child's position: the cleared binding's validation reports the typed-boundary tuple (E8001, expected int, actual null) at the read — never a stale pre-load slot and never a raw backend arithmetic error — before the index or the write runs.
// @expected: runtime-error E8001
// @features: type-system, nullable, narrowing, arrays, runtime-errors

export function main(): null {
  let items: number[] = [0, 0, 0];
  let i: number | null = 1;
  let clear: () => null = function(): null {
    i = null;
    return null;
  };
  if (i !== null) {
    clear();
    items[i + 1] = 7;
  }
  return null;
}
