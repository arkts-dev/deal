// @spec: Variables — Scope
// @description: An import alias named bytes resolves to the module; its member call executes the imported function.
// @expected: runtime-ok
// @features: variables, modules, name-resolution, shadowing, intrinsics

import * as bytes from "./intrinsic-shadowing-bytes-lib";

export function main(): null {
  if (bytes.convert(2) !== 3) {
    throw { code: "TEST_FAIL", message: "import alias named bytes did not call the imported function" };
  }
  return null;
}
