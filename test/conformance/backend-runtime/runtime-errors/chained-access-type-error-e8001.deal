// @spec: Runtime execution model — Chained access runtime type checks
// @description: Chained table member read into typed value reports E8001 on mismatched runtime type
// @expected: runtime-error E8001
// @features: runtime-errors, chained-access

export function test_chained_access_type_error(): number {
  let t: Record<string, unknown> = { inner: { value: "bad" } };
  let inner: Record<string, unknown> = t.inner as Record<string, unknown>;
  let result: number = inner.value as number;
  return result;
}

export function main(): null {
  return null;
}
