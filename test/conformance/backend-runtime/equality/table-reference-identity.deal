// @spec: Type system — Equality and comparison operand rules
// @description: Tables compare by reference identity
// @expected: runtime-ok
// @features: equality, table

export function test_table_reference_identity(): null {
  let a: table = { x: 1 };
  let b: table = { x: 1 };
  let c: table = a;
  if (!(a === c)) {
    throw { code: "TEST_FAIL", message: "same table reference must be equal" };
  }
  if (a === b) {
    throw { code: "TEST_FAIL", message: "distinct table references must not be equal" };
  }
  return null;
}
