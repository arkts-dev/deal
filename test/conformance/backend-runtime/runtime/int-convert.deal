// @spec: Runtime execution model — Runtime library
// @description: int(3.0) returns 3 at runtime
// @expected: runtime-ok
// @features: runtime, int, conversion

export function test_int(): int {
  let i: int = int(3.0);
  if (i !== 3) {
    throw { code: "TEST_FAIL", message: "int(3.0) did not produce int 3" };
  }
  return i;
}

export function main(): null {
  return null;
}
