// @spec: Runtime execution model — Runtime library
// @description: Sole-number binary64 values are admitted without conversion or signed32 refinement
// @expected: runtime-ok
// @features: runtime, number, conversion

export function test_number(): number {
  let n: number = (3);
  if (n !== 3.0) {
    throw { code: "TEST_FAIL", message: "(3) did not produce number 3.0" };
  }
  return n;
}

export function main(): null {
  return null;
}
