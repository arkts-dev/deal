// @spec: Runtime execution model — Runtime library
// @description: number(3) returns 3.0 at runtime
// @expected: runtime-ok
// @features: runtime, number, conversion

export function test_number(): number {
  let n: number = number(3);
  if (n !== 3.0) {
    throw { code: "TEST_FAIL", message: "number(3) did not produce number 3.0" };
  }
  return n;
}
