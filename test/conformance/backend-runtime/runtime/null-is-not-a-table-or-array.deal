// @spec: Type system — null and table/array values
// @description: The language null stays distinct from the table and array values: a null read as a table or as an array takes the shared E8001 kind boundary instead of being admitted as an empty container, while a real empty table and a real empty array are admitted (v1.4)
// @expected: runtime-ok
// @features: tables, arrays, null, runtime-errors, v1.4

import * as json from "std/json";

export function test_null_is_not_a_container(): null {
  let holder: Record<string, unknown> = json.parse("{\"n\":null}");
  let tableCode: string = "";
  try {
    let t: Record<string, unknown> = holder.n as Record<string, unknown>;
    tableCode = "admitted";
  } catch (e) {
    tableCode = (e as Error).code;
  }
  if (tableCode !== "E8001") {
    throw { code: "TEST_FAIL", message: "the null value was admitted as a table: " + tableCode };
  }
  let arrayCode: string = "";
  try {
    let xs: number[] = holder.n as number[];
    if (xs.length >= 0) {
      arrayCode = "admitted";
    }
  } catch (e) {
    arrayCode = (e as Error).code;
  }
  if (arrayCode !== "E8001") {
    throw { code: "TEST_FAIL", message: "the null value was admitted as an array" };
  }
  // The empty container controls: a real empty table and a real empty
  // array are values, never confused with the null sentinel.
  let emptyTable: Record<string, unknown> = {};
  let encoded: string = json.stringify(emptyTable) as string;
  if (encoded !== "{}") {
    throw { code: "TEST_FAIL", message: "the empty table did not encode: " + encoded };
  }
  let emptyArray: number[] = [];
  if (emptyArray.length !== 0) {
    throw { code: "TEST_FAIL", message: "the empty array did not keep its length" };
  }
  return null;
}

export function main(): null {
  return null;
}
