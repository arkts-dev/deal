// @spec: Runtime execution model — Source locations for class runtime checks
// @description: Closure-invalidated nominal refinement reports the class parameter's exact failure origin.
// @expected: runtime-error E8001
// @features: source-location, classes, runtime-errors

import * as json from "std/json";

class Box { value: number; }
function needBox(b: Box): number { return b.value; }

export function test_source_class_param_error(): number {
  let item: Box | null = {value: 7};
  let clear: () => void = function(): void { item = null; };
  if (item !== null) {
    clear();
    return needBox(item);
  }
  throw { code: "TEST_FAIL", message: "refined class branch skipped" };
}

export function main(): null {
  return null;
}
