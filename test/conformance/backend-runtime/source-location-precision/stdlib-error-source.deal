// @spec: Runtime execution model — Source locations for stdlib errors
// @description: A closure-invalidated string refinement reports the stdlib parameter's own runtime failure origin.
// @expected: runtime-error E8001
// @features: source-location, stdlib, runtime-errors

import * as str from "std/string";

export function test_source_stdlib_error(): number {
  let text: string | null = "ok";
  let clear: () => void = function(): void { text = null; };
  if (text !== null) {
    clear();
    return str.length(text);
  }
  throw { code: "TEST_FAIL", message: "refined stdlib branch skipped" };
}

export function main(): null {
  return null;
}
