// @spec: Arrays — Chained indexed member access
// @description: Member access after array indexing lowers the array index before field access
// @expected: runtime-ok
// @features: arrays, classes, chained-access

class Box {
  value: int = 0;
}

function box(v: int): Box { return { value: v }; }

export function test_array_index_then_field(): int {
  let xs: Box[] = [box(4), box(9)];
  let result: int = xs[1].value;
  if (result !== 9) { throw { code: "TEST_FAIL", message: "arr[0].field lowering failed" }; }
  return result;
}

export function main(): null {
  return null;
}
