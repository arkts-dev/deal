// @spec: Arrays — Nested indexed access
// @description: Nested array indexing lowers both array indices correctly
// @expected: runtime-ok
// @features: arrays, chained-access

export function test_nested_array_index_chain(): int {
  let rows: int[][] = [[1, 2], [3, 4]];
  let result: int = rows[1][0];
  if (result !== 3) { throw { code: "TEST_FAIL", message: "arr[0][1] lowering failed" }; }
  return result;
}

export function main(): null {
  return null;
}
