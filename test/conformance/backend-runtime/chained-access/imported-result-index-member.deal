import * as Lib from "./chained_import_lib"

export function test_imported_result_index_member(): int {
  let result: int = Lib.makeBoxes()[1].value;
  if (result !== 6) { throw { code: "TEST_FAIL", message: "imported result index/member failed" }; }
  return result;
}

export function main(): null {
  return null;
}
