// @spec: Syntactic grammar — Operator precedence table
// @description: Logical operators follow correct precedence
// @expected: runtime-ok
// @features: parser, precedence

export function test_logic_prec(): int {
  // && binds tighter than ||
  // true || false && false = true || (false && false) = true || false = true
  let a: boolean = true || false && false;
  // (true || false) && false = true && false = false
  let b: boolean = (true || false) && false;
  if (a !== true) {
    throw { code: "TEST_FAIL", message: "logical precedence: true || false && false should be true" };
  }
  if (b !== false) {
    throw { code: "TEST_FAIL", message: "logical precedence: (true || false) && false should be false" };
  }
  return 1;
}

export function main(): null {
  return null;
}
