// @spec: Classes
// @description: Corner-case subject class-literal-extra-nested-reject — Reject extra field inside contextually typed nested class literal. (basis: Class assignment semantics reject extra nested fields)
// @expected: compile-error E4002
// @features: v1.2, frontend, reject

class Inner {x:number;}
class Outer {inner:Inner;}
export function f(): Outer {return {inner:{x:1,extra:2}};}
