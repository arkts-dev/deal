// @spec: Classes
// @description: Corner-case subject has-required-field-reject — Existing runtime filename is misleading; pin actual forbidden required-field subject. (basis: Field access: has argument must declared optional field)
// @expected: compile-error E4005
// @features: v1.2, frontend, reject

class C {x:number=0;}
export function f(c:C): boolean {return has(c.x);}
