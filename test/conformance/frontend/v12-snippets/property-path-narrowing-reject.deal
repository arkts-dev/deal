// @spec: Type system
// @description: Corner-case subject property-path-narrowing-reject — Direct field comparison vs local snapshot. (basis: Narrowing only locals and parameters; no property paths)
// @expected: compile-error E5003
// @features: v1.2, frontend, reject

class C {x: number | null;}
export function f(c: C): number {if(c.x !== null) {return c.x;} return 0;}
