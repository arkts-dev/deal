// @spec: Classes
// @description: Corner-case subject has-computed-target-accept — has() does not accept computed target even for known optional field. (basis: HasExpression grammar: PostfixExpression dot Identifier)
// @expected: compile-ok
// @features: v1.2, frontend, accept-control

class C {x?: int;}
export function f(c:C): boolean {return has(c.x);}
