// @spec: Classes
// @description: Corner-case subject class-literal-extra-array-reject — Second class array element extra field, not just top-level object. (basis: Class assignment semantics reject extra fields in class array literals)
// @expected: compile-error E4002
// @features: v1.2, frontend, reject

class C {x:number;}
export function f(): C[] {return [{x:1},{x:2,extra:3}];}
