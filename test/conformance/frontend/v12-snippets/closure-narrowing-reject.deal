// @spec: Type system
// @description: Corner-case subject closure-narrowing-reject — Captured nullable binding vs explicit non-null snapshot. (basis: Closures: narrowed flow types not captured)
// @expected: compile-error E5003
// @features: v1.2, frontend, reject

export function f(x: number | null): number {if(x !== null) {let g: () => number = function(): number {return x;}; return g();} return 0;}
