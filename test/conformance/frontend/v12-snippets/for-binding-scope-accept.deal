// @spec: Control flow
// @description: Corner-case subject for-binding-scope-accept — Declared loop variable does not leak; outer assignment initializer survives. (basis: Scope; C-style for let initializer block binding)
// @expected: compile-ok
// @features: v1.2, frontend, accept-control

export function f(): number {let i:number=0; { i=0; while (i<1) { {} i=i+1; } } return i;}
