// @spec: Functions
// @description: Corner-case subject async-marker-arity-accept — Zero-to-one arity extension must not erase async marker. (basis: Arity extension requires identical async marker)
// @expected: compile-ok
// @features: v1.2, frontend, accept-control

export function f(): null {async function a(): number {return 1;} let b: async (x:number) => number = a; return null;}
