// @spec: Classes
// @description: Corner-case subject has-required-field-accept — Existing runtime filename is misleading; pin actual forbidden required-field subject. (basis: Field access: has argument must declared optional field)
// @expected: compile-ok
// @features: v1.2, frontend, accept-control

class C {x?:int;}
export function f(c:C): boolean {return has(c.x);}
