// @spec: Error handling
// @description: Corner-case subject try-assignment-invalidates-reject — Join after assignment in try vs re-narrowing. (basis: Narrowing across try/catch)
// @expected: compile-error E5003
// @features: v1.2, frontend, reject

export function f(x: int | null): int {if(x !== null) {try {x = 2;} catch(e) {} return x;} return 0;}
