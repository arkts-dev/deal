// @spec: Classes
// @description: Corner-case subject has-nonoptional-class-reject — Receiver itself is not a has target. (basis: HasExpression grammar requires member access and declared optional field)
// @expected: compile-error E1040
// @features: v1.2, frontend, reject

class C {x:int=1;}
export function f(c:C): boolean {return has(c);}
