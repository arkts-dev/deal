// @spec: Async/Await — narrowing invalidated after await
// @description: After await, narrowed variables revert to declared types
// @expected: compile-error E3001
// @features: async, await, nullable, narrowing

async function g(): Promise<number> { return 5; }

async function f(n: number | null): Promise<number> {
  if (n !== null) {
    let x: number = n;        // OK: narrowed to int
    let r: number = await g(); // await invalidates narrowing
    let y: number = n;        // ERROR: n back to int|null
    return r;
  }
  return 0;
}

export function main(): null { return null; }
