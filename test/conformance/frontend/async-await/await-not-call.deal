// @spec: Async/Await — await must be followed by a function call
// @description: Awaiting an async function value without calling it rejects with E1042
// @expected: compile-error E1042
// @features: async, await, parser

async function target(): null { return null; }

async function f(): null {
  await target;
  return null;
}

export function main(): null { return null; }
