// @spec: Async/Await — async calls as values
// @description: Passing an async function result to a synchronous function requires await at the actual async call
// @expected: compile-error E3014
// @features: async, await, diagnostics

async function fetch(): number { return 7; }
function consume(x: number): number { return x; }

async function test_nested_sync_argument(): number {
  return consume(fetch());
}

export function main(): null { return null; }
