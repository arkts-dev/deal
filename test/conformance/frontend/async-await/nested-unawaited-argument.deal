// @spec: Async/Await — await operand directness
// @description: A nested async call inside an awaited call argument still requires its own await
// @expected: compile-error E3014
// @features: async, await, diagnostics

async function inner(): Promise<number> { return 1; }
async function outer(x: number): Promise<number> { return x; }

async function test_nested_unawaited_argument(): Promise<number> {
  return await outer(inner());
}

export function main(): null { return null; }
