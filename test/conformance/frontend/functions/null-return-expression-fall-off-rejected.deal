// @spec: Functions — Return type requirements
// @description: A null-returning function expression body must not fall off without a return (v1.2 defect snippet 26)
// @expected: compile-error E5002
// @features: functions, return, expressions, diagnostics, v1.2

export function main(): null {
  let f: () => null = function(): null {};
  f();
  return null;
}
