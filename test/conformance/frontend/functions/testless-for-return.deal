// @spec: Functions — Definite return analysis
// @description: A test-less for loop with an unconditional return before any possible break directly returns (v1.2 defect snippet 29)
// @expected: compile-ok
// @features: functions, return, loops, v1.2

function value(): int {
  for (;;) { return 7; }
}

export function main(): null {
  let n: int = value();
  return null;
}
