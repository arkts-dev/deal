// @spec: Functions — Function type compatibility
// @description: A shorter call argument must match every leading target parameter type exactly — a mismatching prefix parameter type is rejected
// @expected: compile-error E5001
// @features: functions, arity-extension, diagnostics

function takesNumber(x: string): number { return 1; }

function needPair(f: (x: number, y: number) => number): number { return f(1, 2); }

export function main(): null {
  let r: number = needPair(takesNumber);
  return null;
}
