// @spec: Functions — Function type compatibility
// @description: Arity extension requires an identical async marker at a parameter position — a sync argument never fills an async target
// @expected: compile-error E5001
// @features: functions, arity-extension, async-await, diagnostics

function syncOne(x: number): number { return x; }

function needAsyncPair(f: async (x: number, y: number) => number): number { return 1; }

export function main(): null {
  let r: number = needAsyncPair(syncOne);
  return null;
}
