// @spec: Functions — Function type compatibility
// @description: A call argument with more parameters than the declared parameter type is rejected — the reverse arity direction stays always rejected at a parameter position
// @expected: compile-error E5001
// @features: functions, arity-extension, diagnostics

function two(a: number, b: number): number { return a + b; }

function needOne(f: (x: number) => number): number { return f(1); }

export function main(): null {
  let r: number = needOne(two);
  return null;
}
