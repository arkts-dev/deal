// @spec: Classes — Error class prohibition
// @description: User-declared class Error is prohibited (v1.3 Error handling / Type system, E4006): Error is a builtin nominal class type and user code must not declare a class named Error. The rule originates in Error handling but is placed in classes/ for directory consistency. Nested class declarations are rejected by the module-level class rule (E1057).
// @expected: compile-error E4006
// @features: classes, error-prohibition

class Error { message: string = ""; }

export function main(): null { return null; }
