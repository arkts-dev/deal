// @spec: Classes — Class identity
// @description: A nested class declaration is rejected before class-identity assignment checking (v1.4 module-level class rule); retain the original shadowing and assignment subject.
// @expected: compile-error E1057
// @features: classes, identity, diagnostics, v1.4

class A { n: number; }

export function main(): null {
  let a: A = {n: 0};
  {
    class A { n: number; }
    let b: A = {n: 0};
    a = b;
  }
  return null;
}
