// @spec: Classes — Class identity
// @description: A value of a nested class declaration cannot be assigned to a binding of the enclosing same-named class declaration (v1.2 defect snippet 47)
// @expected: compile-error E3019
// @features: classes, identity, diagnostics, v1.2

class A { n: int = 0; }

export function main(): null {
  let a: A = {};
  {
    class A { n: int = 0; }
    let b: A = {};
    a = b;
  }
  return null;
}
