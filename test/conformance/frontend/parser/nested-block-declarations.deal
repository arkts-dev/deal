// @spec: Syntactic grammar — nested blocks and declarations
// @description: Nested blocks can contain declarations, assignments, and returns
// @expected: compile-ok
// @features: parser, blocks, declarations

export function test_nested_block_grammar(): int {
  let x: int = 1;
  {
    let y: int = 2;
    x = x + y;
    {
      let z: int = 3;
      x = x + z;
    }
  }
  return x;
}

export function main(): null { return null; }
