// @spec: Syntactic grammar — ParameterList
// @description: A parameter list carries no trailing comma (v1.2 defect snippet 60)
// @expected: compile-error E1054
// @features: parser, parameters, trailing-comma

function one(x: number,): number { return x; }
export function main(): null {
  let n: number = one(1);
  return null;
}
