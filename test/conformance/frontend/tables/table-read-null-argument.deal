// @spec: Tables — Reading table fields
// @description: A Record field checked as null can be passed to a null parameter
// @expected: compile-ok
// @features: tables, dynamic-read, contextual-target

function takeNull(x: null): null { return null; }
export function main(): null {
  let t: Record<string, unknown> = { x: null };
  takeNull(t.x as null);
  return null;
}
