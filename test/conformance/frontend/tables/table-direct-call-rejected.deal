// @spec: Tables
// @description: Calling a function-valued table field directly is rejected: the callee is not one of the five direct read positions, so the read itself is E3003 and the call is never admitted through a table.
// @expected: compile-error E3003
// @features: tables, functions, diagnostics

function plusOne(value: number): number { return value + 1; }

export function main(): null {
  let t: table = { fn: plusOne };
  let value: number = t.fn(1);
  return null;
}
