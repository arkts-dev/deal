// @spec: Tables
// @description: A function-valued Record field is unknown and cannot be called without checking its signature
// @expected: compile-error E3008
// @features: tables, functions, diagnostics

function plusOne(value: number): number { return value + 1; }

export function main(): null {
  let t: Record<string, unknown> = { fn: plusOne };
  let value: number = t.fn(1);
  return null;
}
