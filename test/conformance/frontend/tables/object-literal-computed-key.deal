// @spec: Records — Literal keys and deletion
// @description: Computed string keys construct a contextual Record.
// @expected: compile-ok
// @features: records, computed-keys

export function test_object_literal_computed_key(): Record<string, unknown> {
  let key: string = "name";
  let t: Record<string, unknown> = { [key]: 1 };
  return t;
}

export function main(): void {}
