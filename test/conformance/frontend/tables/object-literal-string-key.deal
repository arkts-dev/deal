// @spec: Records — Literal keys and deletion
// @description: Quoted and escaped keys construct a contextual Record.
// @expected: compile-ok
// @features: records, quoted-keys

export function test_object_literal_string_key(): Record<string, unknown> {
  let t: Record<string, unknown> = { "content-type": "text/plain", "na\u006de": "Ada" };
  return t;
}

export function main(): void {}
