// @spec: Tables — Reading table fields
// @description: Unknown Record reads cannot initialize numeric nominal class fields, for dotted and computed forms alike
// @expected: compile-error E4003
// @features: tables, dynamic-read, literals, classes, computed-key

class Box {
  n: number;
  m: number;
}

export function main(): null {
  let t: Record<string, unknown> = { x: 1, m: 2 };
  let b: Box = { n: t.x, m: t["m"] };
  return null;
}
