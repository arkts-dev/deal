// @spec: Lexical elements
// @description: A line break after member access punctuation does not terminate the expression
// @expected: compile-ok
// @features: parser, semicolon, line-break, member-access, v1.2

class Box {
  value: number;
}

export function main(): null {
  let box: Box = { value: 1 };
  let value: number = box.
    value;
  return null;
}
