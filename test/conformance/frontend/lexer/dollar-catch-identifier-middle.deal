// @spec: Lexical elements — identifier restrictions
// @description: Catch identifiers containing $ are user declarations and are rejected (E2008, middle-position $)
// @expected: compile-error E2008
// @features: error-handling, catch, dollar-prohibition, diagnostics

export function main(): null {
  try { throw {code:"CONTROL",message:"control"}; } catch (b$ad) {}
  return null;
}
