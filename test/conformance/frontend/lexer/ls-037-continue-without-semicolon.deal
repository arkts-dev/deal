// @spec: Lexical elements
// @description: A continue statement must end with its semicolon; omitting it before a closing brace is E1053 (v1.3 Semicolon rules)
// @expected: compile-error E1053
// @features: parser, semicolon, continue, loop

export function main(): null {
  for (let i: int = 0; i < 1; i = i + 1) {
    continue
  }
  return null;
}
