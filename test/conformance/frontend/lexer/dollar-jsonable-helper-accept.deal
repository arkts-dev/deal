// @spec: Lexical elements — identifier restrictions
// @description: Comments never introduce C$fromJson/C$toJson callable symbols
// @expected: compile-error E2001
// @features: classes, jsonable, generated-identifiers, accept-control

// @jsonable
export class Payload {
  name: string;
}

export function main(): null {
  let encoded: string = Payload$toJson({ name: "x" });
  let decoded: Payload | null = Payload$fromJson(encoded);
  return null;
}
