// @spec: Type system — Nullable semantics
// @description: T | null cannot be assigned to T without narrowing
// @expected: compile-error E3001
// @features: type-system, nullable

export function main(): null {
let a: number | null = nullable(42);
let b: number = a;

return null;
}
function nullable(value:number|null):number|null{return value;}
