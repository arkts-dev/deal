// @spec: Variables — Null narrowing
// @description: A nested function declaration captures the declared type, never a narrowed refinement (v1.2 defect snippet 07)
// @expected: compile-error E5003
// @features: variables, narrowing, functions

export function main(): null {
  let x: string | null = "a";
  if (x !== null) {
    function f(): string { return x; }
  }
  return null;
}
