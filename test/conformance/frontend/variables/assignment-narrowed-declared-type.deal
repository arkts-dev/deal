// @spec: Variables — Null narrowing invalidation
// @description: Assignment checks the declared type, not the narrowed refinement (v1.2 defect snippet 05)
// @expected: compile-ok
// @features: variables, narrowing, assignment

export function main(): null {
  let x: string | null = "a";
  if (x !== null) { x = null; }
  return null;
}
