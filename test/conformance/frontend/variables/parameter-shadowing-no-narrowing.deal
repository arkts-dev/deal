// @spec: Variables — Null narrowing
// @description: A parameter does not inherit the outer binding's narrowing (v1.2 defect snippet 09)
// @expected: compile-ok
// @features: variables, narrowing, parameters

export function main(): null {
  let x: string | null = "a";
  if (x !== null) {
    let f: (x: number) => number = function(x: number): number { return x; };
    let n: number = f(4);
  }
  return null;
}
