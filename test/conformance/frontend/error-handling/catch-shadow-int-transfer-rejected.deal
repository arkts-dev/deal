// @spec: Error handling — try / catch; Nullable semantics
// @description: An number-refined outer binding of the catch identifier's name does not type the catch binding: transferring the Error binding to an number target is rejected
// @expected: compile-error E3001
// @features: error-handling, try-catch, nullable, narrowing, shadowing

export function main(): null {
  let e: number | null = 1;
  if (e !== null) {
    try {
      throw { code: "C_INT", message: "number refinement" };
    } catch (e) {
      let unsound: number = e;
    }
  }
  return null;
}
