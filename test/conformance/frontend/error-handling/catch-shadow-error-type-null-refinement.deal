// @spec: Error handling — try / catch; Nullable semantics
// @description: A null-refined outer binding of the catch identifier's name never types the catch read: the catch variable starts unknown and is explicitly checked as Error on the null branch
// @expected: compile-ok
// @features: error-handling, try-catch, nullable, narrowing, shadowing

export function main(): null {
  let e: number | null = null;
  if (e === null) {
    try {
      throw { code: "C_NULL", message: "null refinement" };
    } catch (e) {
      let captured: Error = e as Error;
      let message: string = captured.message;
    }
  }
  return null;
}
