// @spec: Error handling — try / catch; Nullable semantics
// @description: A try/catch nested inside an enclosing try block reassigns only its own catch unknown binding with an explicitly typed Error: the same-named outer number and string refinements stay readable after the inner catch and after the outer catch, for a local and a parameter binding alike
// @expected: compile-ok
// @features: error-handling, try-catch, nullable, narrowing, shadowing, assignment, nesting, parameters

function probeParameter(e: number | null): number {
  if (e !== null) {
    try {
      try {
        throw { code: "C_PARAM_INNER", message: "parameter inner" };
      } catch (e) {
        let replacement: Error = { code: "C_PARAM_REPLACED", message: "parameter replaced" };
        e = replacement;
        let checked: Error = e as Error;
        let message: string = checked.message;
      }
      let afterInner: number = e;
    } catch (outer) {
    }
    let afterOuter: number = e;
  }
  return 0;
}

export function main(): null {
  let e: number | null = 21;
  if (e !== null) {
    try {
      try {
        throw { code: "C_INNER", message: "inner" };
      } catch (e) {
        let replacement: Error = { code: "C_REPLACED", message: "replaced" };
        e = replacement;
        let checked: Error = e as Error;
        let message: string = checked.message;
      }
      let afterInner: number = e;
    } catch (outer) {
    }
    let afterOuter: number = e;
  }
  let text: string | null = "outer";
  if (text !== null) {
    try {
      try {
        throw { code: "C_TEXT", message: "text" };
      } catch (text) {
        let replacement: Error = { code: "C_TEXT_REPLACED", message: "text replaced" };
        text = replacement;
        let checked: Error = text as Error;
        let replaced: string = checked.message;
      }
      let afterInnerText: string = text;
    } catch (outer) {
    }
    let afterOuterText: string = text;
  }
  probeParameter(3);
  return null;
}
