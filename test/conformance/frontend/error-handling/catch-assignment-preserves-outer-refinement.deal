// @spec: Error handling — try / catch; Nullable semantics
// @description: Assigning the catch binding reassigns only the catch-local unknown binding: the assignment stores an explicitly typed Error replacement, and the same-named outer refinement is unaffected after the catch scope exits
// @expected: compile-ok
// @features: error-handling, try-catch, nullable, narrowing, shadowing, assignment

export function main(): null {
  let e: number | null = 13;
  if (e !== null) {
    try {
      throw { code: "C_ASSIGN", message: "assign" };
    } catch (e) {
      let replacement: Error = { code: "C_REPLACED", message: "replaced" };
      e = replacement;
      let checked: Error = e as Error;
      let message: string = checked.message;
    }
    let afterCatch: number = e;
  }
  return null;
}
