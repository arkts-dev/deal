// @spec: Error handling — try / catch; Nullable semantics
// @description: The catch identifier is a new unknown binding, so a number-refined outer binding never types it: checked Error extraction is valid and the outer number refinement survives catch exit
// @expected: compile-ok
// @features: error-handling, try-catch, nullable, narrowing, shadowing

export function main(): null {
  let e: number | null = 1;
  if (e !== null) {
    try {
      throw { code: "C_INT", message: "number refinement" };
    } catch (e) {
      let captured: Error = e as Error;
      let message: string = captured.message;
    }
    let afterCatch: number = e;
  }
  return null;
}
