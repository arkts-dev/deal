// Host-module fixture (host-module-abi D6): declaration for the bad_string
// host module — a host surface whose returned strings violate DEAL v1.2
// string encoding rules (malformed UTF-8 bytes, UTF-16 surrogate code
// points) and whose valid returns exercise the raw backend-native carrier at
// scalar, array, nested-array, nullable-element, and nullable nested-array
// positions (a raw UTF-8 byte carrier decodes at the declared string cell;
// the decoded element result lands back in the production array; a null
// nested array element stays the language null; the same inner array
// returned twice stays one DEAL array). The nested-tail export
// returns a declared string[][] whose later element is not an array, so the
// return is rejected and the retained earlier slots must stay untouched.
// The native-* exports return the same declared shapes through the JVM
// host's own declared `$DealRt` array carriers (the Lua/JS hosts return the
// analogous plain array), so the declared-array check must validate the
// carrier elements recursively instead of admitting the carrier's Java
// storage: nativeBadStringArray's second element is an unpaired surrogate,
// nativeBadNestedTail's later element is not an array while its earlier
// nested carrier is valid, and the valid controls must land as usable DEAL
// arrays (including one inner carrier returned at both positions of a
// declared string[][], which stays one DEAL array). The
// nativeDifferingDepthStringArray export shares one inner array between two
// positions with different descriptor depths (the same carrier is checked
// as the root's first element and again under the root's second element at
// one depth less), so every position must re-validate the elements against
// its own descriptor and the return is rejected with the element arm.

export function badString(): string;
export function surrogateString(): string;
export function embeddedSurrogateString(): string;
export function validString(): string;
export function rawStringArray(): string[];
export function rawNestedStringArray(): string[][];
export function rawNullableStringArray(): (string | null)[];
export function rawNullableArrayArray(): (string[] | null)[];
export function sharedNestedStringArray(): string[][];
export function badNestedTail(): string[][];
export function nativeBadStringArray(): string[];
export function nativeBadNestedTail(): string[][];
export function nativeStringArray(): string[];
export function nativeNestedStringArray(): string[][];
export function nativeSharedNestedStringArray(): string[][];
export function nativeDifferingDepthStringArray(): string[][][][];
