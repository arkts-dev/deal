export class Endpoint {
  path: string;
}

export class ServerConfig {
  port: int;
  endpoint: Endpoint;
  parts: string[];
  tags?: string[];
  note?: string | null;
}

export class Farm {
  name: string;
  servers: ServerConfig[];
  primary: Endpoint;
}

export async function describeAsync(s: ServerConfig, g: (x: int) => int): string;
export async function make(): ServerConfig;
export function makeAll(): ServerConfig[];
export function makeFarm(): Farm;
