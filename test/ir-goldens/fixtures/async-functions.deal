// IR golden fixture: async-functions
// Tests async function declarations with the async function type marker,
// async functions with various return types, and async function IR dump format.
// Verifies that the IrDumper produces "async function" as the node kind
// and "async" prefix in function type descriptors.

async function identity(x: int): int {
    return x;
}

async function maybe(x: int): int | null {
    if (x === 0) {
        return null;
    }
    return x;
}

async function compute(a: int, b: int): int {
    return a + b;
}

async function noAwait(): int {
    return 5;
}
