// IR golden fixture: typed-boundaries
// Tests various typed boundary annotations:
// - var-annotation, assignment, param-entry, return
// - class-default, class-construct
// - field-write

class Counter {
    count: number = 0;
}

function increment(c: Counter): number {
    c.count = c.count + 1;
    return c.count;
}

function main(): null {
    let c: Counter = { count: 0 };
    let n: number = increment(c);
    n = 42;
}
