// Migrated IR-containment pins from test/conformance/fixtures/jvm-arrays-slice.json case 'jvm-arr-function-param-return' (ISSUE-0358).

function fill(xs: int[], v: int): int[] {
  xs[0] = v;
  xs[1] = v + 1;
  return xs;
}
function total(xs: int[]): int { return xs[0] + xs[1]; }
export function test(): int {
  let xs: int[] = [0, 0];
  let ys: int[] = fill(xs, 10);
  return total(ys) + xs.length;
}
