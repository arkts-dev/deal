// IR golden fixture: jvm-semantic-slice-jvm-slice-while-nested-shadow
// Migrated IR-containment pins from test/conformance/fixtures/jvm-semantic-slice.json case 'jvm-slice-while-nested-shadow' (ISSUE-0358).

export function test(): int {
  let total: int = 0;
  let i: int = 1;
  while (i <= 4) {
    let acc: int = 0;
    let j: int = 1;
    while (j <= i) {
      acc = acc + j;
      j = j + 1;
    }
    total = total + acc;
    i = i + 1;
  }
  return total;
}
