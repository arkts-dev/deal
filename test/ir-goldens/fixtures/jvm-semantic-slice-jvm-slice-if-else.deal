function classify(n: int): int {
  if (n < 0) {
    return 0;
  } else if (n === 0) {
    return 1;
  } else {
    return 2;
  }
}
export function test(): int {
  let a: int = classify(-5);
  let b: int = classify(0);
  let c: int = classify(7);
  if (a === 0 && b === 1 && c === 2) { return 100; }
  return 0;
}
