// IR golden fixture: jsonable-classes
// Tests class declarations with various field patterns:
// required and optional fields across the primitive types, with explicit
// contextual JSON decoding and builtin encoding. Comments create no helpers.

class Point {
    x: number;
    y: number;
}

class User {
    name: string;
    age?: number;
    active: boolean;
}

class Config {
    title: string;
    count: number;
    ratio: number;
    enabled: boolean;
}

function makePoint(x: number, y: number): Point {
    return { x: x, y: y };
}

function decodePoint(text: string): Point {
    return JSON.parse(text);
}

function encodePoint(point: Point): string {
    return JSON.stringify(point) as string;
}
