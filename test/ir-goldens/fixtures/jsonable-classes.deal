// IR golden fixture: jsonable-classes
// Tests class declarations with various field patterns:
// required fields with defaults, optional fields, and edge cases.

class Point {
    x: number = 0;
    y: number = 0;
}

class User {
    name: string = "";
    age?: number;
    active: boolean = true;
}

class Config {
    title: string = "untitled";
    count: number = 1;
    ratio: number = 1.0;
    enabled: boolean = false;
}

function makePoint(x: number, y: number): Point {
    return { x: x, y: y };
}
