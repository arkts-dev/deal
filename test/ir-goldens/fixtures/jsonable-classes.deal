// IR golden fixture: jsonable-classes
// Tests class declarations with various field patterns:
// required and optional fields across the primitive types.

class Point {
    x: number;
    y: number;
}

class User {
    name: string;
    age?: number;
    active: boolean;
}

class Config {
    title: string;
    count: number;
    ratio: number;
    enabled: boolean;
}

function makePoint(x: number, y: number): Point {
    return { x: x, y: y };
}
