// IR golden fixture: await-expressions
// Tests await expressions with various async function call patterns.
// Verifies that the IrDumper produces "await : <type>" nodes with
// proper type annotations and walks the callee call expression.

async function add(a: int, b: int): int {
    return a + b;
}

async function compute(x: int, y: int): int {
    let r: int = await add(x, y);
    return r;
}

async function chain(a: int): int {
    let b: int = await add(a, 1);
    let c: int = await add(b, 2);
    return await add(c, 3);
}
