// IR golden fixture: await-expressions
// Tests complex call expressions with nesting and member access.
// These patterns form the basis for await expression lowering.

class Calc { }

function add(a: int, b: int): int {
    return a + b;
}

function compute(x: int, y: int): int {
    let r: int = add(x, y);
    return r;
}

function chain(a: int): int {
    let b: int = add(a, 1);
    let c: int = add(b, 2);
    return add(c, 3);
}
