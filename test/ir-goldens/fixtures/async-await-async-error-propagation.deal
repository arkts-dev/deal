// IR golden fixture: async-await-async-error-propagation
// Migrated IR-containment pin for legacy case 'async-error-propagation' (ISSUE-0358).

async function inner(): number { throw { code: "E_INNER", message: "inner error" }; return 0; }
export async function outer(): string { try { let _: number = await inner(); return "no error"; } catch (e) { return e.code; } }
