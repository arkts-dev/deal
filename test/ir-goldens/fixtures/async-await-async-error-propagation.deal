// IR golden fixture: async-await-async-error-propagation
// Migrated IR-containment pin for legacy case 'async-error-propagation' (ISSUE-0358).

async function inner(): Promise<number> { throw { code: "E_INNER", message: "inner error" }; return 0; }
export async function outer(): Promise<string> { try { let _: number = await inner(); return "no error"; } catch (e) { let error: Error = e as Error; return error.code; } }
