// DEAL v1.4 capability demo: one module that exercises the active
// language and standard library surface. Compile it with any supported
// production backend and run its exported main:
//   deal compile src/main.deal --backend luajit|jvm|js --output <dir>

import * as console from "std/console";
import * as json from "std/json";
import * as math from "std/math";
import * as strings from "std/string";
import * as tables from "std/table";
import * as time from "std/time";

class Address {
  city: string;
  zip: number;
}

class Profile {
  name: string;
  nick?: string;
  bio: string | null;
  active: boolean;
  address: Address;
  tags: string[];
  meta: table;
}

class Point {
  x: number;
  y: number;
}

function fail(message: string): null {
  throw { code: "DEMO_FAIL", message: message };
}

function assertBoolean(value: boolean, message: string): null {
  if (!value) {
    fail(message);
  }
  return null;
}

function sumAll(values: number[]): number {
  let total: number = 0;
  for (let value: number of values) {
    total = total + value;
  }
  return total;
}

function safeDivide(a: number, b: number): number | null {
  if (b === 0) {
    return null;
  }
  return a / b;
}

function makeCounter(start: number): () => number {
  let current: number = start;
  return function(): number {
    current = current + 1;
    return current;
  };
}

function chooseName(name: string | null): string {
  if (name !== null) {
    return name;
  }
  return "anonymous";
}

function describeProfile(p: Profile): string {
  let nick: string | null = p.nick;
  if (nick !== null) {
    return `${p.name} aka ${nick} from ${p.address.city}`;
  }
  return `${p.name} from ${p.address.city}`;
}

function useArrays(): number {
  let values: number[] = [1, 2, 3];
  values[values.length] = 4;
  values[0] = 10;
  let total: number = 0;
  for (let value: number of values) {
    total = total + value;
  }
  return total;
}

function useStrings(): string {
  let parts: string[] = strings.split("deal,v1,luajit", ",");
  let joined: string = `${parts[0]}-${parts[1]}-${parts[2]}`;
  let trimmed: string = strings.trim("  ready  ");
  let replaced: string = strings.replace(joined, "luajit", trimmed);
  if (!strings.startsWith(replaced, "deal")) {
    fail("startsWith failed");
  }
  if (!strings.endsWith(replaced, "ready")) {
    fail("endsWith failed");
  }
  if (!strings.contains(replaced, "v1")) {
    fail("contains failed");
  }
  return replaced;
}

function useTables(): number {
  let data: table = { name: "Ada", score: 7 };
  data.extra = true;
  data.note = null;
  let score: number = data.score;
  let keys: string[] = tables.keys(data);
  delete data.note;
  return score + keys.length;
}

function useJson(): string {
  let raw: table = json.parse("{\"name\":\"Ada\",\"score\":7}");
  let name: string = raw.name;
  let score: number = raw.score;
  if (name !== "Ada") {
    fail("json name mismatch");
  }
  if (score !== 7) {
    fail("json score mismatch");
  }
  return json.stringify(raw);
}

function useMath(): number {
  let floor: number = math.floor(3.9);
  let ceil: number = math.ceil(3.1);
  let root: number = math.sqrt(9.0);
  let abs: number = math.absNumber(-5);
  let min: number = 2;
  let max: number = 8;
  return floor + ceil + root + abs + min + max;
}

function useClasses(): string {
  let p: Profile = {
    name: "Ada",
    nick: "countess",
    bio: null,
    active: true,
    address: { city: "London", zip: 1000 },
    tags: ["math", "code"],
    meta: { score: 99 },
  };
  assertBoolean(has(p.nick), "nick should be present");
  let q: Profile = { name: "Grace", bio: null, active: true,
    address: { city: "Arlington", zip: 2000 }, tags: [], meta: {} };
  assertBoolean(!has(q.nick), "nick should be missing");
  let score: number = p.meta.score;
  assertBoolean(score === 99, "table field in class mismatch");
  return `${describeProfile(p)} / ${describeProfile(q)}`;
}

function useFunctions(): number {
  let plus: (a: number, b: number) => number = function(a: number, b: number): number {
    return a + b;
  };
  let oneArg = function(x: number): number {
    return x;
  };
  let widened: (x: number, y: number) => number = oneArg;
  let counter: () => number = makeCounter(40);
  return plus(2, 3) + widened(9, 99) + counter() + counter();
}

function useErrors(): string {
  try {
    let values: number[] = [1, 2, 3];
    let missing: number = values[99];
    return "unexpected array read success";
  } catch (e) {
    return e.code;
  }
}

async function delayedDouble(x: number): number {
  return x * 2;
}

async function delayedAdd(a: number, b: number): number {
  let left: number = await delayedDouble(a);
  let right: number = await delayedDouble(b);
  return left + right;
}

export function demo_summary(): string {
  let arrays: number = useArrays();
  let tableScore: number = useTables();
  let mathScore: number = useMath();
  let functionScore: number = useFunctions();
  let selected: string = chooseName(null);
  let stringsResult: string = useStrings();
  let classesResult: string = useClasses();
  let jsonResult: string = useJson();
  let errorCode: string = useErrors();
  let quotient: number | null = safeDivide(10, 2);
  let zeroDivision: number | null = safeDivide(10, 0);
  if (quotient !== null) {
    assertBoolean(quotient === 5, "safe divide quotient mismatch");
  } else {
    fail("safe divide returned null");
  }
  assertBoolean(zeroDivision === null, "safe divide zero mismatch");
  assertBoolean(arrays === 19, "array total mismatch");
  assertBoolean(tableScore > 7, "table score mismatch");
  assertBoolean(mathScore === 25, "math score mismatch");
  assertBoolean(functionScore === 97, "function score mismatch");
  console.log("DEAL v1.4 capabilities demo");
  return `${selected}|${stringsResult}|${classesResult}|${jsonResult}|${errorCode}`;
}

export async function demo_async(): number {
  return await delayedAdd(10, 20);
}

// The entry drives every synchronous capability; demo_async is invoked by
// the embedding through the backend's async-export ABI.
export function main(): null {
  demo_runtime_checks();
  let summary: string = demo_summary();
  console.log(summary);
  return null;
}

export function demo_runtime_checks(): null {
  let point: Point = { x: 3.0, y: 4.0 };
  assertBoolean(point.x === 3.0, "point x mismatch");
  assertBoolean(5 === 5.0, "binary64 arithmetic mismatch");
  assertBoolean(5 / 2 === 2.5, "binary64 arithmetic mismatch");
  return null;
}
